{%- liquid 
    # If Menu: mega 
    assign isMega = false
    assign level2FlexDirection = 'column'
    if block.settings.type == 'mega'
        assign isMega = true
        assign detailState = ' open'
        assign level2FlexDirection = 'row'

        # If first column is highlighted
        if block.settings.firstElevated
            assign firstElevated = ' firstElevated'
        endif
    endif

    # If Menu: drawer — hamburger on desktop (or legacy "drawer" type)
    assign isDrawer = false
    assign level1FlexDirection = 'row'
    if block.settings.hamburgerDesktop or block.settings.type == 'drawer'
        assign isDrawer = true
        assign level1FlexDirection = 'column'
        assign isMega = false
        assign detailState = ''
        assign level2FlexDirection = 'column'
    endif
-%}

{%- # Used for Menu: drawer (mobile + desktop) -%}
<drawer-header x-flex direction="row" ai="center" jc="between" class="sticky">
    <h2 class="h6" style="--hMargin:0">{{ 'sections.header.menu' | t }}</h2>
    <button role="button" class="is-custom has-icon" data-close>
        <span class="visually-hidden">{{ 'accessibility.close' | t }}</span>
        {%- render 'inc-icon', icon: 'x-close' -%}
    </button>
</drawer-header>

<nav
  aria-label="primary"
  class="menuPrimary{{ firstElevated }}"
  {{ block.shopify_attributes }}
>
  {%- assign linklist = block.settings.linklist -%}
  <ul x-flex direction="{{ level1FlexDirection }}" direction-s="column" wrap="wrap" class="no-style inside" data-level="1">
    {%- for link in linklists[linklist].links -%}
      {%- render 'c-menu-item',
        link: link,
        level: 1,
        index: forloop.index,
        isMega: isMega,
        detailState: detailState,
        level2FlexDirection: level2FlexDirection,
        id: 'mainMenu'
      -%}
    {%- endfor -%}
  </ul>
</nav>

{%- # Utility links inside the hamburger drawer (mobile + desktop), stacked vertically -%}
<drawer-footer x-flex direction="column" ai="start" class="sticky-bottom">

    {%- # Search -%}
    {%- if showSearch -%}
    <x-cell class="search">
        <button class="is-custom has-icon" data-open="#searchBox">
            {%- render 'inc-icon', icon: 'search' -%}
            <span class="txtState">{{ 'general.search.search' | t }}</span>
        </button>
    </x-cell>
    {%- endif -%}

    {%- # Accounts -%}
    {%- if showAccounts -%}
      <x-cell class="accounts">
        <a
          href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}"
          class="button is-custom has-icon noHide"
        >
          {%- render 'inc-icon', icon: 'o-account' -%}
          <span class="visually-hidden">
            {%- liquid
              if customer
                echo 'customer.account.title' | t
              else
                echo 'customer.log_in' | t
              endif
            -%}
          </span>
        </a>
      </x-cell>
    {%- endif -%}

    {%- # Country/region selector -%}
    {%- if showCountry or showLanguage -%}
    <x-flex class="localization" ai="center" jc="start" wrap="wrap" style="gap:0">

        {% # Country selector %}
        {%- if showCountry -%}
        <x-cell class="localization-country">
            {%- render 'global-localization', component: 'button', type: 'country', icons: true -%}
        </x-cell>
        {%- endif -%}

        {% # Language selector %}
        {%- if showLanguage -%}
        <x-cell class="localization-language">
            {%- render 'global-localization', component: 'button', type: 'language', icons: true -%}
        </x-cell>
        {%- endif -%}

    </x-flex>
    {%- endif -%}
</drawer-footer>
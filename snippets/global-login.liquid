<component-loader><coretex-dialog
    id="loginBox" 
    class="coretex-dialog"
    data-section-id="{{ section.id }}"
    tabindex="-1"
>
    <dialog aria-label="Login modal" dialog-position="top right">
        <dialog-wrapper x-flex direction="column">
            <header x-flex direction="row" ai="center" jc="between" class="sticky">
                <h2 class="h6" style="--hMargin:0">{%- if customer -%}{{ 'customer.account.title' | t }}{%  else %}{{ 'customer.login_page.title' | t }}{% endif %}</h2>
                <form>
                    <button formmethod="dialog" x-flex class="is-custom has-icon" data-close>
                        <span class="visually-hidden">{{ 'accessibility.close' | t }}</span>
                        {%- render 'inc-icon', icon: 'x-close' -%}
                    </button>
                </form>
            </header>

            <main>
                {%- # Sign in + Create account buttons -%}
                <x-flex wrap="wrap" style="gap:var(--space-1)">
                    {%- if customer -%}
                    {%- comment %} If customer is logged in, show the account buttons. {% endcomment -%}
                    <x-cell span="2"><a href="{{ routes.account_addresses_url }}" class="button text-normal fullwidth" type="submit">{{ 'customer.account.title' | t }}</a></x-cell>
                    <x-cell span="1"><a href="{{ routes.account_logout_url }}" class="button text-normal fullwidth">{{ 'customer.log_out' | t }}</a></x-cell>
                    {%- else -%}
                    {%- comment %} If customer is not logged in, show the login buttons. {% endcomment -%}
                    <x-cell span="1"><a href="{{ routes.account_login_url }}" class="button text-normal fullwidth" type="submit">{{ 'customer.log_in' | t }}</a></x-cell>
                    <x-cell span="1"><a href="{{ routes.account_register_url }}" class="button text-normal fullwidth">{{ 'customer.login_page.create_account' | t }}</a></x-cell>
                    {% endif %}
                </x-flex>
            </main>

        </dialog-wrapper>
    </dialog>
</coretex-dialog>
{%- render 'inc-stylesheet', src: 'c-dialog.css', loading: 'defer' -%}
</component-loader>
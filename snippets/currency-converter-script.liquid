<script>
class CurrencyConverter {
  constructor() {
    this.shopCurrency = '{{ shop.currency }}';
    this.currentCurrency = this.shopCurrency;
    this.rates = {};
    this.autoDetect = {{ settings.custom_auto_detect_currency | json }};
    
    // RSD custom settings
    this.rsdCustomRateEnabled = {{ settings.rsd_custom_rate_enabled | json }};
    this.rsdCustomRate = parseFloat('{{ settings.rsd_custom_rate }}') || 117.0;
    this.rsdRoundingMethod = '{{ settings.rsd_rounding_method }}';
    this.defaultRoundingMethod = '{{ settings.default_rounding_method }}';
    
    this.init();
  }

  async init() {
    const savedCurrency = localStorage.getItem('selectedCurrency');
    
    if (savedCurrency) {
      this.currentCurrency = savedCurrency.toUpperCase();
    } else if (this.autoDetect) {
      await this.detectCurrency();
    }
    
    await this.fetchRates();
    this.setupSelector();
    this.convertPrices();
    this.observePriceChanges();
  }

  async detectCurrency() {
    try {
      const response = await fetch('https://ipapi.co/json/');
      const data = await response.json();
      const detectedCurrency = data.currency;
      
      const supportedCurrencies = '{{ settings.custom_supported_currencies }}'.split(',').map(c => c.trim());
      if (supportedCurrencies.includes(detectedCurrency)) {
        this.currentCurrency = detectedCurrency;
      }
    } catch (error) {
      console.log('Could not auto-detect currency:', error);
    }
  }

  async fetchRates() {
    try {
      const response = await fetch(`https://api.exchangerate-api.com/v4/latest/${this.shopCurrency}`);
      const data = await response.json();
      this.rates = data.rates;
      
      if (this.rsdCustomRateEnabled) {
        this.rates['RSD'] = this.rsdCustomRate;
        console.log(`Using custom RSD rate: 1 ${this.shopCurrency} = ${this.rsdCustomRate} RSD`);
      }
      
      console.log('Exchange rates loaded:', this.rates);
    } catch (error) {
      console.error('Error fetching exchange rates:', error);
      this.rates = { 
        [this.shopCurrency]: 1,
        'RSD': this.rsdCustomRateEnabled ? this.rsdCustomRate : 117.0
      };
    }
  }

  setupSelector() {
    // Update display on load
    this.updateSelectorDisplay(this.currentCurrency);

    // Handle button clicks
    document.querySelectorAll('[data-custom-currency-button]').forEach(button => {
      button.addEventListener('click', (e) => {
        const code = e.currentTarget.value.toUpperCase();
        this.currentCurrency = code;
        localStorage.setItem('selectedCurrency', code);
        this.updateSelectorDisplay(code);
        this.convertPrices();

        // Close disclosure
        const toggle = document.querySelector('[data-custom-currency-toggle]');
        if (toggle) {
          toggle.classList.remove('is-clicked');
          toggle.setAttribute('aria-expanded', 'false');
        }
      });
    });
  }

updateSelectorDisplay(code) {
  const code = e.currentTarget.value.toUpperCase();
  document.querySelectorAll('.custom-currency-code, .custom-currency-code-mobile').forEach(el => {
    el.textContent = code;
  });

  document.querySelectorAll('[data-custom-currency-item]').forEach(item => {
    const btn = item.querySelector('[data-custom-currency-button]');
    if (btn) {
      item.classList.toggle('disclosure-list__item--current', btn.value === code);
    }
  });
}

  convertPrices() {
    const priceSelectors = [
      '.price',
      '.money',
      '[data-price]',
      '.product-price',
      '.cart-price',
      '.total-price',
      '.price__regular',
      '.price-item',
      'span[class*="price"]'
    ];
    
    priceSelectors.forEach(selector => {
      document.querySelectorAll(selector).forEach(element => {
        this.convertElement(element);
      });
    });
  }

  convertElement(element) {
    if (element.dataset.converted === 'true' && element.dataset.convertedTo === this.currentCurrency) {
      return;
    }
    
    if (!element.dataset.originalPrice) {
      const priceText = element.textContent.trim();
      let priceString = priceText.replace(/[^\d.,]/g, '');

      const lastComma = priceString.lastIndexOf(',');
      const lastDot = priceString.lastIndexOf('.');

      if (lastComma > lastDot) {
        priceString = priceString.replace(/\./g, '').replace(',', '.');
      } else {
        priceString = priceString.replace(/,/g, '');
      }

      const price = parseFloat(priceString);

      if (!isNaN(price)) {
        element.dataset.originalPrice = price.toString();
        element.dataset.originalCurrency = this.shopCurrency;
      }
    }
    
    const originalPrice = parseFloat(element.dataset.originalPrice);
    if (isNaN(originalPrice)) return;
    
    const rate = this.rates[this.currentCurrency] || 1;
    let convertedPrice = originalPrice * rate;
    
    convertedPrice = this.roundPrice(convertedPrice, this.currentCurrency);
    
    const formattedPrice = this.formatPrice(convertedPrice, this.currentCurrency);
    element.textContent = formattedPrice;
    
    element.dataset.converted = 'true';
    element.dataset.convertedTo = this.currentCurrency;
  }

  roundPrice(price, currency) {
    if (currency === 'RSD') {
      switch (this.rsdRoundingMethod) {
        case 'round':
          return Math.round(price);
        case 'round_10':
          return Math.round(price / 10) * 10;
        case 'round_50':
          return Math.round(price / 50) * 50;
        case 'round_100':
          return Math.round(price / 100) * 100;
        case 'ceil_10':
          return Math.ceil(price / 10) * 10;
        case 'ceil_50':
          return Math.ceil(price / 50) * 50;
        case 'ceil_100':
          return Math.ceil(price / 100) * 100;
        case 'none':
          return Math.round(price * 100) / 100;
        default:
          return Math.round(price / 10) * 10;
      }
    }
    
    switch (this.defaultRoundingMethod) {
      case 'round':
        return Math.round(price);
      case 'none':
      default:
        return Math.round(price * 100) / 100;
    }
  }

  formatPrice(price, currency) {
    const symbols = {
      'EUR': '€',
      'USD': '$',
      'GBP': '£',
      'RSD': 'RSD',
      'CHF': 'CHF',
      'JPY': '¥',
      'CAD': 'CA$',
      'AUD': 'A$'
    };
    
    const symbol = symbols[currency] || currency;
    
    let decimals = 2;
    if (currency === 'RSD' && this.rsdRoundingMethod !== 'none') {
      decimals = 0;
    } else if (this.defaultRoundingMethod === 'round' && currency !== 'RSD') {
      decimals = 0;
    }
    
    const formattedNumber = price.toLocaleString('en-US', {
      minimumFractionDigits: decimals,
      maximumFractionDigits: decimals
    });
    
    if (currency === 'EUR') {
      return `${formattedNumber}${symbol}`;
    } else if (currency === 'RSD') {
      return `${formattedNumber} ${symbol}`;
    } else {
      return `${symbol}${formattedNumber}`;
    }
  }

  observePriceChanges() {
    const observer = new MutationObserver((mutations) => {
      clearTimeout(this.conversionTimeout);
      this.conversionTimeout = setTimeout(() => {
        this.convertPrices();
      }, 100);
    });
    
    observer.observe(document.body, {
      childList: true,
      subtree: true
    });
  }
}

if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', () => {
    new CurrencyConverter();
  });
} else {
  new CurrencyConverter();
}
</script>
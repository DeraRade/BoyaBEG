{% comment %}
    Used to show a star rating system on 'product-card' and on product page.

    Needs: 
        > (i) include only on page level not inside loops!
    {%- render 'inc-stylesheet', src: 'c-reviews.css', loading: 'defer' -%}

    Usage:
	{%- render 'c-reviews', product: product -%}
{%- endcomment -%}

{%- if product.metafields.reviews.rating.value != blank -%}

{%- liquid
    assign rating_decimal = 0
    assign decimal = product.metafields.reviews.rating.value.rating | modulo: 1

    if decimal >= 0.3 and decimal <= 0.7
        assign rating_decimal = 0.5
    elsif decimal > 0.7
        assign rating_decimal = 1
    endif
-%}

<coretex-rating>
    <coretex-rating>
        <div role="img" aria-label="{{ 'accessibility.star_reviews_info' | t: rating_value: product.metafields.reviews.rating.value, rating_max: product.metafields.reviews.rating.value.scale_max }}">
            <rating-bar 
                aria-hidden="true" 
                style="{{ product.metafields.reviews.rating.value.rating | floor | prepend: '--rating:' | append: ';' }}{{ product.metafields.reviews.rating.value.scale_max | prepend: '--rating-max:' | append: ';' }}{{ rating_decimal | prepend: '--rating-decimal:' | append: ';' }}"
                title="{{- product.metafields.reviews.rating.value }} / {{ product.metafields.reviews.rating.value.scale_max }} ({{ product.metafields.reviews.rating_count }} {{ 'accessibility.total_reviews' | t -}})"
            >&ast;&ast;&ast;&ast;&ast;</rating-bar>
        </div>
    </coretex-rating>

    <div class="visually-hidden">
        <span aria-hidden="true">{{- product.metafields.reviews.rating.value }} / {{ product.metafields.reviews.rating.value.scale_max -}}</span>
        <span aria-hidden="true">({{ product.metafields.reviews.rating_count }})</span>
        <span class="visually-hidden">{{- product.metafields.reviews.rating_count }} {{ 'accessibility.total_reviews' | t -}}</span>
    </div>
</coretex-rating>
{%- endif -%}
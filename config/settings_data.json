    "coretexJS": "document.addEventListener('DOMContentLoaded', function() {\n  // Buscar el bloque de formulario de suscripción Mailchimp\n  const newsletterForm = document.querySelector('[data-block-id=\"ai_gen_block_7b907b0_WtU9fR\"]');\n  \n  if (newsletterForm) {\n    const form = newsletterForm.querySelector('form');\n    \n    if (form) {\n      // Prevenir el envío estándar del formulario\n      form.addEventListener('submit', function(e) {\n        e.preventDefault();\n        \n        // Obtener la acción del formulario (URL de Mailchimp)\n        let mailchimpUrl = form.getAttribute('action');\n        \n        if (!mailchimpUrl) {\n          console.error('No se encontró la URL de Mailchimp');\n          return;\n        }\n        \n        // Convertir la URL de /post? a /post-json?\n        mailchimpUrl = mailchimpUrl.replace('/post?', '/post-json?');\n        \n        // Obtener los datos del formulario\n        const formData = new FormData(form);\n        const params = new URLSearchParams(formData);\n        \n        // Agregar el parámetro JSONP callback\n        const callbackName = 'mce_callback_' + Math.random().toString(36).substr(2, 9);\n        params.append('c', callbackName);\n        \n        // Construir la URL final\n        const finalUrl = mailchimpUrl + '&' + params.toString();\n        \n        // Crear un script JSONP dinámico\n        const script = document.createElement('script');\n        script.src = finalUrl;\n        \n        // Definir el callback global\n        window[callbackName] = function(response) {\n          // Limpiar el script\n          script.remove();\n          delete window[callbackName];\n          \n          // Verificar si la suscripción fue exitosa\n          if (response.result === 'success' || response.result === 0) {\n            // Ocultar el formulario\n            form.style.display = 'none';\n            \n            // Crear y mostrar el mensaje de éxito\n            let successMessage = newsletterForm.querySelector('[data-success-message]');\n            \n            if (!successMessage) {\n              successMessage = document.createElement('div');\n              successMessage.setAttribute('data-success-message', 'true');\n              successMessage.style.textAlign = 'center';\n              successMessage.style.padding = '2rem';\n              successMessage.style.fontSize = '1.5rem';\n              successMessage.style.color = '#529214';\n              successMessage.style.fontWeight = 'bold';\n              successMessage.style.fontFamily = 'inherit';\n              successMessage.textContent = '¡Gracias!';\n              \n              form.parentNode.insertBefore(successMessage, form);\n            } else {\n              successMessage.style.display = 'block';\n            }\n          } else {\n            // Manejar errores\n            console.error('Error en la suscripción:', response);\n            \n            // Mostrar mensaje de error si existe\n            if (response.msg) {\n              alert('Error: ' + response.msg);\n            }\n          }\n        };\n        \n        // Agregar el script al documento para ejecutar la solicitud JSONP\n        document.head.appendChild(script);\n      });\n    }\n  }\n});",

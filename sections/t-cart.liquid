{%- render 'c-cart', location: 'page', blocks: section.blocks, section: section -%}

{% schema %}
{
  "name": "Cart page",
  "tag": "section",
  "class": "cart-page",
  "limit": 1,
  "enabled_on": { "templates": ["cart"] },
  "settings": [
    {
        "type": "checkbox",
        "id": "tabs_column",
        "label": "Display tabs in column",
        "info": "Enable this option to arrange tabs vertically in a column format.",
        "default": true
    }
  ],
  "blocks": [
    {
        "type": "@app"
    },
    {
      "type": "tabs",
      "name": "Tabs",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Title"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>Tab content</p>"
        },
        {
          "type": "checkbox",
          "id": "expand",
          "label": "Expand tab by default",
          "default": false
        }
      ]
    }
  ]
}
{% endschema %}
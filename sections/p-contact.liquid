      "name": "Custom Liquid",
      "settings": [
        {
          "type": "liquid",
          "id": "liquid",
          "label": "Custom Liquid"
        }
      ]
    },
    {
      "type": "name",
      "name": "Name",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "requiredInput",
          "label": "Required input",
          "info": "Make the input required",
          "default": false
        }
      ]
    },
    {
      "type": "email",
      "name": "Email",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "requiredInput",
          "label": "Required input",
          "info": "Make the input required",
          "default": false
        }
      ]
    },
    {
      "type": "phone",
      "name": "Phone number",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "requiredInput",
          "label": "Required input",
          "info": "Make the input required",
          "default": false
        }
      ]
    },
    {
      "type": "ordernumber",
      "name": "Order number",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "requiredInput",
          "label": "Required input",
          "info": "Make the input required",
          "default": false
        }
      ]
    },
    {
      "type": "text",
      "name": "Input",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Label",
          "default": "Text input label"
        },
        {
          "type": "checkbox",
          "id": "requiredInput",
          "label": "Required",
          "info": "Make the input required",
          "default": false
        }
      ]
    },
    {
      "type": "url",
      "name": "URL",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Input label",
          "default": "URL"
        },
        {
          "type": "checkbox",
          "id": "requiredInput",
          "label": "Required input",
          "info": "Make the input required",
          "default": false
        }
      ]
    },
    {
      "type": "checkbox",

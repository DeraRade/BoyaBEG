{%- render 'inc-stylesheet', src: 's-sections.css' -%}

{%- capture style -%}
padding-block: {{ section.settings.paddingTop | prepend: 'var(--space-' | append: ')' }} {{ section.settings.paddingBottom | prepend: 'var(--space-' | append: ')' }};
margin-block: {{ section.settings.marginTop | prepend: 'var(--space-' | append: ')' }} {{ section.settings.marginBottom | prepend: 'var(--space-' | append: ')' }};
padding-inline: var(--layoutInline);
{%- endcapture -%}

<section
	class="events"
	style="{{- style | strip_newlines | strip -}}"
	{% unless section.settings.global_color_scheme %}color-scheme="{{ section.settings.color_scheme }}"{% endunless %}
	data-section-id="{{ section.id }}"
>
	{%- liquid
        # Section heading 
        assign heading = section.settings.heading
        assign description = section.settings.description
        assign url = section.settings.url
        assign url_label = section.settings.label
        assign attributes = 'wrap-s="wrap"'
        assign stealth = section.settings.stealthMode

        render 'c-section-head', heading: heading, description: description, url: url, url_label: url_label, attributes: attributes, stealth: stealth
    -%}

    <x-flex direction="column">
	{%- for block in section.blocks -%}
		{%- if block.type == 'event' -%}
        <x-cell>
            <details class="closex" {% if block.settings.expand_by_default %}open{% endif %} {{ block.shopify_attributes }} event-expired="{{ block.settings.expired }}">
				<summary>
					<x-grid columns="4" columns-s="3">
						<x-cell>{{ block.settings.date }}</x-cell>
						<x-cell>{{ block.settings.time }}</x-cell>
						<x-cell><h3 class="h6 text-normal title">{{ block.settings.heading }}</h3></x-cell>
						<x-cell class="large-only">{{ block.settings.location }}</x-cell>
					</x-grid>
				</summary>

				<x-grid columns="4" columns-s="3" class="event-details">
					<x-cell>
						{%- liquid
							assign img = block.settings.image
							assign width = 900
							assign widths = '200,300,400,500,750,800,900'
							assign mediaLoader = true

							render 'inc-img', img: img, width: width, widths: widths, mediaLoader: mediaLoader, fallback: true
						-%}
					</x-cell>

					<x-cell span="3+1" span-s="2+2">
						<div class="content rte">{{ block.settings.description | replace: '\n', '<br/>' }}</div>
					</x-cell>

					<x-cell span-s="row" class="linx">
                        <x-cell class="small-only">{{ block.settings.location }} <br></x-cell>
                        {%- if block.settings.mapURL != blank -%}
                        <a href="{{ block.settings.mapURL }}" class="button has-icon is-link text-underline" target="_blank"> 
                            <span>{{ block.settings.map }}</span>&nbsp;{%- render 'inc-icon', icon: 'arrow-right' -%}
                        </a>
                        {%- endif -%}
                    </x-cell>
				</x-grid>
			</details>
        </x-cell>
		{%- endif -%}
	{%- endfor -%}
    </x-flex>
</section>

{% schema %}
	{
		"name": "Events",
		"disabled_on": { "groups": ["header", "footer", "aside"] },
		"presets": [
			{
				"name": "Events",
                "category": "Content",
				"blocks": [{ "type": "event" }]
			}
		],
		"settings": [
			{
				"type": "header",
				"content": "Header"
			},
            {
                "type": "checkbox",
                "id": "stealthMode",
                "label": "Show header on hover - desktop",
                "default": false
            },
            {
                "type": "text",
                "id": "heading",
                "label": "Heading",
                "default": "Events"
            },
            {
                "type": "text",
                "id": "description",
                "label": "Description",
                "default": "Use this to describe your section."
            },
            {
                "type": "url",
                "id": "url",
                "label": "URL"
            },
            {
                "type": "text",
                "id": "label",
                "label": "Label",
                "default": "View all events"
            },
			{
				"type": "header",
				"content": "Spacing"
			},
			{
				"type": "range",
				"id": "marginTop",
				"label": "Margin top",
				"min": 0,
				"max": 30,
				"step": 1,
				"default": 3
			},
			{
				"type": "range",
				"id": "marginBottom",
				"label": "Margin bottom",
				"min": 0,
				"max": 30,
				"step": 1,
				"default": 3
			},
			{
				"type": "range",
				"id": "paddingTop",
				"label": "Padding top",
				"min": 0,
				"max": 30,
				"step": 1,
				"default": 3
			},
			{
				"type": "range",
				"id": "paddingBottom",
				"label": "Padding bottom",
				"min": 0,
				"max": 30,
				"step": 1,
				"default": 3
			},
			{
				"type": "header",
				"content": "Appearance"
			},
            {
                "type": "checkbox",
                "id": "global_color_scheme",
                "label": "Use global color scheme",
                "default": true
            },
            {
                "type": "color_scheme",
                "id": "color_scheme",
                "label": "Color scheme",
                "default": "coretex-1",
                "visible_if": "{{ section.settings.global_color_scheme == false }}"
            }
		],
		"blocks": [
			{
				"type": "event",
				"name": "Event",
				"settings": [
					{
						"type": "checkbox",
						"id": "expand_by_default",
						"label": "Expand by default",
						"default": false
					},
					{
						"type": "image_picker",
						"id": "image",
						"label": "Image"
					},
					{
						"type": "text",
						"id": "heading",
						"label": "Heading",
						"default": "Event name"
					},
					{
						"type": "inline_richtext",
						"id": "description",
						"label": "Description"
					},
					{
						"type": "text",
						"id": "date",
						"label": "Date",
						"default": "Friday, 31/12/3000"
					},
					{
						"type": "text",
						"id": "time",
						"label": "Time",
						"default": "18:30"
					},
					{
						"type": "text",
						"id": "location",
						"label": "Location name",
                        "default": "@ Location name"
					},
					{
						"type": "url",
						"id": "mapURL",
						"label": "Location map"
					},
					{
						"type": "text",
						"id": "map",
						"label": "View map",
                        "default": "View map"
					},
					{
						"type": "checkbox",
						"id": "expired",
						"label": "Event expired",
						"default": false
					}
				]
			}
		]
	}
{% endschema %}

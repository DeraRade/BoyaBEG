            "default": false,
            "info": "If a Heading link is defined, this will not function."
        },
        {
            "type": "header",
            "content": "Content"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Your hero video heading"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Heading link"
        },
        {
              "type": "range",
              "id": "fontSize",
              "label": "Text size - desktop",
              "min": 1,
              "max": 30,
              "step": 1,
              "default": 2
        },
        {
              "type": "range",
              "id": "fontSizeMob",
              "label": "Text size - mobile",
              "min": 1,
              "max": 30,
              "step": 1,
              "default": 2
        },
        {
            "type": "checkbox",
            "id": "fontBold",
            "label": "Enable bold text",
            "default": false
        },
        {
            "type": "checkbox",
            "id": "sticky",
            "label": "Stick content",
            "default": true
        },
        {
          "type": "select",
          "id": "contentPosition",
          "label": "Content position",
          "default": "top left",
          "options": [
            {
              "value": "top left",
              "label": "Top left"
            },
            {
              "value": "top center",
              "label": "Top center"
            },
            {
              "value": "top right",
              "label": "Top right"
            },
            {
              "value": "center left",
              "label": "Middle left"
            },
            {
              "value": "center",
              "label": "Middle center"
            },
            {
              "value": "center right",
              "label": "Middle right"
            },
            {
              "value": "bottom left",
              "label": "Bottom left"
            },
            {
              "value": "bottom center",
              "label": "Bottom center"
            },
            {
              "value": "bottom right",
              "label": "Bottom right"
            }
          ]
        },
        {
          "type": "header",
          "content": "Appearance"

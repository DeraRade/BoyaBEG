{%- render 'inc-stylesheet', src: 't-collection.css' -%}
<style>product-card { position: relative }</style>

<section class="collections" filter-location="{{ section.settings.facets_location }}">

    <section class="page-intro willShrink" color-scheme="{{ section.settings.color_scheme }}">

        <x-grid columns="12" columns-s="1f">
            <x-cell span="3" span-m="5" span-s="row" class="page-title{% if section.settings.show_title != true %} visually-hidden{% endif %}">
                <h1 class="h4 title">{{- collection.title | escape -}}</h1>
            </x-cell>

            {%- if section.settings.show_description and collection.description != blank -%}
            <x-cell span="4" span-m="6" class="description">
                <div class="rte">{{ collection.description }}</div>
            </x-cell>
            {%- endif -%}

            {%- if section.settings.show_image and collection.image -%}
            <x-cell span="5" span-m="row" span-s="row" class="poster">
                <media-loader>
                    {%- render 'inc-img' 
                        img: collection.image, 
                        widths: '480,640,768,1024,1280,1536,1920,2560', 
                        sizes: '(min-width: 777px) 450px, 78.75vw', 
                        ph: true, 
                        fallback: false,
                        fetchpriority: 'high',
                        preload: true,
                        loading: 'eager'
                    -%}
                </media-loader>
            </x-cell>
            {%- endif -%}

        </x-grid>
    </section>

    {%- # Filters button -%}
    {%- if collection.products_count > 0 -%}
    <section class="filter-trigger willShrink sticky" style="--sticky: var(--headSpace, 0px); --stickyZindex: 10">
        {%- liquid
            if section.settings.grid_view_controller and section.settings.show_facets
                assign trigger_alignment = 'between'
            elsif section.settings.show_facets == false and section.settings.grid_view_controller
                assign trigger_alignment = 'end'
            else 
                assign trigger_alignment = section.settings.trigger_alignment | replace: 'left', 'start' | replace: 'right', 'end'
            endif
        -%}
        <x-flex ai="center" jc="{{ trigger_alignment }}" as-button="{{ section.settings.trigger_as_button }}">
            {%- if section.settings.show_facets -%}
            <button role="button" class="button has-icon{% if section.settings.trigger_as_button == false %} is-blank{% endif %}" data-open="#filtersBox">
                {%- render 'inc-icon', icon: 'settings' -%} 
                <span>{{ 'products.facets.filter_and_sort' | t }}</span>
            </button>
            {%  endif %}

            {%- if section.settings.grid_view_controller -%}
            <component-loader js="end"><grid-view-controller>
                <details class="closex text-end">
                  <summary class="button {% if section.settings.trigger_as_button == false %} is-custom{% endif %} has-icon text-end">
                    {%- render 'inc-icon', icon: 'layout-grid' -%}
                    <span>{{ 'openthinking.dictionary.word.view' | t }}</span>
                  </summary>
              
                  <details-menu class="closex">
                    <x-flex ai="center">
                      <button data-col="1" class="is-custom text-normal small-only">1</button>
                      <button data-col="2" class="is-custom text-normal">2</button>
                      <button data-col="3" class="is-custom text-normal">3</button>
                      <button data-col="4" class="is-custom text-normal">4</button>
                      <button data-col="5" class="is-custom text-normal">5</button>
                      <button data-col="6" class="is-custom text-normal large-only">6</button>
                      <button data-col="10" class="is-custom text-normal large-only">10</button>
                    </x-flex>
                  </details-menu>
                </details>
            </grid-view-controller></component-loader>
            {%- endif -%}
  
        </x-flex>
    </section>

    {%- # Quick links -%}
    <section class="page-quickLinks willShrink">
        {%- if linklists[section.settings.suggested_links].links != empty -%}
        <div class="listoftags listofsuggested">
            <x-flex class="mob-scroller">
                {%- for link in linklists[section.settings.suggested_links].links -%}
                <a href="{{ link.url }}" class="button is-custom text-normal">{{ link.title }}</a>
                {%- endfor -%}
            </x-flex>
        </div>
        {%- endif -%}
    </section>

    {%- # Filters and sort -%} 
    {% if section.settings.show_facets %}
    <component-loader><coretex-drawer
        class="filters" id="filtersBox" data-nobdc
        role="dialog" aria-modal="true" aria-label="{{ 'products.facets.filter_and_sort' | t }}"
        style="display:none;{% if section.settings.facets_shadow %}box-shadow:var(--globalShadow);{% endif %}"
    >

        {%- # Used for Menu: drawer (mobile + desktop) -%}
        <drawer-header x-flex direction="row" ai="center" jc="between" class="sticky">
            <h2 class="h6" style="--hMargin:0">{{ 'products.facets.filter_and_sort' | t }}</h2>
            <button role="button" x-flex class="is-custom has-icon" data-close>
                <span class="visually-hidden">{{ 'accessibility.close' | t }}</span>
                {%- render 'inc-icon', icon: 'x-close' -%}
            </button>
        </drawer-header>

        {% comment %}
            FACETS (FILTERS & SORTING)
        {%- endcomment -%}
        {%- liquid 
            if section.settings.show_facets
                render 'c-facets', results: collection, enable_filtering: section.settings.show_facets, enable_sorting: true, expand_by_default: section.settings.expand_by_default 
            endif 
        -%}

    </coretex-drawer></component-loader>
    {%- endif -%}
    {%- endif -%}

    <section class="product-list willShrink" data-facets-form-content="products-list">
        <component-loader>
            {%- if collection.products.size == 0 -%}

                {% comment %} 
                NO PRODUCTS
                {% endcomment %}
                <div class="container empty">
                    <x-flex direction="row" wrap="wrap">
                        <x-cell><span class="title">{{ 'sections.collection_template.empty' | t -}}</span></x-cell>
                        <x-cell><a href="{{ routes.all_products_collection_url }}" class="text-underline">{{ 'general.continue_shopping' | t }}</a></x-cell>
                    </x-flex>
                </div>

            {%- else -%}
                {% comment %} <coretex-fetch id="coretex-fetch-pagination-{{ section.id }}"> {% endcomment %}
                {%- paginate collection.products by section.settings.items_per_page -%}
                    {% comment %}
                    === [ CORETEX FYI ] ===
                    About the <infinity-scroll> component.

                    Mandatory:
                    - coretex-container: the container with inside the loop with product/blog card.
                    - coretex-pagination: the container for the pagination link. Keep in mind that the pagination link has to have only 1 <a> with the next page link.
                    - coretex-loading: {{ 'accessibility.loading' | t }}
                    - the next link <a> has to have only a <span coretex-loading-more>
                    {% endcomment %}
                    {%- if section.settings.mode == 'infinity' -%}
                        <infinity-scroll coretex-container="#ajaxContainer" coretex-pagination="#ajaxPagination" coretex-loading="{{ 'accessibility.loading' | t }}">
                    {%- endif -%}

                        <x-grid
                            columns="{{ section.settings.card_grid_columns }}" 
                            columns-m="{{ section.settings.card_grid_columns_m }}" 
                            columns-s="{{ section.settings.card_grid_columns_s }}" 
                            class="products{% if section.settings.grid_view_controller %} preloading{% endif %}"  
                            id="ajaxContainer"
                            style="{{ section.settings.card_grid_gap | prepend: '--prodGap: var(--space-' | append: ');' }} {{ section.settings.card_grid_gap_s | prepend: '--prodGapMob: var(--space-' | append: ');'}}"
                        >
                            {%- liquid
                                for product in collection.products
                                    render 'c-prod-card', product: product, css: false, index: forloop.index
                                endfor
                            -%}
                        </x-grid>
                    
                        {% comment %}
                            PAGINATION
                        {% endcomment %}
                        {%- render 'c-pagination'
                            paginate: paginate, 
                            mode: section.settings.mode
                        -%}
                            
                    {%- if section.settings.mode == 'infinity' -%}
                        </infinity-scroll>
                    {%- endif -%}
                    
                {%- endpaginate -%}
                {% comment %} </coretex-fetch> {% endcomment %}
            {%- endif -%}
        </component-loader>
    </section>

</section>

{% schema %}
{
  "name": "Collection",
  "settings": [
    {
        "type": "header",
        "content": "Grid"
    },
    {
      "type": "checkbox",
      "id": "grid_view_controller",
      "label": "Enable grid view controller",
      "info": "Lets the customer choose how many columns to display in the grid view.",
      "default": true
    },
    {
        "type": "select",
        "id": "card_grid_columns",
        "label": "Columns - desktop",
        "default": "5",
        "options": [
            {
                "value": "2",
                "label": "2 columns"
            },
            {
                "value": "3",
                "label": "3 columns"
            },
            {
                "value": "4",
                "label": "4 columns"
            },
            {
                "value": "5",
                "label": "5 columns"
            },
            {
                "value": "6",
                "label": "6 columns"
            },
            {
                "value": "10",
                "label": "10 columns"
            }
        ]
    },
    {
        "type": "select",
        "id": "card_grid_columns_m",
        "label": "Columns - tablet",
        "default": "3",
        "options": [
            {
                "value": "2",
                "label": "2 columns"
            },
            {
                "value": "3",
                "label": "3 columns"
            },
            {
                "value": "4",
                "label": "4 columns"
            },
            {
                "value": "5",
                "label": "5 columns"
            }
        ]
    },
    {
        "type": "select",
        "id": "card_grid_columns_s",
        "label": "Columns - mobile",
        "default": "2",
        "options": [
            {
                "value": "1",
                "label": "1 column"
            },
            {
                "value": "2",
                "label": "2 columns"
            },
            {
                "value": "3",
                "label": "3 columns"
            }
        ]
    },
    {
        "type": "range",
        "label": "Gap - desktop",
        "id": "card_grid_gap",
        "min": 0,
        "max": 30,
        "step": 1,
        "default": 3
    },
    {
        "type": "range",
        "label": "Gap - mobile",
        "id": "card_grid_gap_s",
        "min": 0,
        "max": 30,
        "step": 1,
        "default": 2
    },
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "Show title",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show description",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Show featured image",
      "default": true
    },
    {
      "type": "header",
      "content": "Links"
    },
    {
      "type": "link_list",
      "id": "suggested_links",
      "label": "Suggested links",
      "info": "Display a list of suggested links."
    },
    {
      "type": "header",
      "content": "Filters",
      "info": "Allow your customers to filter collections and search results by product availability, price, color, and more. [Learn more...](https://help.shopify.com/en/manual/online-store/themes/customizing-themes/storefront-filters#add-filters)"
    },
    {
      "type": "checkbox",
      "id": "show_facets",
      "label": "Enable",
      "default": true
    },
    {
        "type": "text_alignment",
        "id": "trigger_alignment",
        "label": "Trigger button alignment",
        "info": "Controls the alignment of the trigger button.",
        "default": "left",
        "visible_if": "{{ section.settings.show_facets and section.settings.grid_view_controller == false }}"
    },
    {
        "type": "checkbox",
        "id": "trigger_as_button",
        "label": "Show trigger as button",
        "info": "Adds a background color to the button for better visibility.",
        "default": false,
        "visible_if": "{{ section.settings.show_facets }}"
    },
    {
        "type": "checkbox",
        "id": "expand_by_default",
        "label": "Expand by default",
        "info": "If enabled, the filter groups, inside the drawer, will be expanded by default.",
        "default": true,
        "visible_if": "{{ section.settings.show_facets }}"
    }, 
    {
        "type": "select",
        "id": "facets_location",
        "label": "Position - desktop",
        "default": "end",
        "info": "Choose the position of the drawer.",
        "visible_if": "{{ section.settings.show_facets }}",
        "options": [
          {
            "value": "start",
            "label": "Left"
          },
          {
            "value": "end",
            "label": "Right"
          }
        ]
    },    
    {
      "type": "checkbox",
      "id": "facets_shadow",
      "label": "Show shadow",
      "info": "Adds a slight shadow to the drawer.",
      "default": true,
      "visible_if": "{{ section.settings.show_facets }}"
    },  
    {
      "type": "header",
      "content": "Pagination"
    },
    {
      "type": "select",
      "id": "mode",
      "label": "Type",
      "default": "classic",
      "options": [
        {
          "value": "classic",
          "label": "Numbers"
        },
        {
          "value": "infinity",
          "label": "Load on scroll"
        }
      ]
    },
    {
      "type": "range",
      "label": "Items per page",
      "id": "items_per_page",
      "min": 4,
      "max": 50,
      "step": 1,
      "default": 15
    }
  ]
}
{% endschema %}
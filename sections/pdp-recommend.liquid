{%- render 'inc-stylesheet', src: 's-sections.css' -%}
{%- assign layoutType = section.settings.layoutType -%}

{%- capture style -%}
padding-block: {{ section.settings.paddingTop | prepend: 'var(--space-' | append: ')' }} {{ section.settings.paddingBottom | prepend: 'var(--space-' | append: ')' }};
margin-block: {{ section.settings.marginTop | prepend: 'var(--space-' | append: ')' }} {{ section.settings.marginBottom | prepend: 'var(--space-' | append: ')' }};
{%- endcapture -%}

{% comment %}theme-check-disable{% endcomment %}
<product-recommendations
    data-url="{{ routes.product_recommendations_url }}?limit={{ section.settings.product_limit }}"
    data-section-id="{{ section.id }}"
    data-product-id="{{ product.id }}"
    class="feat-products listOfProds"
	style="{{- style | strip_newlines | strip -}}"
	{% unless section.settings.global_color_scheme %}color-scheme="{{ section.settings.color_scheme }}"{% endunless %}
    layout-type="{{ layoutType }}"
>
	{%- liquid
        if recommendations.performed and recommendations.products_count > 0
            # Section heading 
            capture section_heading
                assign heading = section.settings.heading
                assign attributes = 'wrap-s="wrap" ai="center"'
                assign stealth = section.settings.stealthMode
                if layoutType == 'list'
                    assign nav = true
                endif

                # Render section head
                render 'c-section-head', heading: heading, nav: nav, attributes: attributes, stealth: stealth
            endcapture

            # Render section body
            render 'c-section-grid', section: section, layoutType: layoutType, products: recommendations.products, section_heading: section_heading
        endif
    -%}
</product-recommendations>
{% comment %}theme-check-enable{% endcomment %}

{% schema %}
{
  "name": "Related products",
  "tag": "section",
  "class": "suggested related",
  "settings": [
    {
        "type": "paragraph",
        "content": "Control product recommendations with the Shopify Search & Discovery app. [Learn more](https://help.shopify.com/en/manual/online-store/search-and-discovery/product-recommendations)."
    },
    {
        "type": "checkbox",
        "id": "stealthMode",
        "label": "Show header on hover - desktop",
        "default": false
    },
    {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "You may also like"
    },
    {
        "type": "range",
        "label": "Number of products to show",
        "id": "product_limit",
        "min": 1,
        "max": 10,
        "step": 1,
        "default": 10
    },
    {
        "type": "header",
        "content": "Content"
    },
    {
        "type": "select",
        "id": "layoutType",
        "label": "Layout",
        "default": "list",
        "options": [
            { "value": "list", "label": "List" },
            { "value": "grid", "label": "Grid" }
        ]
    },
    {
        "type": "select",
        "id": "card_grid_columns",
        "label": "Columns - desktop",
        "default": "5",
        "visible_if": "{{ section.settings.layoutType == 'grid' }}",
        "options": [
            {
                "value": "2",
                "label": "2 columns"
            },
            {
                "value": "3",
                "label": "3 columns"
            },
            {
                "value": "4",
                "label": "4 columns"
            },
            {
                "value": "5",
                "label": "5 columns"
            },
            {
                "value": "6",
                "label": "6 columns"
            }
        ]
    },
    {
        "type": "select",
        "id": "card_grid_columns_m",
        "label": "Columns - tablet",
        "default": "3",
        "visible_if": "{{ section.settings.layoutType == 'grid' }}",
        "options": [
            {
                "value": "2",
                "label": "2 columns"
            },
            {
                "value": "3",
                "label": "3 columns"
            },
            {
                "value": "4",
                "label": "4 columns"
            }
        ]
    },
    {
        "type": "select",
        "id": "card_grid_columns_s",
        "label": "Columns - mobile",
        "default": "2",
        "visible_if": "{{ section.settings.layoutType == 'grid' }}",
        "options": [
            {
                "value": "1",
                "label": "1 column"
            },
            {
                "value": "2",
                "label": "2 columns"
            }
        ]
    },
	{
		"type": "range",
		"label": "Gap - desktop",
		"id": "card_grid_gap",
		"min": 0,
		"max": 30,
		"step": 1,
		"default": 3,
        "visible_if": "{{ section.settings.layoutType == 'grid' }}"
	},
	{
		"type": "range",
		"label": "Gap - mobile",
		"id": "card_grid_gap_s",
		"min": 0,
		"max": 30,
		"step": 1,
		"default": 2,
        "visible_if": "{{ section.settings.layoutType == 'grid' }}"
	},
    {
        "type": "header",
        "content": "Spacing"
    },
    {
        "type": "range",
        "id": "marginTop",
        "label": "Margin top",
        "min": 0,
        "max": 30,
        "step": 1,
        "default": 2
    },
    {
        "type": "range",
        "id": "marginBottom",
        "label": "Margin bottom",
        "min": 0,
        "max": 30,
        "step": 1,
        "default": 2
    },
    {
        "type": "range",
        "id": "paddingTop",
        "label": "Padding top",
        "min": 0,
        "max": 30,
        "step": 1,
        "default": 2
    },
    {
        "type": "range",
        "id": "paddingBottom",
        "label": "Padding bottom",
        "min": 0,
        "max": 30,
        "step": 1,
        "default": 2
    },
    {
        "type": "header",
        "content": "Appearance"
    },
    {
        "type": "checkbox",
        "id": "global_color_scheme",
        "label": "Use global color scheme",
        "default": true
    },
    {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "Color scheme",
        "default": "coretex-1",
        "visible_if": "{{ section.settings.global_color_scheme == false }}"
    }
  ]
}
{% endschema %}
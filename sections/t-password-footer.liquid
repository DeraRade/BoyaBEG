<section x-flex ai="center" jc="between" class="footer" 
	{% unless section.settings.global_color_scheme %}color-scheme="{{ section.settings.color_scheme }}"{% endunless %}
	data-section-id="{{ section.id }}"
>

<password-modal>
    <x-flex direction="row" ai="center" class="password-form-wrapper" id="login">
    	<password-form>
            {%- form 'storefront_password' -%}
                <x-flex ai="center">
                    <x-cell>
                        <x-field>
                            <input
                                type="password"
                                name="password"
                                id="Password"
                                autocomplete="off"
                                {% if form.errors %}
                                    aria-invalid="true"
                                    aria-describedby="PasswordLoginForm-password-error"
                                    autofocus
                                {%- endif -%}
                                placeholder="{{ 'general.password_page.login_form_password_placeholder' | t }}"
                            >

                            <label for="{{ 'general.password_page.login_form_password_label' | t }}">{{- 'general.password_page.login_form_password_placeholder' | t -}}</label>
                        </x-field>

                        {%- if form.errors -%}
                            <script>window.location.hash = "login"</script>
                            <form-error id="PasswordLoginForm-password-error" role="status" tabindex="-1">
                                <span class="visually-hidden">{{ 'accessibility.error' | t }}</span>
                                <span class="message">{{ 'general.password_page.login_form_error' | t -}}</span>
                            </form-error>
                        {%- endif -%}
                    </x-cell>

                    <x-cell>
                        <button type="submit" name="commit" id="enter" class="has-icon is-pill text-normal">{{ 'general.password_page.login_form_submit' | t }}</button>
                    </x-cell>
                </x-flex>
            {%- endform -%}
    	</password-form>

        <x-cell>
            <a href="#!" class="button has-icon is-circle" aria-label="{{ 'accessibility.close' | t }}">
                {%- render 'inc-icon', icon: 'x-close' -%}
            </a>
        </x-cell>
    </x-flex>

    {% if section.settings.show_password %}
    <a href="#login" type="button" id="loginFire" class="button has-icon">{{ 'general.password_page.login_password_button' | t }}</a>
    {% endif %}

</password-modal>

{% if section.settings.social %}
    <x-cell>
        {%- render 'inc-socials', 
            location: 'footer', 
            style: 'no-style inside',
            attribute: 'x-flex direction="row"',
            type: 'text',
            button: 'false'
        -%}
    </x-cell>
{% endif %}

</section>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
        "type": "checkbox",
        "id": "show_password",
        "label": "Show password box",
        "default": false
    },
    {
      "type": "checkbox",
      "id": "social",
      "label": "Show social media links",
      "default": false,
      "info": "Link your social network accounts in your [Theme settings > Social media](/editor?context=theme&category=social+media) to display them."
    },
    {
        "type": "checkbox",
        "id": "global_color_scheme",
        "label": "Use global color scheme",
        "default": true
    },
    {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "Color scheme",
        "default": "coretex-1",
        "visible_if": "{{ section.settings.global_color_scheme == false }}"
    }
  ]
}
{% endschema %}

{% # Used to render the customer area navigation %}
{%- render 'c-customers' -%}

<section class="customer addresses">
  <h1 class="h4 pageTitle">{{ 'customer.addresses.title' | t }}</h1>

  <coretex-fetch id="coretex-fetch-addresses-pagination-{{ section.id }}">
    <component-loader>
      {%- paginate customer.addresses by 10 -%}
        {%- comment -%}
          Address form
        {%- endcomment -%}
        <div class="address" data-customer-addresses>
          {%- comment -%}
            Tabs URL
          {%- endcomment -%}
          <a href="#new-address" class="button">{{ 'customer.addresses.add_new' | t }}</a>

          {%- comment -%}
            Tab: Address form
          {%- endcomment -%}
          <coretex-address data-address>
            {%- comment -%}
              Tab: New address
            {%- endcomment -%}
            <h3 class="h3" id="new-address" tabindex="-1">{{ 'customer.addresses.add_new' | t }}</h3>
            <div id="newAddress">
              {% # Start form %}
              {%- form 'customer_address', customer.new_address, aria-labelledBy: 'AddressNewHeading' -%}
                <x-field>
                  <input
                    type="text"
                    id="AddressFirstNameNew"
                    name="address[first_name]"
                    value="{{ form.first_name }}"
                    autocomplete="given-name"
                    placeholder="{{ 'customer.addresses.first_name' | t }}"
                  >
                  <label for="AddressFirstNameNew-{{ form.id }}">{{ 'customer.addresses.first_name' | t }}</label>
                </x-field>

                <x-field>
                  <input
                    type="text"
                    id="AddressLastNameNew"
                    name="address[last_name]"
                    value="{{ form.last_name }}"
                    autocomplete="family-name"
                    placeholder="{{ 'customer.addresses.last_name' | t }}"
                  >
                  <label for="AddressLastNameNew">{{ 'customer.addresses.last_name' | t }}</label>
                </x-field>

                <x-field>
                  <input
                    type="text"
                    id="AddressCompanyNew"
                    name="address[company]"
                    value="{{ form.company }}"
                    autocomplete="organization"
                    placeholder="{{ 'customer.addresses.company' | t }}"
                  >
                  <label for="AddressCompanyNew">{{ 'customer.addresses.company' | t }}</label>
                </x-field>

                <x-field>
                  <input
                    type="text"
                    id="AddressAddress1New"
                    name="address[address1]"
                    value="{{ form.address1 }}"
                    autocomplete="address-line1"
                    placeholder="{{ 'customer.addresses.address1' | t }}"
                  >
                  <label for="AddressAddress1New">{{ 'customer.addresses.address1' | t }}</label>
                </x-field>

                <x-field>
                  <input
                    type="text"
                    id="AddressAddress2New"
                    name="address[address2]"
                    value="{{ form.address2 }}"
                    autocomplete="address-line2"
                    placeholder="{{ 'customer.addresses.address2' | t }}"
                  >
                  <label for="AddressAddress2New">{{ 'customer.addresses.address2' | t }}</label>
                </x-field>

                <x-field>
                  <input
                    type="text"
                    id="AddressCityNew"
                    name="address[city]"
                    value="{{ form.city }}"
                    autocomplete="address-level2"
                    placeholder="{{ 'customer.addresses.city' | t }}"
                  >
                  <label for="AddressCityNew">{{ 'customer.addresses.city' | t }}</label>
                </x-field>

                {% comment %}
                  === [ CORETEX FYI ] ===
                  Using the AC script to render the country and province selects.
                {% endcomment %}
                <country-province-selector>
                  <div data-country-container>
                    <label for="AddressCountryNew">{{ 'customer.addresses.country' | t }}</label>
                    <div>
                      <select
                        id="AddressCountryNew"
                        name="address[country]"
                        data-default="{{ form.country }}"
                        autocomplete="country"
                      >
                        {{ all_country_option_tags }}
                      </select>
                    </div>
                  </div>

                  <div data-province-container style="display: none">
                    <label for="AddressProvinceNew">{{ 'customer.addresses.province' | t }}</label>
                    <div class="select">
                      <select
                        id="AddressProvinceNew"
                        name="address[province]"
                        data-default="{{ form.province }}"
                        autocomplete="address-level1"
                      ></select>
                    </div>
                  </div>
                </country-province-selector>

                <x-field>
                  <input
                    type="text"
                    id="AddressZipNew"
                    name="address[zip]"
                    value="{{ form.zip }}"
                    autocapitalize="characters"
                    autocomplete="postal-code"
                    placeholder="{{ 'customer.addresses.zip' | t }}"
                  >
                  <label for="AddressZipNew">{{ 'customer.addresses.zip' | t }}</label>
                </x-field>

                <x-field>
                  <input
                    type="tel"
                    id="AddressPhoneNew"
                    name="address[phone]"
                    value="{{ form.phone }}"
                    autocomplete="tel"
                    placeholder="{{ 'customer.addresses.phone' | t }}"
                  >
                  <label for="AddressPhoneNew">{{ 'customer.addresses.phone' | t }}</label>
                </x-field>

                <div>
                    <label for="address_default_address_new" class="default_address_new">
                      {{ form.set_as_default_checkbox }}
                      <span>{{ 'customer.addresses.set_default' | t }}</span>
                    </label>
                </div>

                <div>
                  <button type="submit">{{ 'customer.addresses.add' | t }}</button>
                  <a href="#address-book" type="button">{{ 'customer.addresses.cancel' | t }}</a>
                </div>
              {%- endform -%}
            </div>

            {%- comment -%}
              Tab: Address book
            {%- endcomment -%}
            <h3 class="h3" id="address-book" tabindex="-1">{{ 'customer.addresses.title' | t }}</h3>
            <div id="addressBook">
              <ul class="no-style inside" role="list" x-flex direction="column">
                {%- for address in customer.addresses -%}
                  <li data-address>
                    {% comment %}
                      === [ CORETEX FYI ] ===
                      Card to display each address.
                    {% endcomment %}
                    <address-card x-flex direction="column">
                      {% comment %}
                        === [ CORETEX FYI ] ===
                        displays a default tag if the address is the default address.
                      {% endcomment %}
                      {%- if address == customer.default_address -%}
                        <x-cell>
                          <span>[ {{ 'customer.addresses.default' | t }} ]</span>
                        </x-cell>
                      {%- endif -%}

                      <x-cell>
                        {% comment %}
                          === [ CORETEX FYI ] ===
                          The address.
                        {% endcomment %}
                        {{ address | format_address }}
                      </x-cell>

                      <x-cell>
                        {% # Edit button %}
                        {% comment %}
                          === [ CORETEX FYI ] ===
                          When this link is clicked the form will be displayed. We use CSS :target to show/hide the form.
                        {% endcomment %}
                        <a href="#EditAddress-{{ address.id }}" type="button" class="button">
                          {{- 'customer.addresses.edit' | t -}}
                        </a>

                        {% # Delete button %}
                        <delete-address data-message="{{ 'customer.addresses.delete_confirm' | t }}">
                          <form
                            id="deleteForm-{{ address.id }}"
                            method="post"
                            action="{{ routes.account_addresses_url }}/{{ address.id }}"
                            style="display:inline;"
                          >
                            <input type="hidden" name="_method" value="delete">
                            <button type="submit">{{ 'customer.addresses.delete' | t }}</button>
                          </form>
                        </delete-address>
                      </x-cell>
                    </address-card>

                    {% comment %}
                      === [ CORETEX FYI ] ===
                      Form to edit each address.

                      This form should be hidden by default.
                      When the user clicks on the edit button, the form should be displayed.
                      Use some kind of JavaScript to toggle the display of the form.
                    {% endcomment %}
                    <address-form id="EditAddress-{{ address.id }}">
                      {%- form 'customer_address', address -%}
                        <x-field>
                          <input
                            type="text"
                            id="AddressFirstName_{{ form.id }}"
                            name="address[first_name]"
                            value="{{ form.first_name }}"
                            autocomplete="given-name"
                            placeholder="{{ 'customer.addresses.first_name' | t }}"
                          >
                          <label for="AddressFirstName_{{ form.id }}">{{ 'customer.addresses.first_name' | t }}</label>
                        </x-field>

                        <x-field>
                          <input
                            type="text"
                            id="AddressLastName_{{ form.id }}"
                            name="address[last_name]"
                            value="{{ form.last_name }}"
                            autocomplete="family-name"
                            placeholder="{{ 'customer.addresses.last_name' | t }}"
                          >
                          <label for="AddressLastName_{{ form.id }}">{{ 'customer.addresses.last_name' | t }}</label>
                        </x-field>

                        <x-field>
                          <input
                            type="text"
                            id="AddressCompany_{{ form.id }}"
                            name="address[company]"
                            value="{{ form.company }}"
                            autocomplete="organization"
                            placeholder="{{ 'customer.addresses.company' | t }}"
                          >
                          <label for="AddressCompany_{{ form.id }}">{{ 'customer.addresses.company' | t }}</label>
                        </x-field>

                        <x-field>
                          <input
                            type="text"
                            id="AddressAddress1_{{ form.id }}"
                            name="address[address1]"
                            value="{{ form.address1 }}"
                            autocomplete="address-line1"
                            placeholder="{{ 'customer.addresses.address1' | t }}"
                          >
                          <label for="AddressAddress1_{{ form.id }}">{{ 'customer.addresses.address1' | t }}</label>
                        </x-field>

                        <x-field>
                          <input
                            type="text"
                            id="AddressAddress2_{{ form.id }}"
                            name="address[address2]"
                            value="{{ form.address2 }}"
                            autocomplete="address-line2"
                            placeholder="{{ 'customer.addresses.address2' | t }}"
                          >
                          <label for="AddressAddress2_{{ form.id }}">{{ 'customer.addresses.address2' | t }}</label>
                        </x-field>

                        <x-field>
                          <input
                            type="text"
                            id="AddressCity_{{ form.id }}"
                            name="address[city]"
                            value="{{ form.city }}"
                            autocomplete="address-level2"
                            placeholder="{{ 'customer.addresses.city' | t }}"
                          >
                          <label for="AddressCity_{{ form.id }}">{{ 'customer.addresses.city' | t }}</label>
                        </x-field>

                        {% comment %}
                          === [ CORETEX FYI ] ===
                          Using the AC script to render the country and province selects.
                        {% endcomment %}
                        <country-province-selector>
                          <div>
                            <label for="AddressCountry_{{ form.id }}">
                              {{ 'customer.addresses.country' | t }}
                            </label>
                            <div class="select">
                              <select
                                id="AddressCountry_{{ form.id }}"
                                name="address[country]"
                                data-default="{{ form.country }}"
                                data-form-id="{{ form.id }}"
                                autocomplete="country"
                              >
                                {{ all_country_option_tags }}
                              </select>
                            </div>
                          </div>
                          <div data-province-container id="AddressProvinceContainer_{{ form.id }}">
                            <label for="AddressProvince_{{ form.id }}">{{ 'customer.addresses.province' | t }}</label>
                            <div class="select">
                              <select
                                id="AddressProvince_{{ form.id }}"
                                name="address[province]"
                                data-default="{{ form.province }}"
                                autocomplete="address-level1"
                              ></select>
                            </div>
                          </div>
                        </country-province-selector>

                        <x-field>
                          <input
                            type="text"
                            id="AddressZip_{{ form.id }}"
                            name="address[zip]"
                            value="{{ form.zip }}"
                            autocapitalize="characters"
                            autocomplete="postal-code"
                            placeholder="{{ 'customer.addresses.zip' | t }}"
                          >
                          <label for="AddressZip_{{ form.id }}">{{ 'customer.addresses.zip' | t }}</label>
                        </x-field>

                        <x-field>
                          <input
                            type="tel"
                            id="AddressPhone_{{ form.id }}"
                            name="address[phone]"
                            value="{{ form.phone }}"
                            autocomplete="tel"
                            placeholder="{{ 'customer.addresses.phone' | t }}"
                          >
                          <label for="AddressPhone_{{ form.id }}">{{ 'customer.addresses.phone' | t }}</label>
                        </x-field>

                        {%- # Input to set the address as default -%}
                        <div>
                          <label for="address_default_address_{{ form.id }}" class="default_address_new">
                            {{ form.set_as_default_checkbox }}
                            <span>{{ 'customer.addresses.set_default' | t }}</span>
                          </label>
                        </div>

                        {%- # Submit and cancel buttons -%}
                        <div class="action">
                          <button type="submit">{{ 'customer.addresses.update' | t }}</button>
                          <a href="#address-book" type="button" class="button">
                            {{- 'customer.addresses.cancel' | t -}}
                          </a>
                        </div>
                      {%- endform -%}
                    </address-form>
                  </li>
                {%- endfor -%}
              </ul>
            </div>
          </coretex-address>
        </div>

        {%- comment -%}
          Render the pagination component
        {%- endcomment -%}
        {%- render 'c-pagination', paginate: paginate -%}
      {%- endpaginate -%}
    </component-loader>
  </coretex-fetch>
</section>

{%- comment -%}
  === [ CORETEX FYI ] ===

  JavaScript to confirm the deletion of an address. used in the delete button.
{%- endcomment -%}
<script>
  class DeleteAddress extends HTMLElement {
    constructor() {
      super();
    }

    connectedCallback() {
      const confirm_msg = this.getAttribute('data-message');
      const form = this.querySelector('form');

      form.addEventListener('submit', (e) => {
        e.preventDefault();
        if (!confirm_msg) return;
        const is_confirmed = confirm(confirm_msg);
        if (is_confirmed) form.submit();
      });
    }
  }

  customElements.define('delete-address', DeleteAddress);
</script>

<script>
  window.addEventListener('load', () => {
    typeof CustomerAddresses !== 'undefined' && new CustomerAddresses();
  });
</script>

{% schema %}
{
  "name": "Main addresses",
  "settings": []
}
{% endschema %}

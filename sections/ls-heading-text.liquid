{%- render 'inc-stylesheet', src: 's-sections.css' -%}

{%- capture style -%}
padding-block: {{ section.settings.paddingTop | prepend: 'var(--space-' | append: ')' }} {{ section.settings.paddingBottom | prepend: 'var(--space-' | append: ')' }};
margin-block: {{ section.settings.marginTop | prepend: 'var(--space-' | append: ')' }} {{ section.settings.marginBottom | prepend: 'var(--space-' | append: ')' }};
{% if section.settings.paddingInline %}padding-inline: var(--layoutInline);{% endif %}
{%- endcapture -%}

<section x-flex direction="{{ section.settings.direction }}" direction-s="column" wrap="wrap"
    class="featured-text heading-text"
    style="{{- style | strip_newlines | strip -}}"
    {% unless section.settings.global_color_scheme %}color-scheme="{{ section.settings.color_scheme }}"{% endunless %}
    data-section-id="{{ section.id }}"
>

    {%- for block in section.blocks -%}
        {%- if block.type == 'text' -%}
            {%- capture block_style -%}
                {{- block.settings.fontSize | prepend: '--_fontSize: var(--type-' | append: ');' -}} 
                {{- block.settings.fontSizeMob | prepend: '--_fontSizeMob: var(--type-' | append: ');' -}}
                {{- block.settings.textIndent | prepend: '--_textIndent: var(--space-' | append: ');' -}}
                {{- block.settings.fontFamily | prepend: '--_fontFamily: var(--' | append: ');' -}}
                {{- block.settings.alignment | replace: 'left', 'start' | replace: 'right', 'end' | prepend: '--_textAlign:' | append: ';' -}}
                {{- block.settings.letterSpacing | divided_by: 100.0 | prepend: '--_hSpace:' | append: 'em;' -}}
                {{- block.settings.lineHeight | prepend: '--_hLine:' | append: 'em;' -}}
                {% if block.settings.enableCharWidth %}{{- block.settings.charWidth | prepend: '--_charWidth:' | append: 'ch;' -}}{% endif %}
                --_marginBlock: {{- block.settings.marginTop | prepend: 'var(--space-' | append: ')' }} {{ block.settings.marginBottom | prepend: 'var(--space-' | append: ')' }};
            {%- endcapture -%}

            <x-flex class="fullwidth"
                direction="{{ block.settings.direction }}" 
                direction-s="column"
			    ai="{{ block.settings.alignmentAI }}" ai-s="start"
			    jc="{{ block.settings.alignmentJC }}" jc-s="start"
            >
                <h2 class="content text-normal rte">{{ block.settings.heading }}</h2>

                <div class="content rte" as="{{- block.settings.alignment | replace: 'left', 'start' | replace: 'right', 'end' -}}" style="{{ block_style | strip_newlines | strip }}" {{ block.shopify_attributes }}>
                    {{ block.settings.text | replace: '\n', '<br/>' }}
                </div>
            </x-flex>
        {%- endif -%}
    {%- endfor -%}

</section>

{% schema %}
{
  "name": "Hero heading paragraph",
  "disabled_on": { "groups": [ "header", "aside" ] },
  "presets": [
    {
      "name": "Hero heading paragraph",
      "category": "Content",
      "blocks": [
        { "type": "text" },
        { "type": "text" }
      ]
    }
  ],
  "settings": [
    {
        "type": "select",
        "id": "direction",
        "label": "Content layout direction - desktop",
        "default": "column",
        "options": [
            { "value": "row", "label": "Row" },
            { "value": "column", "label": "Stacked" }
        ]
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
        "type": "checkbox",
        "id": "paddingInline",
        "label": "Enable lateral padding",
        "default": true
    },
    {
      "type": "range",
      "id": "marginTop",
      "label": "Margin top",
      "min": 0,
      "max": 30,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "marginBottom",
      "label": "Margin bottom",
      "min": 0,
      "max": 30,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "paddingTop",
      "label": "Padding top",
      "min": 0,
      "max": 30,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "paddingBottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 30,
      "step": 1,
      "default": 3
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
        "type": "checkbox",
        "id": "global_color_scheme",
        "label": "Use global color scheme",
        "default": true
    },
    {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "Color scheme",
        "default": "coretex-1",
        "visible_if": "{{ section.settings.global_color_scheme == false }}"
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
            "type": "text",
            "id": "heading",
            "label": "Heading",
            "default": "Heading"
        },
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Text",
          "default": "This text can be used to make announcements, describe products, greet customers, or inform them about your brand."
        },
        {
            "type": "select",
            "id": "fontFamily",
            "label": "Font",
            "default": "fontFamily",
            "options": [
                { "value": "fontFamily", "label": "Body" },
                { "value": "hFontFamily", "label": "Headings" }
            ]
        },
        {
            "type": "text_alignment",
            "id": "alignment",
            "label": "Text alignment",
            "default": "left"
        },
        {
            "type": "range",
            "id": "fontSize",
            "label": "Text size - desktop",
            "min": 1,
            "max": 30,
            "step": 1,
            "default": 8
        },
        {
            "type": "range",
            "id": "fontSizeMob",
            "label": "Text size - mobile",
            "min": 1,
            "max": 30,
            "step": 1,
            "default": 4
        },
        {
            "type": "range",
            "label": "Letter spacing",
            "id": "letterSpacing",
            "min": -50,
            "max": 200,
            "step": 5,
            "default": 0,
            "info": "Automatically optimized for mobile."
        },
        {
            "type": "range",
            "label": "Line height",
            "id": "lineHeight",
            "min": 0.8,
            "max": 2,
            "step": 0.1,
            "default": 0.8,
            "info": "Automatically optimized for mobile."
        },
        {
            "type": "range",
            "id": "textIndent",
            "label": "Text indent",
            "min": 0,
            "max": 30,
            "step": 1,
            "default": 0
        },
        {
            "type": "checkbox",
            "id": "enableCharWidth",
            "label": "Enable text lenght",
            "default": false,
            "info": "Automatically optimized for mobile."
        },
        {
            "type": "range",
            "label": "Text lenght",
            "id": "charWidth",
            "min": 10,
            "max": 100,
            "step": 1,
            "unit": "ch",
            "default": 62,
            "visible_if": "{{ block.settings.enableCharWidth }}"
        },
        {
            "type": "header",
            "content": "Block spacing"
        },
        {
            "type": "select",
            "id": "direction",
            "label": "Layout direction - desktop",
            "default": "row",
            "options": [
                { "value": "row", "label": "Row" },
                { "value": "column", "label": "Stacked" }
            ]
        },
        {
            "type": "select",
            "id": "alignmentAI",
            "label": "Vertical alignment - desktop",
            "default": "start",
            "options": [
                { "value": "start", "label": "Top" },
                { "value": "center", "label": "Center" },
                { "value": "end", "label": "Bottom" }
            ]
        },
        {
            "type": "select",
            "id": "alignmentJC",
            "label": "Horizontal alignment - desktop",
            "default": "between",
            "options": [
                { "value": "start", "label": "Left" },
                { "value": "center", "label": "Center" },
                { "value": "end", "label": "Right" },
                { "value": "between", "label": "Space between" },
                { "value": "around", "label": "Space around" }
            ]
        },
        {
            "type": "range",
            "id": "marginTop",
            "label": "Margin top",
            "min": 0,
            "max": 30,
            "step": 1,
            "default": 0
        },
        {
            "type": "range",
            "id": "marginBottom",
            "label": "Margin bottom",
            "min": 0,
            "max": 30,
            "step": 1,
            "default": 0
        }
      ]
    }
  ]
}
{% endschema %}
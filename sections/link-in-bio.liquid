{%- comment -%}
  ============================================================================
  sections/link-in-bio.liquid
  ----------------------------------------------------------------------------
  Linkpop-stil "link-in-bio" sekcija. Renderuje se na goloj /pages/links
  stranici (layout 'links'). Sve je uredivo iz Theme Editora:
    - logo/avatar + veličina + oblik
    - naslov / podnaslov
    - boje (pozadina, dugme, tekst dugmeta, naslov)
    - GLOBALNI izgled dugmadi (ivice, sličice, poravnanje) — važi za sva dugmad
    - BLOKOVI = dugmad (tipovi: "link" i "whatsapp_chat")

  Bez eksternog JS-a i third-party skripti. Sav CSS je self-contained ispod.

  >>> KAKO DODATI NOVI TIP DUGMETA: traži oznaku [NOVI TIP] (2 mesta:
      1) u RENDER petlji niže,  2) u "blocks" nizu unutar {% schema %}).
  ============================================================================
{%- endcomment -%}

{%- liquid
  # --- Mapiranje globalnih podešavanja na konkretne CSS vrednosti ---

  # Stil ivica dugmeta -> border-radius
  case section.settings.button_radius
    when 'pill'
      assign radius_value = '999px'
    when 'rounded'
      assign radius_value = '16px'
    when 'soft'
      assign radius_value = '8px'
    else
      # 'sharp' = oštri uglovi
      assign radius_value = '0px'
  endcase

  # Oblik loga -> border-radius
  case section.settings.logo_shape
    when 'circle'
      assign logo_radius = '50%'
    when 'rounded'
      assign logo_radius = '20%'
    else
      # 'square'
      assign logo_radius = '0'
  endcase

  assign logo_alt = section.settings.title | default: shop.name
-%}

{%- comment -%} ======================= STILOVI (self-contained) ======================= {%- endcomment -%}
<style>
  /* CSS varijable iz Theme Editora — promeni jedno mesto, primeni svuda.
     Definisane na :root jer ova sekcija živi sama na goloj stranici. */
  :root {
    --lib-bg:        {{ section.settings.background_color }};
    --lib-btn-bg:    {{ section.settings.button_color }};
    --lib-btn-fg:    {{ section.settings.button_text_color }};
    --lib-title:     {{ section.settings.title_color }};
    --lib-radius:    {{ radius_value }};
    --lib-logo-size: {{ section.settings.logo_size }}px;
    --lib-logo-radius: {{ logo_radius }};
  }

  *, *::before, *::after { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; }

  /* Sakrij Shopify language/currency switcher koji se ubacuje kroz content_for_header */
  #shopify-pc-banner,
  .shopify-features__geo-banner,
  localization-form,
  .localization-form,
  [id*="localization"],
  [class*="localization"],
  .disclosure { display: none !important; }

  body {
    background: var(--lib-bg);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  /* Pozadinski sloj — popunjava ceo ekran, sadržaj poravnat na vrh (kao Linkpop).
     Padding poštuje "safe area" IG in-app browsera (zarez/donja traka). */
  .lib-page {
    min-height: 100vh;
    min-height: 100dvh;
    background: var(--lib-bg);
    display: flex;
    flex-direction: column;
    align-items: center;
    padding:
      calc(48px + env(safe-area-inset-top, 0px))
      16px
      calc(40px + env(safe-area-inset-bottom, 0px));
  }

  /* Centralni kontejner ~480px */
  .lib-card {
    width: 100%;
    max-width: 480px;
    margin: 0 auto;
  }

  /* --- Zaglavlje: logo + naslov + podnaslov --- */
  .lib-header { text-align: center; margin-bottom: 24px; }

  .lib-logo {
    display: block;
    width: var(--lib-logo-size);
    height: var(--lib-logo-size);
    margin: 0 auto 12px;
    border-radius: var(--lib-logo-radius);
    object-fit: contain;
    mix-blend-mode: multiply;
  }

  .lib-title {
    margin: 0 0 4px;
    color: var(--lib-title);
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .lib-subtitle {
    margin: 0;
    color: var(--lib-title);
    opacity: 0.7;
    font-size: 0.9rem;
    line-height: 1.4;
  }

  /* --- Lista dugmadi --- */
  .lib-links { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 12px; }

  /* Jedno dugme = <a>. Puna širina kontejnera, dovoljno visoko za prst (>=56px). */
  .lib-button {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    min-height: 56px;
    padding: 12px 16px;
    border-radius: var(--lib-radius);
    background: var(--lib-btn-bg);
    color: var(--lib-btn-fg);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.3;
    transition: transform 0.06s ease, filter 0.15s ease;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;   /* uklanja 300ms delay na tap */
  }
  .lib-button:active { transform: scale(0.99); filter: brightness(0.95); }
  .lib-button:focus-visible { outline: 2px solid currentColor; outline-offset: 2px; }

  /* Sličica levo */
  .lib-button__thumb {
    flex: 0 0 auto;
    width: 32px; height: 32px;
    border-radius: 6px;
    object-fit: cover;
  }
  .lib-button__label { display: block; }

  /* GLOBALNO poravnanje: levo */
  .lib--align-left .lib-button       { justify-content: flex-start; }
  .lib--align-left .lib-button__label { text-align: left; flex: 1; }

  /* GLOBALNO poravnanje: centar — tekst centriran preko cele širine,
     a sličica "zakucana" levo (apsolutno) da ne pomera centar. */
  .lib--align-center .lib-button       { justify-content: center; }
  .lib--align-center .lib-button__label { text-align: center; }
  .lib--align-center .lib-button__thumb {
    position: absolute;
    left: 16px; top: 50%;
    transform: translateY(-50%);
  }
  /* Rezerviši prostor sa obe strane da dug tekst ne ulazi pod sličicu (i ostane centriran). */
  .lib--align-center.lib--thumbs-show .lib-button__label { padding: 0 36px; }

  /* GLOBALNO sakrivanje sličica */
  .lib--thumbs-hide .lib-button__thumb { display: none; }
</style>

{%- comment -%} ======================= RENDER ======================= {%- endcomment -%}
<div class="lib-page">
  <main class="lib-card lib--align-{{ section.settings.text_align }} lib--thumbs-{{ section.settings.show_thumbnail }}">

    {%- comment -%} --- Zaglavlje (renderuje se samo ako postoji bar jedan element) --- {%- endcomment -%}
    {%- if section.settings.logo != blank or section.settings.title != blank or section.settings.subtitle != blank -%}
      <header class="lib-header">
        {%- if section.settings.logo != blank -%}
          {{
            section.settings.logo
            | image_url: width: 360
            | image_tag:
                class: 'lib-logo',
                alt: logo_alt,
                loading: 'eager',
                fetchpriority: 'high',
                width: section.settings.logo_size,
                height: section.settings.logo_size
          }}
        {%- endif -%}

        {%- if section.settings.title != blank -%}
          <h1 class="lib-title">{{ section.settings.title | escape }}</h1>
        {%- endif -%}

        {%- if section.settings.subtitle != blank -%}
          <p class="lib-subtitle">{{ section.settings.subtitle | escape }}</p>
        {%- endif -%}
      </header>
    {%- endif -%}

    {%- comment -%} --- Dugmad (blokovi, redom kako su poređani u editoru) --- {%- endcomment -%}
    {%- if section.blocks.size > 0 -%}
      <nav aria-label="{{ section.settings.title | default: shop.name | escape }}">
        <ul class="lib-links">
          {%- for block in section.blocks -%}
            {%- liquid
              # Svaki tip bloka izračuna 'href'. Ako href ostane prazan, dugme se preskače.
              assign href = ''
              assign label = block.settings.label

              case block.type
                when 'link'
                  assign href = block.settings.url

                when 'whatsapp_chat'
                  # Broj očistimo defanzivno (skinemo +, razmake, crtice, zagrade).
                  assign wa_phone = block.settings.phone | remove: '+' | remove: ' ' | remove: '-' | remove: '(' | remove: ')' | strip
                  if wa_phone != blank
                    assign href = 'https://wa.me/' | append: wa_phone
                    if block.settings.prefill_message != blank
                      assign wa_msg = block.settings.prefill_message | url_encode
                      assign href = href | append: '?text=' | append: wa_msg
                    endif
                  endif
                  assign label = block.settings.label | default: 'Pošalji poruku'

                # [NOVI TIP] Dodaj novi 'when' ovde, izračunaj 'href' (i 'label').
                #   when 'email'
                #     assign href = 'mailto:' | append: block.settings.email
              endcase
            -%}

            {%- if href != blank -%}
              <li {{ block.shopify_attributes }}>
                <a class="lib-button" href="{{ href }}" rel="noopener">
                  {%- comment -%} Sličica se renderuje samo ako je globalno uključena I blok ima sliku. {%- endcomment -%}
                  {%- if section.settings.show_thumbnail == 'show' and block.settings.thumbnail != blank -%}
                    {{
                      block.settings.thumbnail
                      | image_url: width: 96
                      | image_tag:
                          class: 'lib-button__thumb',
                          alt: '',
                          loading: 'lazy',
                          width: 32,
                          height: 32
                    }}
                  {%- endif -%}
                  <span class="lib-button__label">{{ label | escape }}</span>
                </a>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}

  </main>
</div>

{%- comment -%} ======================= SCHEMA ======================= {%- endcomment -%}
{% schema %}
{
  "name": "Link in Bio",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Logo / Avatar" },
    { "type": "image_picker", "id": "logo", "label": "Logo ili avatar" },
    {
      "type": "range", "id": "logo_size", "label": "Veličina loga",
      "min": 48, "max": 160, "step": 4, "unit": "px", "default": 96
    },
    {
      "type": "select", "id": "logo_shape", "label": "Oblik loga", "default": "circle",
      "options": [
        { "value": "circle",  "label": "Krug" },
        { "value": "rounded", "label": "Zaobljeni kvadrat" },
        { "value": "square",  "label": "Kvadrat" }
      ]
    },

    { "type": "header", "content": "Tekst" },
    { "type": "text", "id": "title",    "label": "Naslov",    "default": "Ime brenda" },
    { "type": "text", "id": "subtitle", "label": "Podnaslov", "default": "Kratak opis ili slogan" },

    { "type": "header", "content": "Boje" },
    { "type": "color", "id": "background_color",  "label": "Pozadina",           "default": "#ffffff" },
    { "type": "color", "id": "button_color",      "label": "Dugme",              "default": "#111111" },
    { "type": "color", "id": "button_text_color", "label": "Tekst dugmeta",      "default": "#ffffff" },
    { "type": "color", "id": "title_color",       "label": "Naslov i podnaslov", "default": "#111111" },

    { "type": "header", "content": "Globalni izgled dugmadi" },
    {
      "type": "select", "id": "button_radius", "label": "Stil ivica dugmeta", "default": "pill",
      "options": [
        { "value": "rounded", "label": "Zaobljeno" },
        { "value": "soft",    "label": "Blago zaobljeno" },
        { "value": "sharp",   "label": "Oštri uglovi" },
        { "value": "pill",    "label": "Pill (potpuno zaobljeno)" }
      ]
    },
    {
      "type": "select", "id": "show_thumbnail", "label": "Prikaz sličice", "default": "show",
      "options": [
        { "value": "show", "label": "Prikaži sličicu levo" },
        { "value": "hide", "label": "Sakrij sličice" }
      ]
    },
    {
      "type": "select", "id": "text_align", "label": "Poravnanje teksta dugmeta", "default": "center",
      "options": [
        { "value": "left",   "label": "Levo" },
        { "value": "center", "label": "Centar" }
      ]
    }
  ],

  "blocks": [
    {
      "type": "link",
      "name": "Link",
      "settings": [
        { "type": "image_picker", "id": "thumbnail", "label": "Sličica (opciono)" },
        { "type": "text", "id": "label", "label": "Naziv dugmeta", "default": "Novi link" },
        { "type": "url",  "id": "url",   "label": "URL" }
      ]
    },
    {
      "type": "whatsapp_chat",
      "name": "WhatsApp poruka",
      "settings": [
        { "type": "image_picker", "id": "thumbnail", "label": "Sličica (opciono)" },
        { "type": "text", "id": "label", "label": "Naziv dugmeta", "default": "Pošalji poruku" },
        {
          "type": "text", "id": "phone",
          "label": "Broj telefona",
          "info": "Međunarodni format, BEZ + i razmaka. Primer: 38161234567"
        },
        {
          "type": "text", "id": "prefill_message",
          "label": "Unapred popunjena poruka (opciono)",
          "info": "Tekst koji se automatski upiše u WhatsApp."
        }
      ]
    }
  ],

  "presets": [
    {
      "name": "Link in Bio",
      "blocks": [
        { "type": "link", "settings": { "label": "Prodavnica", "url": "/collections/all" } },
        { "type": "link", "settings": { "label": "Instagram" } },
        { "type": "whatsapp_chat", "settings": { "label": "Pošalji poruku" } }
      ]
    }
  ]
}
{% endschema %}

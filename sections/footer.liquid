{%- liquid
  # Debug check
  assign debuger = false
  if request.design_mode and section.settings.debug
    assign debuger = true
  endif

  # skelet .debug
  capture debug
    if debuger
      echo 'debug outline' | prepend: ' '
    endif
  endcapture

  # x-grid columns
  assign columns = 8
-%}

{%- capture style -%}
padding-block: {{ section.settings.paddingTop | prepend: 'var(--space-' | append: ')' }} {{ section.settings.paddingBottom | prepend: 'var(--space-' | append: ');' }}
margin-block: {{ section.settings.marginTop | prepend: 'var(--space-' | append: ')' }} {{ section.settings.marginBottom | prepend: 'var(--space-' | append: ');' }}
{%- endcapture -%}

<section id="primaryFooter" 
    style="{{ style }}"
    {% unless section.settings.global_color_scheme %}color-scheme="{{ section.settings.color_scheme }}"{% endunless %}
    data-section-id="{{ section.id }}"
>

  <x-grid columns="{{ columns }}" class="{{ debug }}">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'image' -%}
          <section x-flex jc="{{ block.settings.alignment | replace: 'left', 'start' | replace: 'right', 'end' }}" ai="center"
            class="image"
            style="{{ block.settings.imageSize | prepend: '--imageSize:' | append: 'px' }}"
            span="{{ block.settings.span }}"
            span-s="{{ block.settings.spanMobile }}"
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.url != blank -%}<a href="{{ block.settings.url }}">{% endif -%}
            {%- render 'inc-img', img: block.settings.image, width: 768, widths: '100,180,360,480,640,768', mediaLoader: true, fallback: true, class: 'noRadius' -%}
            {%- if block.settings.url != blank -%}</a>{% endif -%}
          </section>

        {%- when 'text' -%}
          <section
            class="text text-{{ block.settings.alignment | replace: 'left', 'start' | replace: 'right', 'end' }}"
            span="{{ block.settings.span }}"
            span-s="{{ block.settings.spanMobile }}"
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.heading != empty -%}
              <h3 class="labelTitle">{{ block.settings.heading }}</h3>
            {%- endif -%}
            <div class="rte meta">
              {{ block.settings.motto | replace: '\n', '<br/>' }}
            </div>
          </section>

        {%- when 'payments' -%}
          <section
            class="payments"
            span="{{ block.settings.span }}"
            span-s="{{  block.settings.spanMobile }}"
            {{ block.shopify_attributes }}
          >
            <x-cell
              class="paymentMethods text-{{ block.settings.alignment | replace: 'left', 'start' | replace: 'right', 'end' }}"
              style="{{ block.settings.alignment | replace: 'left', 'start' | replace: 'right', 'end' | prepend: '--paymentJustify:' | append: ';' }}"
            >
              {%- if block.settings.heading != empty -%}
                <h3 class="labelTitle">{{ block.settings.heading }}</h3>
              {% endif %}

              <div class="payment-icons meta" style="{%- if settings.cart_icons_grey -%}filter:grayscale(1){%- endif -%}">
                {%- render 'inc-payment-icons' -%}
              </div>
            </x-cell>

            {%- if shop.features.follow_on_shop? and block.settings.enable_follow_on_shop -%}
                <x-cell class="follow-on-shop center">{{- shop | login_button: action: 'follow' -}}</x-cell>
            {%- endif -%}
          </section>

        {%- when 'menu' -%}
          <section class="menu" span="{{ block.settings.span }}" span-s="8" x-subgrid {{ block.shopify_attributes }}>
            {%- liquid
              assign linklist = block.settings.menu
              assign hasSublinks = false

              for link in linklists[linklist].links
                if link.links.size > 0
                  assign hasSublinks = true
                  break
                endif
              endfor
            -%}

            {%- if hasSublinks -%}
              <ul class="no-style inside{{ debug }}" span="{{ columns }}" x-subgrid>
                {%- for link in linklists[linklist].links -%}
                  {%- if link.links.size > 0 -%}
                    <li span="{{ block.settings.spanCell }}" span-s="{{ block.settings.spanCellMobile }}">
                      <h3 class="labelTitle">{{ link.title }}</h3>
                      <ul class="no-style inside" x-flex direction="column">
                        {%- for sublink in link.links -%}
                          <li>
                            <a href="{{ sublink.url }}">{{ sublink.title }}</a>
                          </li>
                        {%- endfor -%}
                      </ul>
                    </li>
                  {%- else -%}
                    <li span="{{ block.settings.spanCell }}" span-s="{{ block.settings.spanCellMobile }}">
                      <a href="{{ link.url }}">{{ link.title }}</a>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            {%- else -%}
              <ul
                class="no-style inside"
                span="{{ columns }}"
                x-flex
                wrap
                direction="row"
                jc="{{ block.settings.alignment | replace: 'left', 'start' | replace: 'right', 'end' }}"
              >
                {%- for link in linklists[linklist].links -%}
                  <li>
                    <a href="{{ link.url }}">{{ link.title }}</a>
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </section>

        {%- when 'socials' -%}
          <section
            class="social"
            span="{{ block.settings.span }}"
            span-s="{{ block.settings.spanMobile }}"
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.heading != empty -%}
                <h3 class="labelTitle {{ block.settings.alignment | replace: 'left', 'start' | replace: 'right', 'end' | prepend: 'text-' }}">
                    {{ block.settings.heading }}
                </h3>
            {% endif %}
            <div class="meta">
              {%- assign attribute = block.settings.alignment
                | replace: 'left', 'start'
                | replace: 'right', 'end'
                | prepend: 'x-flex direction=row wrap=wrap ai=center jc='
              -%}
              {%- render 'inc-socials',
                location: 'footer',
                attribute: attribute,
                type: block.settings.type,
                button: 'false'
              -%}
            </div>
          </section>

        {%- when 'newsletter' -%}
          <section
            class="newsletter"
            span="{{ block.settings.span }}"
            span-s="{{ block.settings.spanMobile }}"
            {{ block.shopify_attributes }}
          >
            {%- liquid
                if block.settings.buttonStyle == 'text'
                    assign style = 'is-custom'
                endif

                # when contentDirection is column
                if block.settings.contentDirection == 'column'
                    assign aiDirection = block.settings.alignment | replace: 'left', 'start' | replace: 'right', 'end'
                else
                    assign aiDirection = 'center'
                endif
            -%}
            <x-flex 
                direction="{{ block.settings.contentDirection }}" 
                jc="{{ block.settings.alignment | replace: 'left', 'start' | replace: 'right', 'end' }}" 
                ai="{{ aiDirection }}"
            >
            {%- if block.settings.heading != empty -%}<h3 class="labelTitle">{{ block.settings.heading }}</h3>{% endif %}
            {%- if block.settings.message != empty -%}<div class="rte meta {{ block.settings.alignment | replace: 'left', 'start' | replace: 'right', 'end' | prepend: 'text-' }}"><p>{{ block.settings.message }}</p></div>{%- endif -%}
              <button data-open="#newsletterBox" class="{{ style }} has-icon">
                <span>{{ block.settings.label | escape }}</span>
                {%- render 'inc-icon', icon: 'arrow-right' -%}
              </button>
            </x-flex>
          </section>

          {%- when 'selectors' -%}
            <section
                class="i18n-selectors" 
                span="{{ block.settings.span }}"
                span-s="{{ block.settings.spanMobile }}"
                {{ block.shopify_attributes }}
              >
                <x-flex 
                    direction="{{ block.settings.contentDirection }}" 
                    wrap="wrap" jc="{{ block.settings.alignment | replace: 'left', 'start' | replace: 'right', 'end' }}" 
                    {%- liquid
                        # Fix for flexboxs alignment nonsense.

                        if block.settings.contentDirection == 'column' 
                            echo block.settings.alignment | replace: 'left', 'start' | replace: 'right', 'end' | prepend: 'ai='
                        else
                            echo 'ai=center'
                        endif
                    -%}
                >
                    {% # Country/region selector %}
                    {%- if block.settings.show_country and localization.available_countries.size > 1  -%}
                        <x-cell>
                            {%- if block.settings.show_heading -%}<h3 class="labelTitle">{{ 'localization.country_label' | t }}</h3>{%- endif -%}
                            {%- render 'global-localization', component: 'button', type: 'country', icons: false -%}
                        </x-cell>
                    {%- endif -%}

                    {% # Language selector %}
                    {%- if block.settings.show_language and localization.available_languages.size > 1 -%}
                        <x-cell>
                            {%- if block.settings.show_heading -%}<h3 class="labelTitle">{{ 'localization.language_label' | t }}</h3>{%- endif -%}
                            {%- render 'global-localization', component: 'button', type: 'language', icons: false -%}
                        </x-cell>
                    {%- endif -%}
                </x-flex>
              </section>
      {%- endcase -%}
    {%- endfor -%}
  </x-grid>
</section>


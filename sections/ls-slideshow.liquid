{% liquid
    # Liquid options
    assign moreThanOne = true
    if section.blocks.size == 1
        assign moreThanOne = false
    endif

    # Slide options
    capture slideshowOptions
        # fade effect
        if section.settings.slideshow_type == 'fade'
            echo 'fade ' 
        endif

        # auto height
        if section.settings.height_desktop == 'auto' and section.settings.height_mobile == 'auto'
            echo 'auto-height="all" '
        elsif section.settings.height_mobile == 'auto'
            echo 'auto-height="mobile" '
        elsif section.settings.height_desktop == 'auto'
            echo 'auto-height="desktop" '
        endif

        # auto play
        if section.settings.slideshow_autoplay == true
            echo 'autoplay '
            echo section.settings.slideshow_delay | times: 1000 | prepend: "delay='" | append: "' "
        endif
    endcapture

    # Slide styles
    capture slideshowStyles
        echo section.settings.height_desktop | prepend: "--heightDesktop:" | append: ";"
        echo section.settings.height_mobile | prepend: "--heightMobile:" | append: ";"
    endcapture
%}

{%- render 'inc-stylesheet', src: 'c-slideshow.css' -%}

{%- if request.design_mode -%}<component-loader>{%- endif -%} 
<coretex-slideshow {{ slideshowOptions }} style="{{ slideshowStyles }}" data-section-id="{{ section.id }}">
    <div {% if moreThanOne == true %}slideshow-viewport{% endif %}>
        <ul x-flex slideshow-container class="no-style" role="region" aria-roledescription="carousel" aria-label="{{ 'sections.slideshow.carousel' | t }}">
            {%- assign count = 0 -%}
            {%- for block in section.blocks -%}
                {%- assign count = count | plus: 1-%}
                {%- liquid
                    # Optimize first slide in first section
                    assign fetchpriority = nil
                    assign preload = false
                    assign loading = 'lazy'

                    if section.index == 1 and count == 1
                        assign fetchpriority = 'high'
                        assign preload = true
                        assign loading = 'eager'
                    endif
                -%}
                <li slideshow-slide="{{ count }}" style="--slideMetaHBg:{{ block.settings.slideMetaHBg }};--slideMetaHColor:{{ block.settings.slideMetaHColor }}" {{ block.shopify_attributes }}>

                    <div>
                        {% if block.settings.cta and block.settings.url != empty %}<a href="{{ block.settings.url }}" class="no-style" {% if block.settings.urlTarget %}target="_blank"{% endif %}>{% endif %}

                            {%-
                                render 'inc-img'
                                    dynamic: true,
                                    img:  block.settings.image,
                                    imgMob: block.settings.imageMob,
                                    widths: '480,640,768,1024,1280,1536,1920,2560',
                                    mediaLoader: true,
                                    fetchpriority: fetchpriority,
                                    preload: preload,
                                    loading: loading,
                                    fallback: true, svg: 'lifestyle-2'
                            -%}

                        {% if block.settings.cta and block.settings.url != empty %}</a>{% endif %}
                    </div>

                    <div class="meta" style="{{ block.settings.contentPosition }} text-align:{{ block.settings.contentAlign }};">
                        {% if block.settings.heading != empty %}<h2 class="h4">{{ block.settings.heading }}</h2>{% endif %}
                        {% if block.settings.subheading != empty %}<h3 class="h6 text-normal">{{ block.settings.subheading }}</h3>{% endif %}
                        {% if block.settings.desc != empty %}<p>{{ block.settings.desc | replace: '\n', '<br/>' }}</p>{% endif %}
                        {% if block.settings.cta != empty %}
                        <a href="{{ block.settings.url }}" class="button" {% if block.settings.urlTarget %}target="_blank"{% endif %}>{{ block.settings.cta }}</a>
                        {% endif %}
                    </div>
                </li>
            {% endfor %}
        </ul>
    </div>

    {%- if moreThanOne == true and section.settings.show_navigation == true or section.settings.pagination_type != 'nil' -%}
    <slider-controls>
        <x-flex direction="row" jc="start" ai="center" class="paginationNav">
            {%- if section.settings.pagination_type == 'numbers' -%}
                <x-cell order="1">
                    <div control-numbers>1 / 1</div>
                </x-cell>
            {% elsif section.settings.pagination_type == 'dots' -%}
                <x-cell order="1">
                    <div control-dots>
                        <button class="control-dot is-selected" type="button" tabindex="0" disabled></button>
                    </div>
                </x-cell>
            {%- endif -%}

            {%- if section.settings.show_navigation -%}
                <x-cell order="2">
                    <button control-prev class="is-blank has-icon" type="button" tabindex="0" aria-label="{{ 'sections.slideshow.previous_slideshow' | t }}">
                        {%- render 'inc-icon', icon: 'arrow-left' -%}
                    </button>
                </x-cell>
                <x-cell order="3">
                    <button control-next class="is-blank has-icon" type="button" tabindex="0" aria-label="{{ 'sections.slideshow.next_slideshow' | t }}">
                        {%- render 'inc-icon', icon: 'arrow-right' -%}
                    </button>
                </x-cell>
            {%- endif -%}
        </x-flex>
    </slider-controls>
    {% endif %}
</coretex-slideshow>
{%- if request.design_mode -%}</component-loader>{%- endif -%}

{% schema %}
{
  "name": "Slideshow",
  "class": "slideshow",
  "max_blocks": 5,
  "disabled_on": { "groups": ["header", "footer", "aside"] },
  "settings": [
    {
        "type": "select",
        "id": "height_desktop",
        "label": "Height - desktop",
        "default": "700px",
        "options": [
            { "value": "500px", "label": "500px" },
            { "value": "600px", "label": "600px" },
            { "value": "700px", "label": "700px" },
            { "value": "800px", "label": "800px" },
            { "value": "900px", "label": "900px" },
            { "value": "100vh", "label": "Full height" },
            { "value": "auto", "label": "Auto - adapts to each slide" }
        ]
    },
    {
        "type": "select",
        "id": "height_mobile",
        "label": "Height - mobile",
        "default": "600px",
        "options": [
            { "value": "500px", "label": "500px" },
            { "value": "600px", "label": "600px" },
            { "value": "700px", "label": "700px" },
            { "value": "800px", "label": "800px" },
            { "value": "900px", "label": "900px" },
            { "value": "100vh", "label": "Full height" },
            { "value": "auto", "label": "Auto - adapts to each slide" }
        ]
    },
    {
        "type": "select",
        "id": "pagination_type",
        "label": "Pagination",
        "default": "dots",
        "options": [
            { "value": "nil", "label": "None" },
            { "value": "dots", "label": "Dots" },
            { "value": "numbers", "label": "Numbers" }
        ]
    },
    {
        "type": "checkbox",
        "id": "show_navigation",
        "label": "Show navigation buttons",
        "default": true
    },
    {
        "type": "header",
        "content": "Transition effects"
    },
    {
        "type": "select",
        "id": "slideshow_type",
        "label": "Type",
        "default": "slide",
        "options": [
            { "value": "slide", "label": "Slide" },
            { "value": "fade", "label": "Fade" }
        ]
    },
    {
        "type": "header",
        "content": "Autoplay"
    },
    {
        "type": "checkbox",
        "id": "slideshow_autoplay",
        "label": "Auto-rotate slides",
        "default": false
    },
    {
        "type": "range",
        "label": "Rotate every",
        "id": "slideshow_delay",
        "min": 3,
        "max": 16,
        "step": 1,
        "unit": "s",
        "default": 5,
        "info": "Change slides ever X seconds."
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
            "type": "header",
            "content": "Image"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Desktop"
        },
        {
          "type": "image_picker",
          "id": "imageMob",
          "label": "Mobile"
        },
        {
          "type": "header",
          "content": "Content"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Heading",
          "info": "15 words max"
        },
        {
            "type": "text",
            "id": "subheading",
            "label": "Heading",
            "default": "Subheading",
            "info": "15 words max"
        },
        {
          "type": "richtext",
          "id": "desc",
          "label": "Description",
          "default": "<p>Describe this slider to your customers.</p>",
          "info": "50 words max"
        },
        {
          "type": "text",
          "id": "cta",
          "label": "Button label",
          "default": "Shop more"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Button link"
        },
        {
            "type": "checkbox",
            "id": "urlTarget",
            "label": "Open link in new tab",
            "default": false
        },
        {
            "type": "select",
            "id": "contentPosition",
            "label": "Desktop content position",
            "default": "bottom:0;left:0;",
            "options": [
                { "value": "top:0;left:0;", "label": "Top left" },
                { "value": "top:0;right:0;", "label": "Top right" },
                { "value": "bottom:0;left:0;", "label": "Bottom left" },
                { "value": "bottom:0;right:0;", "label": "Bottom right" }
            ]
        },
        {
            "type": "select",
            "id": "contentAlign",
            "label": "Desktop content align",
            "default": "start",
            "options": [
                { "value": "start", "label": "Left" },
                { "value": "end", "label": "Right" }
            ]
        },
        {
          "type": "header",
          "content": "Appearance"
        },
        {
          "type": "color",
          "id": "slideMetaHBg",
          "label": "Button background",
          "default": "#FFFFFF"
        },
        {
          "type": "color",
          "id": "slideMetaHColor",
          "label": "Text color",
          "default": "#000000"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Slideshow",
      "category": "Banners",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}

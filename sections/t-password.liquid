<section 
    class="password" 
	{% unless section.settings.global_color_scheme %}color-scheme="{{ section.settings.color_scheme }}"{% endunless %}
	data-section-id="{{ section.id }}"
>
  <x-grid columns="stack" pi="center">
    <x-flex
      direction="row" ai="{{ section.settings.alignmentAI }}" jc="{{ section.settings.alignmentJC }}" wrap="wrap"
      direction-s="column" ai-s="center" jc-s="around"
      class="meta fullwidth fullheight-s{%  if section.settings.mixBlend %} mixBlend{% endif %}"
    >
        {% for block in section.blocks %}
            {%- case block.type -%}
            {%- when '@app' -%}
                <x-cell class="itsapp" {{ block.shopify_attributes }}>{%- render block -%}</x-cell>

            {%- when 'heading' -%}
                <x-cell class="heading" {{ block.shopify_attributes }}>
                    <h2 class="h2">
                        {%- liquid   
                            if block.settings.heading != blank
                                echo block.settings.heading
                            else
                                echo shop.name
                            endif
                        -%}
                    </h2>
                </x-cell>

            {%- when 'text' -%}
                <x-cell class="text" {{ block.shopify_attributes }}>
                    {%- liquid
                        echo '<p>'
                        if block.settings.text
                            echo block.settings.text
                        else
                            echo shop.password_message
                        endif 
                        echo '</p>'
                    -%}
                </x-cell>

            {%- when 'password' -%}
                <x-cell class="password" {{ block.shopify_attributes }}>
                    <a href="#login" type="button" class="is-blank">
                        {%- liquid   
                            if block.settings.label != blank
                                echo block.settings.label
                            else
                                echo 'general.password_page.login_password_button' | t
                            endif
                        -%}
                    </a>
                </x-cell>

            {%- when 'newsletter' -%}
                <x-cell class="newsletter{% if block.settings.newsletter_input %} has-form{% endif %}" {{ block.shopify_attributes }}>
                    {%- if block.settings.newsletter_input -%}
                        {%- render 'c-form-newsletter' focus: false -%}
                    {%- else -%}
                    <button data-open="#newsletterBox" class="is-blank">
                        <span>
                            
                            {%- liquid   
                                if block.settings.label != blank
                                    echo block.settings.label
                                else
                                    echo "newsletter.button_label" | t
                                endif
                            -%}
                        </span>
                    </button>
                    {%- endif -%}
                </x-cell>

            {%- when 'countdown' -%}
                <x-cell class="countdown" {{ block.shopify_attributes }}>
                    {%  render 'c-countdown', block: block %}
                </x-cell>

            {%- endcase -%}
        {%- endfor -%}
    </x-flex>

    <x-cell class="media full">
        {% if section.settings.mediaType == 'video' -%}
            {%- render 'inc-video' 
                vid: section.settings.video, 
                vidMobile: section.settings.videoMob,
                loop: true, 
                autoplay: true, 
                muted: true, 
                clickToPlay: false, 
                controls: false
            -%}
        {%- else -%}
            {%- render 'inc-img'
                dynamic: true,
                img: section.settings.image,
                imgMob: section.settings.imageMob,
                widths: '480,640,768,1024,1280,1536,1920,2560',
                mediaLoader: true
            -%}
        {%- endif -%}
    </x-cell>

    {%- if section.settings.show_backdrop -%}
        <x-cell class="backdrop"></x-cell>
    {%- endif -%}
  </x-grid>
</section>

{% schema %}
{
  "name": "Password",
  "settings": [
    {
        "type": "header",
        "content": "Background media"
    },
    {
        "type": "select",
        "id": "mediaType",
        "label": "Type",
        "default": "image",
        "options": [
            { "value": "image", "label": "Image" },
            { "value": "video", "label": "Video" }
        ]
    },
    {
        "type": "image_picker",
        "id": "image",
        "label": "Desktop",
        "visible_if": "{{ section.settings.mediaType == 'image' }}"
    },
    {
        "type": "image_picker",
        "id": "imageMob",
        "label": "Mobile",
        "visible_if": "{{ section.settings.mediaType == 'image' }}"
    },
    {
        "type": "video",
        "id": "video",
        "label": "Desktop",
        "visible_if": "{{ section.settings.mediaType == 'video' }}"
    },
    {
        "type": "video",
        "id": "videoMob",
        "label": "Mobile",
        "visible_if": "{{ section.settings.mediaType == 'video' }}"
    },
    {
        "type": "checkbox",
        "id": "show_backdrop",
        "label": "Enable backdrop",
        "default": false
    },
    {
        "type": "header",
        "content": "Alignment"
    },
    {
        "type": "select",
        "id": "alignmentAI",
        "label": "Vertical",
        "default": "start",
        "options": [
            { "value": "start", "label": "Top" },
            { "value": "center", "label": "Center" },
            { "value": "end", "label": "Bottom" }
        ]
    },
    {
        "type": "select",
        "id": "alignmentJC",
        "label": "Horizontal",
        "default": "around",
        "options": [
            { "value": "start", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "end", "label": "Right" },
            { "value": "between", "label": "Space between" },
            { "value": "around", "label": "Space around" }
        ]
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
        "type": "checkbox",
        "id": "mixBlend",
        "label": "Enable text blend mode",
        "info": "When enabled, this option will make the text color look different depending on the colors behind it.",
        "default": false
    },
    {
        "type": "checkbox",
        "id": "global_color_scheme",
        "label": "Use global color scheme",
        "default": true
    },
    {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "Color scheme",
        "default": "coretex-1",
        "visible_if": "{{ section.settings.global_color_scheme == false }}"
    }
  ],
  "blocks": [
    {
        "type": "@app"
    },
    {
      "type": "heading",
      "name": "Heading",
      "limit": 1,
      "settings": [
        {
            "type": "text",
            "id": "heading",
            "label": "Heading"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "limit": 1,
      "settings": [
        {
            "type": "text",
            "id": "text",
            "label": "Text",
            "default": "Coming soon...",
            "info": "Leave blank to display text from [Password protection](https://www.shopify.com/admin/online_store/preferences?tutorial=unlock) field."
        }
      ]
    },
    {
      "type": "password",
      "name": "Password",
      "limit": 1,
      "settings": [
        {
            "type": "text",
            "id": "label",
            "label": "Button label",
            "default": "Enter"
        }
      ]
    },
    {
        "type": "newsletter",
        "name": "Newsletter",
        "limit": 1,
        "settings": [
            {
                "type": "checkbox",
                "id": "newsletter_input",
                "label": "Show input form",
                "default": false,
                "info": "Show an input field for newsletter subscriptions instead of a popup button."
            },
            {
                "type": "text",
                "id": "label",
                "label": "Button label",
                "info": "Leave blank to display the default text.",
                "visible_if": "{{ block.settings.newsletter_input == false }}"
            }
        ]
    },
    {
      "type": "countdown",
      "name": "Countdown timer",
      "limit": 1,
      "settings": [
        {
            "type": "header",
            "content": "Time"
        },
        {
          "type": "text",
          "id": "date",
          "label": "Countdown target date",
          "default": "12-31-2026",
          "placeholder": "MM-DD-YYYY",
          "info": "Enter the date in MM-DD-YYYY format (month-day-year). Example: 12-31-2026"
        },
        {
          "type": "text",
          "id": "time",
          "label": "Countdown target time",
          "default": "00:00:00",
          "placeholder": "HH:MM:SS",
          "info": "Enter the time in HH:MM:SS format (24-hour clock). Example: 15:30:59"
        },
        {
            "type": "select",
            "id": "now",
            "label": "Time zone",
            "default": "auto",
            "info": "When set to auto, the time zone is retrieved from your store's [time zone settings](https://shopify.com/admin/settings/general). However, due to caching, this may occasionally fail to display the correct time.",
            "options": [
                { "value": "auto", "label": "Auto" },
                { "value": "custom", "label": "Custom time zone" }
            ]
        },
        {
            "type": "text",
            "id": "timezone",
            "label": "Custom time zone",
            "placeholder": "Europe/Copenhagen",
            "info": "View the [complete list](https://en.wikipedia.org/wiki/List_of_tz_database_time_zones#List) of IANA TZ identifiers. E.g. Europe/Copenhagen",
            "visible_if": "{{ block.settings.now == 'custom' }}"
        },
        {
            "type": "checkbox",
            "id": "show_weeks",
            "label": "Show weeks",
            "default": false
        },
        {
            "type": "checkbox",
            "id": "show_seconds",
            "label": "Show seconds",
            "default": true
        },
        {
            "type": "header",
            "content": "Message"
        },
        {
          "type": "textarea",
          "id": "final_message",
          "label": "Message",
          "default": "It's over!",
          "info": "Upon completion of the countdown, display a message."
        }
      ]
    }
  ]
}
{% endschema %}

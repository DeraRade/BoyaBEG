        {
            "type": "paragraph",
            "content": "This block appears in the 'Actions' column on the right side on desktop.",
            "visible_if": "{{ section.settings.page_layout == '3' }}"
        },
        {
          "type": "checkbox",
          "id": "label",
          "label": "Show quantity heading",
          "default": true
        }
      ]
    },
    {
      "type": "variant_picker",
      "name": "Variant picker",
      "limit": 1,
      "settings": [
        {
            "type": "paragraph",
            "content": "This block appears in the 'Actions' column on the right side on desktop.",
            "visible_if": "{{ section.settings.page_layout == '3' }}"
        },
        {
          "type": "select",

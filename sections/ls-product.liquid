          "label": "Style",
          "default": "button",
          "options": [
            {
              "value": "dropdown",
              "label": "Dropdown"
            },
            {
              "value": "button",
              "label": "Pills"
            }
          ]
        },
        {
          "id": "swatch_shape",
          "label": "Swatch",

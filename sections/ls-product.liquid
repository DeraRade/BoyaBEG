				"content": "Video"
			},
			{
				"type": "checkbox",
				"id": "enable_video_autoplay",
				"label": "Autoplay",
				"default": true
			},
			{
				"type": "checkbox",
				"id": "enable_video_looping",
				"label": "Loop",
				"default": true
			},
			{
				"type": "checkbox",
				"id": "enable_video_controls",
				"label": "Controls",
				"default": false
			},
			{
				"type": "header",
				"content": "Spacing"
			},
            {
                "type": "checkbox",
                "id": "paddingInline",
                "label": "Enable lateral padding",
                "default": false
            },
			{
				"type": "range",
				"id": "marginTop",
				"label": "Margin top",
				"min": 0,
				"max": 30,
				"step": 1,
				"default": 0
			},
			{
				"type": "range",
				"id": "marginBottom",
				"label": "Margin bottom",
				"min": 0,
				"max": 30,
				"step": 1,
				"default": 0
			},
            {
              "type": "range",
              "id": "paddingTop",
              "label": "Padding top",
              "min": 0,
              "max": 30,
              "step": 1,
              "default": 0
            },
            {
              "type": "range",
              "id": "paddingBottom",
              "label": "Padding bottom",
              "min": 0,
              "max": 30,
              "step": 1,
              "default": 0
            },
			{
				"type": "header",
				"content": "Appearance"
			},
            {
                "type": "checkbox",
                "id": "global_color_scheme",
                "label": "Use global color scheme",
                "default": true
            },
            {
                "type": "color_scheme",
                "id": "color_scheme",
                "label": "Color scheme",
                "default": "coretex-1",
                "visible_if": "{{ section.settings.global_color_scheme == false }}"
            }
		],
  "blocks": [
    {
      "type": "@app"
    },
    {
        "type": "separator",
        "name": "Separator",
        "settings": [
            {
                "type": "checkbox",
                "id": "show_hr",
                "label": "Show horizontal rule",
                "info": "Displays a horizontal border divider.",
                "default": false
            },
            {
                "type": "header",
                "content": "Spacing"
            },
            {
                "type": "range",
                "id": "marginTop",
                "label": "Margin top",
                "min": 0,
                "max": 30,
                "step": 1,
                "default": 0
            },
            {
                "type": "range",
                "id": "marginBottom",
                "label": "Margin bottom",
                "min": 0,
                "max": 30,
                "step": 1,
                "default": 0
            }
        ]
    },
    {

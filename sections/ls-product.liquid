{%- comment -%}
	=== [ CORETEX FYI ] ===
	This is a copy of 't-product.liquid' w/ adaptations for sections/homepage.
	For changes: use diffchecker & compare the files.
    ⚠️ This file has extra stuff, so be carefull and diff check it!
{%- endcomment -%}

{%- capture style -%}
{% if section.settings.paddingInline %}padding-inline: var(--layoutInline);{% endif %}
padding-block: {{ section.settings.paddingTop | prepend: 'var(--space-' | append: ')' }} {{ section.settings.paddingBottom | prepend: 'var(--space-' | append: ')' }};
margin-block: {{ section.settings.marginTop | prepend: 'var(--space-' | append: ')' }} {{ section.settings.marginBottom | prepend: 'var(--space-' | append: ')' }};
{%- endcapture -%}

{%- # Assign the featured product %}
{%- assign product = all_products[section.settings.featured_product] -%}

{%- liquid
    # Load PDP stylesheet
    render 'inc-stylesheet', src: 't-product.css'

    # Load Variant picker / swatches styles
    unless product.has_only_default_variant
        render 'inc-stylesheet', src: 'c-swatches.css'
    endunless

    # Load 3D model styles
    assign first_3d_model = product.media | where: 'media_type', 'model' | first

    # Variant images
    assign variant_images = product.images | where: 'attached_to_variant?', true | map: 'src'

    # Product form ID
    assign product_form_id = 'product-form-' | append: section.id

    # Single media
    assign single_media = false
    if product.media.size == 1
        assign single_media = true
    endif

    # Section Height
    assign section_height = section.settings.section_height

    # Product page layout
    # 3 columns (classic): info | image | actions
    # 2 columns:           image | info + actions
    assign pdpLayoutClassic = true
    assign layoutType = 'triptych'
    if section.settings.page_layout == '2'
        assign pdpLayoutClassic = false
        assign layoutType = 'diptych'
    endif

    # Bigger media column
    if section.settings.bigger_media
        # Bigger media layout columns
        if layoutType == 'triptych'
            # Classic layout columns (triptych)
            assign metaSpan = 2
            assign mediaSpan = 6
            assign actionSpan = 2
        else
            # 2 columns layout (diptych)
            assign metaSpan = 2
            assign mediaSpan = 5
            assign actionSpan = 3
        endif
    else
        # Default layout columns
        if layoutType == 'triptych'
            # Classic layout columns (triptych)
            assign metaSpan = 3
            assign mediaSpan = 4
            assign actionSpan = 3
        else
            # 2 columns layout (diptych)
            assign metaSpan = 3
            assign mediaSpan = 4
            assign actionSpan = 3
        endif
    endif

    # Media column as first column
    # This applies to the information column!
    # So that the media column can go first.
    # ⚠️ Only works if Classic layout is enabled (3 columns)
    assign mediaFirst = 1
    if pdpLayoutClassic and section.settings.media_first
        assign mediaFirst = 3
    endif

    # Show actions column before info column - mobile
    assign columnOrderMob = 2
    if section.settings.columnOrderMob
        assign columnOrderMob = 4
    endif
-%}

{%- # code added for this section only. Check code in schema also! -%} 
<section style="{{- style | strip_newlines | strip -}}" {% unless section.settings.global_color_scheme %}color-scheme="{{ section.settings.color_scheme }}"{% endunless %}>
{%- # / -%} 

{% # If no product is selected, show placeholder %}
{%- if product == empty -%}
	<product-info class="product-page featured-product placeholder" data-section-id="{{ section.id }}" {% unless section.settings.global_color_scheme %}color-scheme="{{ section.settings.color_scheme }}"{% endunless %}>
		<x-grid columns="10" columns-m="2" columns-s="1f" class="product-body kontainer">
		{%- comment -%} ---------- [ Product information ] ----------- {%- endcomment -%}
			<x-cell span="{{ metaSpan }}" span-m="1" order="{{ mediaFirst }}" order-m="2" order-s="{{ columnOrderMob }}" class="etheryx-product-info">
				{%- if section.settings.sticky -%}<div class="sticky">{%- endif -%}
				<x-flex direction="column" jc="{{ section.settings.vertical_alignment }}" jc-m="start" class="kontainer">
					<section class="title noMargin">
						<h1 class="h3">{{ 'onboarding.product_title' | t }}</h1>
					</section>
				</x-flex>
				{%- if section.settings.sticky -%}</div>{%- endif -%}
			</x-cell>

		{%- comment -%} ---------- [ Product media gallery ] ----------- {%- endcomment -%}
			<x-cell span="{{ mediaSpan }}" span-m="1" span-y-m="5" order="2" order-m="1" order-s="1" class="etheryx-product-media">
				{%- if section.settings.sticky -%}<div class="sticky">{%- endif -%}
				<x-flex direction="column" jc="{{ section.settings.vertical_alignment }}" ai="center" class="kontainer">
					{{ 'product-1' | placeholder_svg_tag: 'svg-placeholder banner' }}
				</x-flex>
				{%- if section.settings.sticky -%}</div>{%- endif -%}
			</x-cell>

		{%- comment -%} ---------- [ Product purchase options ] ----------- {%- endcomment -%}
			<x-cell span="{{ actionSpan }}" span-m="1" order="4" order-m="3" order-s="3" class="etheryx-product-options">
				{%- if section.settings.sticky -%}<div class="sticky">{%- endif -%}
				<x-flex direction="column" jc="{{ section.settings.vertical_alignment }}" jc-m="start" class="kontainer">
					<section class="price" role="status">€100,00</section>
					<section class="product-form">
						<button type="submit" name="add" class="add-2-cart fullwidth">
							<span class="cta">{{ 'products.product.unavailable' | t }}</span>
						</button>
					</section>
				</x-flex>
				{%- if section.settings.sticky -%}</div>{%- endif -%}
			</x-cell>
		</x-grid>
	</product-info>

	{% # If product is selected %}
{%- else -%}
	<product-info
		class="product-page featured-product"
		id="MainProduct-{{ section.id }}"
        layout="{{ layoutType }}"
        section-height="{{ section_height }}"
		data-section="{{ section.id }}"
		data-product-id="{{ product.id }}"
		data-update-url="false"
		data-url="{{ product.url }}"
        in-stock="{{ product.available }}"
        {% unless section.settings.global_color_scheme %}color-scheme="{{ section.settings.color_scheme }}"{% endunless %}
	>
		<x-grid columns="10" columns-m="2" columns-s="1f" class="product-body kontainer">
        {%- comment -%} ---------- [ Product information ] ----------- {%- endcomment -%}
            <x-cell 
                span="{{ metaSpan }}" span-m="1" order="{{ mediaFirst }}" order-m="2" order-s="{{ columnOrderMob }}" 
                {% if pdpLayoutClassic %}class="etheryx-product-info"{% else %}class="large-only"{% endif %}
            >
                {%- if section.settings.sticky -%}<div class="sticky">{%- endif -%}
                <x-flex direction="column" jc="{{ section.settings.vertical_alignment }}" jc-m="start" class="kontainer">
                    {%- liquid
                        # render only if the pdp layout is 3 columns
                        if pdpLayoutClassic
                            for block in section.blocks
                                render 'pdp-info', product: product, block: block
                            endfor
                        endif
                    -%}
                </x-flex>
                {%- if section.settings.sticky -%}</div>{%- endif -%}
            </x-cell>

		{%- comment -%} ---------- [ Product media gallery ] ----------- {%- endcomment -%}
		    {%- comment -%} --- [ 3D model ] --- {%- endcomment -%}
			{%- if first_3d_model -%}
				<link id="ModelViewerStyle" rel="stylesheet" href="https://cdn.shopify.com/shopifycloud/model-viewer-ui/assets/v1.0/model-viewer-ui.css" media="print" onload="this.media='all'">
			{%- endif -%}

        <x-cell 
            span="{{ mediaSpan }}" span-m="1" span-y-m="5" order="2" order-m="1" order-s="1" 
            single-media="{{ single_media }}" media-contain="{{ section.settings.contain_media_size }}"
            class="etheryx-product-media" 
            {%- if section.settings.media_type == 'stacked' -%}
            style="{{ section.settings.mediaGap | prepend: '--imageStackedGap: var(--space-' | append: ');' }}"
            {%- endif -%} 
        >
            {%- if section.settings.sticky -%}<div class="sticky">{%- endif -%}
                <x-flex direction="column" jc="{{ section.settings.vertical_alignment }}" ai="center" class="kontainer">
                    {%- render 'pdp-media', variant_images: variant_images, product: product, section: section -%}
                </x-flex>
            {%- if section.settings.sticky -%}</div>{%- endif -%}
        </x-cell>

        {%- comment -%} ---------- [ Product purchase options ] ----------- {%- endcomment -%}
            <x-cell span="{{ metaSpan }}" span-m="1" order="4" order-m="3" order-s="3" class="etheryx-product-options{% unless pdpLayoutClassic %} etheryx-product-info{% endunless %}">
                {%- if section.settings.sticky -%}<div class="sticky">{%- endif -%}
                <x-flex direction="column" jc="{{ section.settings.vertical_alignment }}" jc-m="start" class="kontainer">
                    {%- liquid 
                        for block in section.blocks
                            # render only if the pdp layout is NOT classic (2 columns)
                            unless pdpLayoutClassic
                                render 'pdp-info', product: product, block: block
                            endunless

                            # always render actions
                            render 'pdp-actions', product: product, block: block, product_form_id: product_form_id
                        endfor
                    -%}
                </x-flex>
                {%- if section.settings.sticky -%}</div>{%- endif -%}
            </x-cell>

		</x-grid>

        {%- render 'pdp-popups', product: product -%}

		{%- comment -%} --- [ Product JS ] --- {%- endcomment -%}
		{% comment %} {%- render 'inc-script', src: 't-product.js', loading: 'defer' -%} {% endcomment %}
        {% comment %} 
            === [ CORETEX FYI ] ===
            Preventing the t-product.js from being loaded mulitple times if more than one product is on the page.
            Check if the t-product.js is loaded by flag or DOM 
        {% endcomment %}
        <script>if (!window.PRODUCT_SCRIPT_LOADED && !document.querySelector('script[src="{{ 't-product.js' | asset_url }}"]')) { const script = document.createElement('script'); script.src = '{{ 't-product.js' | asset_url }}'; document.head.appendChild(script); }</script>

		{%- comment -%} --- [ 3D model ] --- {%- endcomment -%}
		{%- if first_3d_model -%}
			<script type="application/json" id="ProductJSON-{{ product.id }}">
				{{ product.media | where: 'media_type', 'model' | json }}
			</script>
			{%- render 'inc-script', src: 'pdp-modelviewer.js', loading: 'defer' -%}
		{%- endif -%}

        <div class="prodFullDetails text-center sticky-bottom">
            <a href="{{ product.url }}" class="button">{{ 'products.product.view_full_details' | t }}</a>
        </div>

	</product-info>
{%- endif -%}
</section>

{% schema %}
	{
		"name": "Featured product",
		"disabled_on": { "groups": ["header", "footer", "aside"] },
        "presets": [
            {
              "name": "Featured product",
              "category": "Products",
              "blocks": [
                { "type": "vendor" },
                { "type": "title" },
                { "type": "subtitle" },
                { "type": "description" },
                { "type": "price" },
                { "type": "variant_picker" },
                { "type": "buy_buttons" }
              ]
            }
          ],
		"settings": [
			{
				"type": "product",
				"id": "featured_product",
				"label": "Product"
			},
            {
                "type": "header",
                "content": "Layout"
            },
            {
                "type": "select",
                "id": "page_layout",
                "label": "Columns - desktop",
                "default": "3",
                "options": [
                    { "value": "2", "label": "Two" },
                    { "value": "3", "label": "Three" }
                ]
            },
            {
                "type": "paragraph",
                "content": "Due to its unique design, the product page includes key concepts to consider when using the three-column layout. [Learn more](https://docs.openthinking.net/themes/etheryx/editor/os/product/?utm_source=theme&utm_medium=editor&utm_content=etheryx)",
                "visible_if": "{{ section.settings.page_layout == '3' }}"
            },
            {
                "type": "select",
                "id": "section_height",
                "label": "Height - desktop",
                "default": "full",
                "options": [
                    { "value": "full", "label": "Full page" },
                    { "value": "fit", "label": "Fit content" }
                ]
            },
			{
				"type": "checkbox",
				"id": "sticky",
				"label": "Enable sticky content",
				"info": "Keeps content in a fixed position as the user scrolls on desktop devices.",
				"default": true
			},
			{
				"type": "select",
				"id": "vertical_alignment",
				"label": "Vertical alignment",
				"default": "center",
				"info": "Sets the vertical position of the content.",
                "visible_if": "{{ section.settings.section_height == 'full' }}",
				"options": [
					{ "value": "start", "label": "Top" },
					{ "value": "center", "label": "Middle" },
					{ "value": "end", "label": "Bottom" }
				]
			},
            {
                "type": "checkbox",
                "id": "priceOnMobile",
                "label": "Show price - mobile",
                "info": "Displays an extra product price next to the title on mobile, above the fold.",
                "default": true
            },
            {
                "type": "checkbox",
                "id": "columnOrderMob",
                "label": "Show actions before info - mobile",
                "info": "Display product actions above the information section on mobile devices.",
                "default": false,
                "visible_if": "{{ section.settings.page_layout == '3' }}"
            },
			{
				"type": "header",
				"content": "Product media"
			},
            {
                "type": "checkbox",
                "id": "media_first",
                "label": "Show media in first column - desktop",
                "info": "Show product media as the first column on desktop devices.",
                "default": false,
                "visible_if": "{{ section.settings.page_layout == '3' }}"
            },
			{
				"type": "checkbox",
				"id": "bigger_media",
				"label": "Enlarge media column",
				"info": "Increases the width of the media column on desktop devices.",
				"default": false
			},
			{
				"type": "checkbox",
				"id": "contain_media_size",
				"label": "Contain media size",
				"default": false
			},
            {
                "type": "select",
                "id": "media_type",
                "label": "Media display - desktop",
                "default": "stacked",
                "options": [
                    { "value": "stacked", "label": "Stacked" },
                    { "value": "slider", "label": "Slider" }
                ]
            },
			{
				"type": "checkbox",
				"id": "slider_thumbnails",
				"label": "Show thumbnails - slider",
				"default": false
			},
			{
				"type": "checkbox",
				"id": "slider_thumbnails_irregular",
				"label": "Irregular thumbnails - slider",
				"default": true
			},
			{
				"type": "checkbox",
				"id": "slider_button",
				"label": "Show navigation buttons - slider",
				"default": false
			},
			{
				"type": "select",
				"id": "slider_button_position",
				"label": "Navigation button position - slider",
				"default": "overlay",
				"options": [
					{ "value": "overlay", "label": "On image" },
					{ "value": "inline", "label": "Next to content" }
				]
			},
            {
                "type": "checkbox",
                "id": "pagination_overlay",
                "label": "Overlay pagination - slider",
                "info": "Choose whether to overlay pagination buttons on the slider or position them below.",
                "default": true
            },
			{
				"type": "checkbox",
				"id": "slider_loop",
				"label": "Enable slide loop - slider",
				"info": "Allows the slider to loop back to the first slide after the last one.",
				"default": true
			},
			{
				"type": "select",
				"id": "pagination_type",
				"label": "Pagination type - slider",
				"default": "lines",
				"options": [
					{ "value": "none", "label": "None" },
					{ "value": "lines", "label": "Lines" },
					{ "value": "dots", "label": "Dots" },
					{ "value": "numbers", "label": "Numbers" }

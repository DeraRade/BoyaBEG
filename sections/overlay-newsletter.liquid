{%- liquid
	if section.settings.dialogWidth == '100%'
		assign dialogMaxW = '--dialogMaxW: calc(100% - var(--layoutInline)); margin-inline: auto;'
	else
		assign dialogMaxW = null
	endif

	# Load CSS
	render 'inc-stylesheet', src: 'c-dialog.css', loading: 'defer'
	render 'inc-stylesheet', src: 'c-newsletter.css', loading: 'inline'
-%}

{%- if section.settings.backdrop != true -%}{% style %}coretex-newsletter.coretex-dialog dialog::backdrop { all: unset}{% endstyle %}{%- endif -%}

<coretex-newsletter
	id="newsletterBox"
	class="coretex-dialog"
	style="{{ dialogMaxW }} {{ section.settings.dialogWidth | prepend: '--dialogW:' }}; {{ section.settings.alignment | replace: 'left', 'start' | replace: 'right', 'end' | prepend: 'text-align:' | append: ';' }}"
	{% unless section.settings.global_color_scheme %}color-scheme="{{ section.settings.color_scheme }}"{% endunless %}
	data-auto-open="{{ section.settings.auto_open }}"
	data-expire="{{ section.settings.expire }}"
	data-delay="{{ section.settings.delay }}"
	data-section-id="{{ section.id }}"
>
	<dialog
		aria-label="Newsletter modal"
		dialog-position="{{ section.settings.dialogPosition }}"
		dialog-position-s="{{ section.settings.dialogPositionMob }}"
		data-lenis-prevent
	>
		<dialog-wrapper x-flex direction="column">
			<header class="close-button text-end sticky">
				<form>
					<button formmethod="dialog" class="is-custom is-circle has-icon" style="--jsDisplay:flex" data-close>
						<span class="visually-hidden">{{ 'accessibility.close' | t }}</span>
						{%- render 'inc-icon', icon: 'x-close' -%}
					</button>
				</form>
			</header>

			<main>
				<x-flex id="newsletter-form-block" direction="column" style="{{ section.settings.space | prepend: '--gap:var(--space-' | append: ');' }}"> 
					{% for block in section.blocks %}
						{%- case block.type -%}
							{%- when 'image' -%}
								<x-cell class="image {% if block.settings.showImageMob != true %}large-only{% endif %}{% if block.settings.imageContain %} imageContain{% endif %}" {{ block.shopify_attributes }}>
									{%- liquid
										assign img = block.settings.image
										assign width = 1100
										assign widths = '450,550,750,950,1100'
										assign sizes = '(max-width:777px) 100vw, (min-width:778px) 50vw, 100vw'
                                        assign class = 'noRadius'

										render 'inc-img', img: img, width: width, widths: widths, sizes: sizes, class: class
									-%}
								</x-cell>

							{%- when 'heading' -%}
								{%- if block.settings.text != empty -%}
									<x-cell class="heading" {{ block.shopify_attributes }}>
										<h2 class="h5 title">{{ block.settings.text }}</h2>
									</x-cell>
								{%- endif -%}

							{%- when 'description' -%}
								{%- if block.settings.text != empty -%}
									<x-cell class="description" {{ block.shopify_attributes }}>
										<div class="content rte">{{ block.settings.text | replace: '\n', '<br/>' }}</div>
									</x-cell>
								{%- endif -%}

							{%- when 'disclaimer' -%}
								{%- if block.settings.text != empty -%}
									<x-cell class="disclaimer" {{ block.shopify_attributes }}>
									    <small>{{ block.settings.text | replace: '\n', '<br/>' }}</small>
									</x-cell>
								{%- endif -%}

							{%- when 'form' -%}
								<x-cell class="form" {{ block.shopify_attributes }}>
									{%- render 'c-form-newsletter', section: section -%}
								</x-cell>
						{% endcase %}
					{% endfor %}
				</x-flex>
			</main>
		</dialog-wrapper>
	</dialog>
</coretex-newsletter>

{% schema %}
	{
		"name": "Newsletter",
		"limit": 1,
		"enabled_on": {
			"groups": ["aside"]
		},
		"settings": [
            {
                "type": "checkbox",
                "id": "auto_open",
                "label": "Open automatically",
                "info": "Display the popup after a delay without user interaction.",
                "default": true
            },
            {
                "type": "range",
                "id": "delay",
                "label": "Delay",
                "info": "Wait time before displaying the popup.",
                "min": 1,
                "max": 60,
                "unit": "sec",
                "step": 1,
                "default": 30,
                "visible_if": "{{ section.settings.auto_open }}"
            },
            {
                "type": "range",
                "id": "expire",
                "label": "Frequency",
                "info": "Days before the popup is shown again after being dismissed.",
                "min": 1,
                "max": 60,
                "unit": "day",
                "step": 1,
                "default": 7,
                "visible_if": "{{ section.settings.auto_open }}"
            },
			{
				"type": "header",
				"content": "Dialog"
			},
			{
				"type": "select",
				"id": "dialogWidth",
				"label": "Width",
				"default": "70ch",
				"options": [
					{
						"value": "70ch",
						"label": "Normal"
					},
					{
						"value": "40ch",
						"label": "Compact"
					}
				]
			},
			{
				"type": "select",
				"id": "dialogPosition",
				"label": "Position - desktop",
				"default": "center",
				"options": [
					{
						"value": "center",
						"label": "Middle"
					},
					{
						"value": "top left",
						"label": "Top left"
					},
					{
						"value": "top center",
						"label": "Top center"
					},
					{
						"value": "top right",
						"label": "Top right"
					},
					{
						"value": "bottom left",
						"label": "Bottom left"
					},
					{
						"value": "bottom center",
						"label": "Bottom center"
					},
					{
						"value": "bottom right",
						"label": "Bottom right"
					}
				]
			},
			{
				"type": "select",
				"id": "dialogPositionMob",
				"label": "Position - mobile",
				"default": "bottom",
				"options": [
					{
						"value": "top",
						"label": "Top"
					},
					{
						"value": "center",
						"label": "Center"
					},
					{
						"value": "bottom",
						"label": "Bottom"
					}
				]
			},
			{
				"type": "header",
				"content": "Content"
			},
			{
				"type": "range",
				"label": "Spacing",
				"id": "space",
				"min": 1,
				"max": 30,
				"step": 1,
				"default": 4
			},
            {
                "type": "text_alignment",
                "id": "alignment",
                "label": "Alignment",
                "default": "left"
            },
			{
				"type": "header",
				"content": "Appearance"
			},
            {
                "type": "checkbox",
                "id": "backdrop",
                "label": "Show dialog backdrop",
                "default": true
            },
            {
                "type": "checkbox",
                "id": "global_color_scheme",
                "label": "Use global color scheme",
                "default": true
            },
            {
                "type": "color_scheme",
                "id": "color_scheme",
                "label": "Color scheme",
                "default": "coretex-1",
                "visible_if": "{{ section.settings.global_color_scheme == false }}"
            }
		],
		"blocks": [
			{
				"type": "image",
				"name": "Image",
				"limit": 1,
				"settings": [
					{
						"type": "image_picker",
						"id": "image",
						"label": "Image"
					},
					{
						"type": "checkbox",
						"id": "showImageMob",
						"label": "Show on mobile",
						"default": true
					},
					{
						"type": "checkbox",
						"id": "imageContain",
						"label": "Contain image",
						"default": true
					}
				]
			},
			{
				"type": "heading",
				"name": "Heading",
				"limit": 1,
				"settings": [
					{
						"type": "text",
						"id": "text",
						"label": "Heading",
						"default": "Newsletter"
					}
				]
			},
			{
				"type": "description",
				"name": "Description",
				"limit": 1,
				"settings": [
					{
						"type": "textarea",
						"id": "text",
						"label": "Description",
						"default": "Stay up to date on the latest product releases, special offers and news by signing up for our newsletter."
					}
				]
			},
			{
				"type": "disclaimer",
				"name": "Disclaimer",
				"limit": 1,
				"settings": [
					{
						"type": "inline_richtext",
						"id": "text",
						"label": "Disclaimer"
					}
				]
			},
			{
				"type": "form",
				"name": "Form",
				"limit": 1,
				"settings": [
					{
						"type": "header",
						"content": "Newsletter",
						"info": "Subscribers will be added to your “accepts marketing” [customer list](/admin/customers?query=&accepts_marketing=1)."
					}
				]
			},
			{ "type": "@app" }
		],
		"presets": [
			{
				"name": "Newsletter",
				"blocks": [
					{ "type": "image" },
					{ "type": "heading" },
					{ "type": "description" },
					{ "type": "form" }
				]
			}
		]
	}
{% endschema %}

{%- render 'inc-stylesheet', src: 's-sections.css' -%}

{%- capture style -%}
padding-block: {{ section.settings.paddingTop | prepend: 'var(--space-' | append: ')' }} {{ section.settings.paddingBottom | prepend: 'var(--space-' | append: ');' }}
margin-block: {{ section.settings.marginTop | prepend: 'var(--space-' | append: ')' }} {{ section.settings.marginBottom | prepend: 'var(--space-' | append: ');' }}
{% if section.settings.useLocalCardSize %}{{ section.settings.card_size | prepend: '--prodCardSlideRatio:' | append: 'px;' }}{% endif %}
{%- endcapture -%}

{% liquid
	# unless = if not
	assign loading = 'eager'
	assign loaded = true

	unless page.request_type == 'product' or page.request_type == 'cart'
		if section.index > 2
			assign loading = 'lazy'
			assign loaded = false
		endif
	endunless
-%}

<section
	class="recently-viewed listOfProds"
	style="{{- style | strip_newlines | strip -}}"
	{% unless section.settings.global_color_scheme %}color-scheme="{{ section.settings.color_scheme }}"{% endunless %}
	data-section-id="{{ section.id }}"
>
	<component-loader>
		<coretex-recently>
			<coretex-fetch id="x-recently-viewed-{{ section.id }}" loading="{{ loading }}" loaded="{{ loaded }}">&nbsp;</coretex-fetch>
		</coretex-recently>
	</component-loader>
</section>

{% schema %}
	{
		"name": "Recently viewed products",
		"tag": "section",
		"class": "suggested recently-viewed",
		"limit": 1,
		"disabled_on": { "groups": ["header", "aside"] },
		"presets": [
			{
				"name": "Recently viewed products",
                "category": "Products"
			}
		],
		"settings": [
			{
				"type": "header",
				"content": "Header"
			},
			{
				"type": "checkbox",
				"id": "stealthMode",
				"label": "Show header on hover - desktop",
				"default": false
			},
			{
				"type": "header",
				"content": "Content"
			},
            {
                "type": "checkbox",
                "id": "useLocalCardSize",
                "label": "Override global card size",
                "info": "Will override global card size if enabled.",
                "default": false
            },
            {
                "type": "range",
                "label": "Card size",
                "id": "card_size",
                "min": 200,
                "max": 600,
                "step": 10,
                "unit": "px",
                "default": 250,
                "visible_if": "{{ section.settings.useLocalCardSize }}"
            },
			{
				"type": "header",
				"content": "Spacing"
			},
			{
				"type": "range",
				"id": "marginTop",
				"label": "Margin top",
				"min": 0,
				"max": 30,
				"step": 1,
				"default": 0
			},
			{
				"type": "range",
				"id": "marginBottom",
				"label": "Margin bottom",
				"min": 0,
				"max": 30,
				"step": 1,
				"default": 0
			},
			{
				"type": "range",
				"id": "paddingTop",
				"label": "Padding top",
				"min": 0,
				"max": 30,
				"step": 1,
				"default": 2
			},
			{
				"type": "range",
				"id": "paddingBottom",
				"label": "Padding bottom",
				"min": 0,
				"max": 30,
				"step": 1,
				"default": 2
			},
			{
				"type": "header",
				"content": "Appearance"
			},
            {
                "type": "checkbox",
                "id": "global_color_scheme",
                "label": "Use global color scheme",
                "default": true
            },
            {
                "type": "color_scheme",
                "id": "color_scheme",
                "label": "Color scheme",
                "default": "coretex-1",
                "visible_if": "{{ section.settings.global_color_scheme == false }}"
            }
		]
	}
{% endschema %}

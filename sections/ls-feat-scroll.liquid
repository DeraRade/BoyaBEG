{%- render 'inc-stylesheet', src: 's-sections.css' -%}

{%- capture style -%}
padding-block: {{ section.settings.paddingTop | prepend: 'var(--space-' | append: ')' }} {{ section.settings.paddingBottom | prepend: 'var(--space-' | append: ')' }};
margin-block: {{ section.settings.marginTop | prepend: 'var(--space-' | append: ')' }} {{ section.settings.marginBottom | prepend: 'var(--space-' | append: ')' }};
{%- endcapture -%}

<section
	class="feat-scroll"
	style="{{- style | strip_newlines | strip -}}"
	{% unless section.settings.global_color_scheme %}color-scheme="{{ section.settings.color_scheme }}"{% endunless %}
	data-section-id="{{ section.id }}"
>

    {%- liquid
        if section.settings.header
            # Section heading 
            assign heading = section.settings.heading
            assign description = section.settings.description
            assign url = section.settings.url
            assign url_label = section.settings.label
            assign attributes = 'wrap-s="wrap"'
            assign stealth = section.settings.stealthMode

            # Render section head
            render 'c-section-head', heading: heading, description: description, url: url, url_label: url_label, attributes: attributes, stealth: stealth
        endif
    -%}

    <component-loader>
	{%- if section.settings.enable_autoscroll -%}
		<coretex-autoscroll
			class="feat-scroll-slider"
			loop="true"
			direction="x"
			force-scroll
			scroll-direction="{{ section.settings.autoscroll_direction | default: 'forward' }}"
			scroll-speed="{{ section.settings.autoscroll_speed | default: 2 }}"
			scroll-delay="{{ section.settings.autoscroll_delay | default: 0 }}"
			scroll-play-init="{{ section.settings.autoscroll_play_init | default: true }}"
			scroll-stop-hover="{{ section.settings.autoscroll_stop_hover | default: true }}"
			scroll-stop-focus="{{ section.settings.autoscroll_stop_focus | default: true }}"
			mq="true" mq-s="true"
		>
	{%- else -%}
		<coretex-slider
			class="feat-scroll-slider"
			loop="true"
			direction="x"
			{% if section.settings.autoplay %}autoplay delay="{{ section.settings.autoplay_delay | default: 4000 }}"{% endif %}
			mq="true" mq-s="true"
		>
	{%- endif -%}
	<div slider-viewport>
		<div slider-container>
			{% for block in section.blocks -%}
				<div slider-slide="{{ forloop.index }}" {{ block.shopify_attributes }}>
					<div slide-content>
						{% case block.type %}
							{%- when 'media' -%}
								<coretex-mouse-tracker>
									{%- if block.settings.url != blank -%}<a href="{{ block.settings.url }}">{% endif -%}
									{%- liquid
										if block.settings.mediaType == 'video'
											render 'inc-video', vid: block.settings.video, loop: true, autoplay: true, muted: true, clickToPlay: false, controls: false, fallback: true
										else
                                            # Optimize loading based item position
                                            assign loading = 'lazy'
                                            if section.index == 1 and forloop.index <= 5
                                                assign loading = 'eager'
                                            endif

											render 'inc-img', img: block.settings.image, widths: '480,640,768,1024,1280,1536,1920,2560', mediaLoader: true, fallback: true, loading: loading
										endif
									-%}
                                    {%- if block.settings.showTitle -%}<h3 data-track="animate smooth" class="h1 title">{{ block.settings.heading }}</h3>{%- endif -%}
									{%- if block.settings.url != blank -%}</a>{% endif -%}
								</coretex-mouse-tracker>

							{% when 'product' -%}
								{%- assign product = all_products[block.settings.product] -%}
								{%- if product != blank -%}
									<coretex-mouse-tracker>
										<a href="{{ product.url }}">
											{%- render 'c-prod-card-media', product: product, card_media_type: 'multimedia', show_secondary: false, current_variant: false, fallback: true, loading: loading, index: forloop.index -%}
											{%- if block.settings.showTitle -%}<h3 data-track="animate smooth" class="h1 title">{{ product.title }}</h3>{%- endif -%}
										</a>
									</coretex-mouse-tracker>
                                {% else %}
                                    {% render 'inc-img', img: nil, fallback: true %}
								{%- endif -%}

							{% when 'collection' -%}
								{%- assign collection = collections[block.settings.collection] -%}
								{%- if collection != blank -%}
									<coretex-mouse-tracker>
										<a href="{{ collection.url }}" class="feat-scroll__collection-link">
											{%- if collection.featured_image -%}
												{%- render 'inc-img',
													img: collection.featured_image,
													widths: '480,640,768,1024,1280,1536,1920,2560',
													mediaLoader: true,
                                                    fallback: true,
                                                    loading: loading
												-%}
											{%- endif -%}
											{%- if block.settings.showTitle -%}<h3 data-track="animate smooth" class="h1 title">{{ collection.title }}</h3>{%- endif -%}
										</a>
									</coretex-mouse-tracker>
                                {% else %}
                                    {%- render 'inc-img', img: nil, fallback: true -%}
								{%- endif -%}

							{% when 'article' -%}
								{%- assign article = block.settings.article -%}
								{%- if article != blank -%}
									<coretex-mouse-tracker>
										<a href="{{ article.url }}" class="feat-scroll__article-link">
											{%- if article.image -%}
												{%- render 'inc-img', img: article.image, widths: '480,640,768,1024,1280,1536,1920,2560', mediaLoader: true, fallback: true -%}
											{%- endif -%}
											{%- if block.settings.showTitle -%}<h3 data-track="animate smooth" class="h1 title">{{ article.title }}</h3>{%- endif -%}
										</a>
									</coretex-mouse-tracker>
                                {% else %}
                                    {%- render 'inc-img', img: nil, fallback: true -%}
								{%- endif -%}
						{% endcase %}
					</div>
				</div>
			{%- endfor -%}
		</div>
	</div>

	{%- if section.settings.show_navigation -%}
		<slider-controls x-flex direction="column" ai="center" jc="center" class="mixBlend">
			<x-cell>
				<button control-prev class="is-blank has-icon" type="button" tabindex="0" aria-label="{{ 'sections.slideshow.previous_slideshow' | t }}">
					{%- render 'inc-icon', icon: 'arrow-left' -%}
				</button>
			</x-cell>
			{%- if section.settings.enable_autoscroll and section.settings.show_autoscroll_controls -%}
				<x-cell>
					<button
						autoscroll-toggle
						class="feat-scroll__autoscroll-toggle is-blank has-icon"
						type="button"
						tabindex="0"
						aria-label="{{ 'sections.slideshow.previous_slideshow' | t }}"
					>
						<span autoscroll-play-text>{% render 'inc-icon', icon: 'play' %}</span>
						<span autoscroll-pause-text>{% render 'inc-icon', icon: 'pause' %}</span>
					</button>
				</x-cell>
			{%- endif -%}
			<x-cell>
				<button control-next class="is-blank has-icon" type="button" tabindex="0" aria-label="{{ 'sections.slideshow.next_slideshow' | t }}">
					{%- render 'inc-icon', icon: 'arrow-right' -%}
				</button>
			</x-cell>
		</slider-controls>
	{%- endif -%}

	{%- if section.settings.enable_autoscroll -%}
		</coretex-autoscroll>
	{%- else -%}
		</coretex-slider>
	{%- endif -%}
    </component-loader>
</section>

{% schema %}
	{
		"name": "Feature scroll",
		"disabled_on": { "groups": ["header", "footer", "aside"] },
		"presets": [
			{
				"name": "Feature scroll",
				"category": "Content",
				"blocks": [{ "type": "product" }, { "type": "collection" }, { "type": "article" }, { "type": "media" }, { "type": "media" }]
			}
		],
		"settings": [
            {
                "type": "header",
                "content": "Header"
            },
            {
                "type": "checkbox",
                "id": "header",
                "label": "Show",
                "default": false
            },
            {
                "type": "checkbox",
                "id": "stealthMode",
                "label": "Show header on hover - desktop",
                "default": false,
                "visible_if": "{{ section.settings.header }}"
            },
            {
                "type": "text",
                "id": "heading",
                "label": "Heading",
                "default": "Feature scroll",
                "visible_if": "{{ section.settings.header }}"
            },
            {
                "type": "text",
                "id": "description",
                "label": "Description",
                "visible_if": "{{ section.settings.header }}"
            },
            {
                "type": "url",
                "id": "url",
                "label": "URL",
                "visible_if": "{{ section.settings.header }}"
            },
            {
                "type": "text",
                "id": "label",
                "label": "Label",
                "default": "View all",
                "visible_if": "{{ section.settings.header }}"
            },
			{
				"type": "header",
				"content": "Carousel"
			},
			{
				"type": "checkbox",
				"id": "autoplay",
				"label": "Enable autoplay",
				"default": false,
				"visible_if": "{{ section.settings.enable_autoscroll == false }}"
			},
			{
				"type": "range",
				"id": "autoplay_delay",
				"label": "Delay",
				"min": 2000,
				"max": 8000,
				"step": 500,
				"default": 4000,
				"unit": "ms",
				"visible_if": "{{ section.settings.autoplay and section.settings.enable_autoscroll == false }}"
			},
			{
				"type": "checkbox",
				"id": "show_navigation",
				"label": "Show arrows",
				"default": false
			},
			{
				"type": "header",
				"content": "Autoscroll",
                "visible_if": "{{ section.settings.autoplay == false }}"
			},
			{
				"type": "checkbox",
				"id": "enable_autoscroll",
				"label": "Enable",
				"default": false,
				"info": "Enables continuous automatic scrolling.",
                "visible_if": "{{ section.settings.autoplay == false }}"
			},
			{
				"type": "select",
				"id": "autoscroll_direction",
				"label": "Scroll direction",
				"default": "forward",
				"options": [
					{ "value": "forward", "label": "Forward" },
					{ "value": "backward", "label": "Backward" }
				],
				"visible_if": "{{ section.settings.enable_autoscroll }}"
			},
			{
				"type": "range",
				"id": "autoscroll_speed",
				"label": "Scroll speed",
				"min": 0.5,
				"max": 5,
				"step": 0.5,
				"default": 2,
				"visible_if": "{{ section.settings.enable_autoscroll }}"
			},
			{
				"type": "range",
				"id": "autoscroll_delay",
				"label": "Start delay",
				"min": 0,
				"max": 5000,
				"step": 500,
				"default": 0,
				"unit": "ms",
				"visible_if": "{{ section.settings.enable_autoscroll }}"
			},
			{
				"type": "checkbox",
				"id": "autoscroll_play_init",
				"label": "Start automatically",
				"default": true,
				"visible_if": "{{ section.settings.enable_autoscroll }}"
			},
			{
				"type": "checkbox",
				"id": "autoscroll_stop_hover",
				"label": "Pause on hover",
				"default": true,
				"visible_if": "{{ section.settings.enable_autoscroll }}"
			},
			{
				"type": "checkbox",
				"id": "autoscroll_stop_focus",
				"label": "Pause on focus",
				"default": true,
				"visible_if": "{{ section.settings.enable_autoscroll }}"
			},
			{
				"type": "checkbox",
				"id": "show_autoscroll_controls",
				"label": "Show controls",
				"default": false,
				"visible_if": "{{ section.settings.enable_autoscroll and section.settings.show_navigation }}"
			},
			{
				"type": "header",
				"content": "Spacing"
			},
			{
				"type": "range",
				"id": "marginTop",
				"label": "Margin top",
				"min": 0,
				"max": 30,
				"step": 1,
				"default": 0
			},
			{
				"type": "range",
				"id": "marginBottom",
				"label": "Margin bottom",
				"min": 0,
				"max": 30,
				"step": 1,
				"default": 0
			},
			{
				"type": "range",
				"id": "paddingTop",
				"label": "Padding top",
				"min": 0,
				"max": 30,
				"step": 1,
				"default": 2
			},
			{
				"type": "range",
				"id": "paddingBottom",
				"label": "Padding bottom",
				"min": 0,
				"max": 30,
				"step": 1,
				"default": 2
			},
			{
				"type": "header",
				"content": "Appearance"
			},
			{
				"type": "checkbox",
				"id": "global_color_scheme",
				"label": "Use global color scheme",
				"default": true
			},
			{
				"type": "color_scheme",
				"id": "color_scheme",
				"label": "Color scheme",
				"default": "coretex-1",
				"visible_if": "{{ section.settings.global_color_scheme == false }}"
			}
		],
		"blocks": [
			{
				"type": "product",
				"name": "Product",
				"settings": [
					{
						"type": "product",
						"label": "Product",
						"id": "product"
					},
                    {
                        "type": "checkbox",
                        "id": "showTitle",
                        "label": "Show title",
                        "default": true
                    }
				]
			},
			{
				"type": "collection",
				"name": "Collection",
				"settings": [
					{
						"type": "collection",
						"label": "Collection",
						"id": "collection"
					},
                    {
                        "type": "checkbox",
                        "id": "showTitle",
                        "label": "Show title",
                        "default": true
                    }
				]
			},
			{
				"type": "article",
				"name": "Article",
				"settings": [
					{
						"type": "article",
						"label": "Article",
						"id": "article"
					},
                    {
                        "type": "checkbox",
                        "id": "showTitle",
                        "label": "Show title",
                        "default": true
                    }
				]
			},
			{
				"type": "media",
				"name": "Media",
				"settings": [
					{
						"type": "select",
						"id": "mediaType",
						"label": "Type",
						"default": "image",
						"options": [
							{ "value": "image", "label": "Image" },
							{ "value": "video", "label": "Video" }
						]
					},
					{
						"type": "image_picker",
						"id": "image",
						"label": "Image",
						"visible_if": "{{ block.settings.mediaType == 'image' }}"
					},
					{
						"type": "video",
						"id": "video",
						"label": "Video",
						"visible_if": "{{ block.settings.mediaType == 'video' }}"
					},
                    {
                        "type": "checkbox",
                        "id": "showTitle",
                        "label": "Show title",
                        "default": true
                    },
					{
						"type": "text",
						"id": "heading",
						"label": "Heading",
						"default": "Heading",
                        "visible_if": "{{ block.settings.showTitle }}"
					},
					{
						"type": "url",
						"id": "url",
						"label": "Link"
					}
				]
			}
		]
	}
{% endschema %}

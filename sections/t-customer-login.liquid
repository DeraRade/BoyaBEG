{%- # Load the stylesheet for the page -%}
{%- render 'inc-stylesheet', src: 't-login.css' -%}

<section class="customer login">
    {%- comment -%}
        Password reset area
    {%- endcomment -%}
    <h2 id="recover" class="h4 pageTitle" tabindex="-1">{{ 'customer.recover_password.title' | t }}</h2>
    <div class="recover-area">
        <p>{{ 'customer.recover_password.subtext' | t }}</p>
        
        {%- form 'recover_customer_password' -%}
        {% assign recover_success = form.posted_successfully? %}
            <x-field>
                <input
                    type="email"
                    value=""
                    name="email"
                    id="RecoverEmail"
                    autocorrect="off"
                    autocapitalize="off"
                    autocomplete="email"
                    {% if form.errors %}
                        aria-invalid="true"
                        aria-describedby="RecoverEmail-email-error"
                        autofocus
                    {% endif %}
                    placeholder="{{ 'customer.login_page.email' | t }}"
                >
                <label for="RecoverEmail">{{ 'customer.login_page.email' | t }}</label>
            </x-field>
            {%- if form.errors -%}
                <form-error>
                    <small id="RecoverEmail-email-error" role="alert">{{ form.errors.messages.form }}</small>
                </form-error>
            {%- endif -%}

            <x-flex ai="center">
                <x-cell><button class="submit">{{ 'customer.login_page.submit' | t }}</button></x-cell>
                <x-cell><a href="#login" class="button is-custom text-normal">{{ 'customer.login_page.cancel' | t }}</a></x-cell>
            </x-flex>
        {%- endform -%}
    </div>

    {%- comment -%}
        Login area
    {%- endcomment -%}
    <h1 id="login" class="h4 pageTitle" tabindex="-1">{{ 'customer.login_page.title' | t }}</h1>
    <div class="login-area">
        {%- if recover_success == true -%}
            <h3 class="h5 text-normal form__message" tabindex="-1" autofocus>{{ 'customer.recover_password.success' | t }}</h3>
        {%- endif -%}

        {%- form 'customer_login', novalidate: 'novalidate' -%}
        {%- if form.errors -%}
            <h2 class="h4 text-normal form__message" role="alert" tabindex="-1" autofocus>
                <span class="visually-hidden">{{ 'accessibility.error' | t }} </span>
                {{ 'templates.contact.form.error_heading' | t }}
            </h2>
            {{ form.errors | default_errors }}
        {%- endif -%}
        <fieldset>
            <legend class="visually-hidden">{{ 'customer.login_page.title' | t }}</legend>
            {%- # Email -%}
            <x-field>
                <input
                    type="email"
                    name="customer[email]"
                    id="CustomerEmail"
                    autocomplete="email"
                    autocorrect="off"
                    autocapitalize="off"
                    {% if form.errors contains 'form' %}aria-invalid="true"{% endif %}
                    placeholder="{{ 'customer.login_page.email' | t }}"
                >
                <label for="CustomerEmail">{{ 'customer.login_page.email' | t }}</label>
            </x-field>

            {%- # Password -%}
            {%- if form.password_needed -%}
                <x-field>
                    <input
                        type="password"
                        value=""
                        name="customer[password]"
                        id="CustomerPassword"
                        autocomplete="current-password"
                        {% if form.errors contains 'form' %}
                        aria-invalid="true"
                        {% endif %}
                        placeholder="{{ 'customer.login_page.password' | t }}"
                    >
                    <label for="CustomerPassword">{{ 'customer.login_page.password' | t }}</label>
                </x-field>
            {%- endif -%}

            {%- # Sign in + Create account buttons -%}
            <x-flex ai="center" jc="between" wrap="wrap" style="gap:0">
                <x-cell><button class="submit" type="submit">{{ 'customer.login_page.sign_in' | t }}</button></x-cell>
                {%- # Link to recover area -%}
                <x-cell><a href="#recover" class="button is-custom text-end text-normal">{{ 'customer.login_page.forgot_password' | t }}</a></x-cell>
                <x-cell span="row" class="text-end"><a href="{{ routes.account_register_url }}" class="button is-custom text-normal">{{ 'customer.login_page.create_account' | t }}</a></x-cell>
            </x-flex>

            {% # theme-check-disable %}
            <small class="rte captcha-disclaimer">{{ 'shopify.online_store.spam_detection.disclaimer_html' | t }}</small>
            {% # theme-check-enable %}
        </fieldset>
        {%- endform -%}
    </div>

    {%- comment -%}
        === [ CORETEX FYI ] ===
        If accounts are set as optional, the following will be shown as an option
        during checkout, not on the default /login page.
    {%- endcomment -%}
    {%- if shop.checkout.guest_login -%}  
    <div class="guest-area">
        <hr>
        <h1 class="h4 pageTitle">{{ 'customer.login_page.guest_title' | t }}</h1>

        {%- form 'guest_login' -%}
        <button>{{ 'customer.login_page.guest_continue' | t }}</button>
        {%- endform -%}
    </div>
    {%- endif -%}
</section>

{% schema %}
{
  "name": "Login",
  "settings": []
}
{% endschema %}
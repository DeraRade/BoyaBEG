{%- liquid
  # Count blocks
  assign block_count = section.blocks.size

  # Hamburger on mobile (default true). The menu block can set this false to show an inline mobile nav.
  assign hamMobile = true

  # Loop through blocks
  for block in section.blocks
    # Check for 'logo' block type
    if block.type == 'logo' and block.settings.image == blank and settings.useCustomFonts != true
      assign logo_font = block.settings.logo_font
      assign logo_font_bold = logo_font | font_modify: 'weight', 'bold'
      assign logo_font_italic = logo_font | font_modify: 'style', 'italic'
      assign logo_font_bold_italic = logo_font_bold | font_modify: 'style', 'italic'

      # Comunicate to the header that the logo is text
      capture isTextLogo
        echo true
      endcapture
    
      capture logo_block
        echo logo_font | font_face: font_display: 'swap'
        echo logo_font_bold | font_face: font_display: 'swap'
        echo logo_font_italic | font_face: font_display: 'swap'
        echo logo_font_bold_italic | font_face: font_display: 'swap'
      endcapture
    endif

    # Menu block: independent hamburger toggles + inline style
    if block.type == 'menu'
        # Desktop hamburger (migrate legacy "drawer" menu type)
        assign hamDesktop = block.settings.hamburgerDesktop
        if block.settings.type == 'drawer'
            assign hamDesktop = true
        endif

        # Mobile hamburger (default true). When false, mobile renders an inline nav.
        if block.settings.hamburgerMobile == false
            assign hamMobile = false
        endif

        # Inline nav style used wherever a breakpoint is NOT a hamburger
        assign inlineStyle = block.settings.type
        if inlineStyle == 'drawer'
            assign inlineStyle = 'drop'
        endif

        # coretex-menu drives the desktop layout: drawer = hamburger, drop/mega = inline
        if hamDesktop
            assign menuType = 'drawer'
        else
            assign menuType = inlineStyle
        endif

        # Mega menu shadow
        assign megaShadow = false
        if inlineStyle == 'mega' and block.settings.showShadow
            assign megaShadow = true
        endif

        # Dropdown background
        assign showDropdownBg = false
        if inlineStyle == 'drop' and block.settings.dropdownBackground
            assign showDropdownBg = true
        endif
    endif

  endfor

  # Header mode {{ style }}
# theme-check-disable

    # Checking where we should overlay the header
    assign overlayMode = false
    if section.settings.overlayOnHomepage and template == 'index'
        assign overlayMode = true
    elsif section.settings.overlayOnProducts and template == 'product' 
        assign overlayMode = true 
    elsif section.settings.overlayOnCollections and template == 'collection' 
        assign overlayMode = true 
    elsif section.settings.overlayOnArticles and template == 'article' 
        assign overlayMode = true 
    elsif section.settings.overlayOnPages and template == 'page' 
        assign overlayMode = true 
    endif 
    

    # Applying styles for sticky header
    # Applying styles to overlay the header
    if section.settings.stickyMode and overlayMode == false
        # If sticky enabled, but overlay disabled.
        assign mode_type = 'sticky'
    elsif section.settings.stickyMode and overlayMode
        # if sticky enabled, and overlay enabled.
        assign mode_type = 'fixed'
    elsif section.settings.stickyMode == false and overlayMode
        # if sticky disabled, but overlay enabled.
        assign mode_type = 'absolute'
    else
        assign mode_type = 'initial'
    endif

  # Inline
  capture header_style
    # Background fill mode
    if section.settings.bgFill == 'translucent'
      echo '--headerBg: rgb(var(--bgRGB) / var(--globalOpacity)); background: var(--headerBg); -webkit-backdrop-filter: var(--overlayBlur); backdrop-filter: var(--overlayBlur);'
    elsif section.settings.bgFill == 'transparent'
      echo '--headerBg: var(--bg); background: transparent!important; border: none;'
    else
      echo '--headerBg: var(--bg);'
    endif

    # Text capitalization
    assign textTransform = section.settings.textTransform
    if textTransform == 'capitalize'
        echo '--buttonTransform:lowercase;text-transform:lowercase;'
    endif
    echo textTransform | prepend: '--buttonTransform:' | append: ';'
    echo textTransform | prepend: 'text-transform:' | append: ';'
  endcapture
# theme-check-enable

  # Print styles {{ style }}
  style
    echo mode_type | prepend: '#headerGroup{--headerPosition:' | append: '}'
    echo header_style | prepend: 'coretex-header {' | append: '}'
  endstyle


    # Variables for cart options
    # used both here and in the `header-menu.liquid`
    for block in section.blocks
    if block.type == 'cart'
        # Country selector
        if block.settings.showCountry and localization.available_countries.size > 1
            assign showCountry = true
        endif

        # Language selector
        if block.settings.showLanguage and localization.available_languages.size > 1
            assign showLanguage = true
        endif

        # Search
        if block.settings.showSearch
            assign showSearch = true
        endif

        # Accounts
        if block.settings.showAccounts and shop.customer_accounts_enabled
            assign showAccounts = true
        endif

        # Cart
        if block.settings.showCart
            assign showCart = true
        endif
    endif
    endfor

    # Localization Icons
    if section.settings.contentDisplay == 'icons' or section.settings.contentDisplay == 'both'
        assign localizationIcons = true
    else 
        assign localizationIcons = false
    endif

  # Classes
-%}

{%- comment -%} 
    If Logo: text, add font styles.
{% endcomment %}
{%- if isTextLogo -%}
{%- style -%}
{{ logo_block }}
:root { --logoFontFamily:{{ logo_font.family }},{{ logo_font.fallback_families }}; --logoFontWeight:{{ logo_font.weight }}; --logoFontStyle:{{ logo_font.style }}; }
{%- endstyle -%}
{%- endif %}

<coretex-header
    id="mainHeader"
    data-section-id="{{ section.id }}"
    mode="{{ mode_type }}"
    location="{{ section.settings.location }}"
    content-type="{{ section.settings.contentDisplay }}"
    stealth="{{ section.settings.stealthMode }}"
    mix-blend="{{ section.settings.mixBlend }}"
    {% unless section.settings.global_color_scheme %}color-scheme="{{ section.settings.color_scheme }}"{% endunless %}
    coretex-menu="{{ menuType }}"
    ham-mobile="{{ hamMobile }}"
    {%- if menuType == 'drop' -%}dropdown-bg="{{ showDropdownBg }}"{%- endif -%}
    mega-shadow="{{ megaShadow }}"
>
  <x-flex ai="center" class="header" block-count="{{ block_count }}">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'menu' -%}
          <coretex-menu open-on-hover="{{ block.settings.openOnHover }}" 
            x-flex order-s="2"
            {% if block.settings.span %}span="1"{% endif %} span-s="1"
            jc="{{ block.settings.alignment | replace: 'left', 'start' | replace: 'right', 'end' }}" jc-s="{{ block.settings.alignmentMobile | replace: 'left', 'start' | replace: 'right', 'end' }}"
            class="menu" 
            {{ block.shopify_attributes }}
        >
          <!-- Mobile trigger button -->
            <x-cell class="mobileTrigger">
                <button role="button" class="button is-blank has-icon" data-open="#menuDrawerBox">
                    {%- render 'inc-icon', icon: 'menu' -%}
                    {%- if block.settings.showHamburgerLabel -%}
                        {%- liquid
                          assign triggerLabel = block.settings.hamburgerLabel | strip
                          if triggerLabel == blank
                            assign triggerLabel = 'sections.header.menu' | t
                          endif
                        -%}
                        <span class="txtState hamLabel">{{ triggerLabel }}</span>
                    {%- endif -%}
                </button>
            </x-cell>

            <coretex-drawer class="filters" id="menuDrawerBox" data-nobdc role="dialog" aria-modal="true" aria-label="{{ 'sections.header.menu' | t }}">
                <x-cell class="menuContent">
                    {%- render 'header-menu', 
                        block: block,
                        showCountry: showCountry,
                        showLanguage: showLanguage,
                        showSearch: showSearch,
                        showAccounts: showAccounts
                    -%}
                </x-cell>
            </coretex-drawer>
          </coretex-menu>

        {%- when 'logo' -%}
        {%- unless block.settings.hideOnHome and template.name == 'index' -%}
            <x-flex
                order-s="{{ block.settings.mobilePosition }}"
                jc-s="start"
                class="logo"
                logo-d="{{ block.settings.desktopPosition }}"
                {{ block.shopify_attributes }}
            >
                {%- style -%}:root{ {{ block.settings.logoImageSize | prepend: '--logoImageSize:' | append: 'px' }} }{%- endstyle -%}
                <a href="{{ routes.root_url }}" tabindex="0" {%- if isTextLogo -%}class="has-text-logo"{%- endif -%}>
                {%- if block.settings.image != blank -%}
                    {%- liquid
                    assign img = block.settings.image
                    assign width = 800
                    assign widths = '100,200,400,600,800'
                    assign alt = shop.name | escape
                    assign class = 'noRadius'

                    render 'inc-img', img: img, width: width, widths: widths, alt: alt, mediaLoader: false, class: class
                    -%}
                {%- else -%}
                    <div
                    class="text-logo"
                    style="{{ block.settings.logoFontSize | prepend: '--logoSize:' | append: 'px' }}"
                    >
                    {%- liquid
                        if block.settings.logoName != blank
                        echo block.settings.logoName
                        else
                        echo shop.name
                        endif
                    -%}
                    </div>
                {%- endif -%}
                </a>
            </x-flex>
        {%- endunless -%}

        {%- when 'cart' -%}
        <x-flex wrap="wrap" order-s="last"
            {% if block.settings.span %}span="1"{% endif %} span-s="1"
            jc="{{ block.settings.alignment | replace: 'left', 'start' | replace: 'right', 'end' }}" jc-s="end"
            class="tools"
            {{ block.shopify_attributes }}
        >

            <x-cell class="contents">

            {%- # Country/region selector -%}
            {%- if showCountry or showLanguage -%}
            <x-cell class="contents large-only localization" x-flex ai="center" jc="end" wrap="wrap" style="gap: 0 var(--space-2)">

                {%- if showCountry  -%}
                <x-cell class="localization-country">
                    {%- render 'global-localization', component: 'button', type: 'country', icons: localizationIcons -%}
                </x-cell>
                {%- endif -%}

                {% # Language selector %}
                {%- if showLanguage -%}
                <x-cell class="localization-language">
                    {%- render 'global-localization', component: 'button', type: 'language', icons: localizationIcons -%}
                </x-cell>
                {%- endif -%}

            </x-cell>
            {%- endif -%}

            {%- # Accounts -%}
              {%- if showAccounts -%}
                <x-cell class="large-only">
                    <button class="is-custom has-icon" data-open="#loginBox">
                    {%- render 'inc-icon', icon: 'o-account' -%}
                    <span class="txtState">
                      {%- liquid
                        if customer
                          echo 'customer.account.title' | t
                        else
                          echo 'customer.log_in' | t
                        endif
                      -%}
                    </span>
                    </button>
                </x-cell>
              {%- endif -%}

              {%- # Search -%}
              {%- if showSearch -%}
                <x-cell class="large-only">
                  <button class="is-custom has-icon" data-open="#searchBox">
                    {%- render 'inc-icon', icon: 'search' -%}
                    <span class="txtState">{{ 'general.search.search' | t }}</span>
                  </button>
                </x-cell>
              {%- endif -%}

              {%- # Cart -%}
              {%- if showCart -%}
                <x-cell>
                  <button
                    class="cartBubble is-custom has-icon"
                    {%- if settings.cart_type != 'redirect' -%}
                    data-open="#cartBox"
                    {%- else -%}
                    onclick="window.location.href='{{ routes.cart_url }}'"
                    {%- endif -%}
                  >
                    {%- render 'inc-icon', icon: section.settings.cartIcon -%}
                    <span class="txtState">{{ 'templates.cart.cart' | t }}</span>
                    <cart-count>
                      <span aria-hidden="true" data-ajax-cart-bind="item_count" class="counter">
                        {{- cart.item_count -}}
                      </span>
                      <span class="visually-hidden">
                        {{- 'sections.header.cart_count' | t: count: cart.item_count -}}
                      </span>
                    </cart-count>
                  </button>
                </x-cell>
              {%- endif -%}
            </x-cell>
        </x-flex>
      {%- endcase -%}
    {%- endfor -%}
  </x-flex>

</coretex-header>

<script>
(function () {
  /* Keep the hamburger drawer open across a language-change reload:
     switching language submits a form that reloads the page, which would
     otherwise close the drawer. Remember the intent, then reopen it. */
  document.addEventListener('click', function (e) {
    var link = e.target.closest && e.target.closest('a[data-value]');
    if (link && link.closest('#menuDrawerBox')) {
      try { sessionStorage.setItem('reopenMenuDrawer', '1'); } catch (err) {}
    }
  }, true);

  try {
    if (sessionStorage.getItem('reopenMenuDrawer')) {
      sessionStorage.removeItem('reopenMenuDrawer');
      if (window.customElements && customElements.whenDefined) {
        customElements.whenDefined('coretex-drawer').then(function () {
          var drawer = document.getElementById('menuDrawerBox');
          if (drawer && typeof drawer.open === 'function') drawer.open();
        });
      }
    }
  } catch (err) {}
})();
</script>

 
{% schema %}
{
  "name": "Header",
  "class": "main-header",
  "settings": [
    {
        "type": "select",
        "id": "location",
        "label": "Location",
        "default": "top",
        "info": "Selects the position of the header.",
        "options": [
            { "value": "top", "label": "Top" },
            { "value": "center", "label": "Center" }
        ]
    },
    {
      "type": "checkbox",
      "id": "stealthMode",
      "label": "Show header on hover - desktop",
      "default": false,
      "info": "Header content will be hidden, except for the logo. Revealed again when hovered over."
    },
    {
      "type": "checkbox",
      "id": "stickyMode",
      "label": "Enable sticky header",
      "default": true,
      "info": "The header will remain fixed and visible as you scroll.",
      "visible_if": "{{ section.settings.location == 'top' }}"
    },
    {
        "type": "checkbox",
        "id": "mixBlend",
        "label": "Enable content blend mode",
        "info": "When enabled, this option will make the text color look different depending on the colors behind it.",
        "default": false
    },
    {
        "type": "header",
        "content": "Overlay",
        "info": "The header will overlay content underneath.",
        "visible_if": "{{ section.settings.location == 'top' }}"
    },
    {
      "type": "checkbox",
      "id": "overlayOnHomepage",
      "label": "Enable on home page",
      "default": false,
      "visible_if": "{{ section.settings.location == 'top' }}"
    },
    {
        "type": "checkbox",
        "id": "overlayOnProducts",
        "label": "Enable on products",
        "default": false,

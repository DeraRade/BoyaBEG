{% doc %}
  @prompt
    Kontakt forma sa koje će poruke stizati na mejl studio@boyaporcelana.com kao da su to mejlovi poslati sa adrese ostavljene u formi. Ime i email moraju biti obavezna polja. Nakon poslatog mejla će se pojaviti poruka o uspešno poslatom mejlu.
    
    Mogućnost podešavanja svih grafičkih elementa forme i tekstova. Mogućnost određivana dimenzija polja za unos teksta. Mogućnost izmene svakog teksta. Mogučnost izmene svake boje u sekciji. Određivanje obaveznosti nekog polja., Dodaj podešavanje visine i širne polja za ime, email i telefon., Dodaj podešavanje širine polja za unos imena, emaila i telefona. Sada su samo ful-width., Tekst forme da bude kastiljano. Dodaj podešavanja izgleda forme za mobilni.
    
    Kod skrolovanja stranice forma putuje sa skrolom. Mora da ostane statična u svom bloku., Jezilk podešavanja neka ostane engleski. Jezik sadržaja je kasteljano.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-contact-form-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    max-width: 100%;
    margin: 0 auto;
    position: relative;
  }

  .ai-contact-form__wrapper-{{ ai_gen_id }} {
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.form_padding_mobile }}px;
    border-radius: {{ block.settings.border_radius }}px;
    --inputRadius: {{ block.settings.input_border_radius }}px;
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
  }

  .ai-contact-form__heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size_mobile }}px;
    font-family: var(--fontFamily);
    margin: 0 0 {{ block.settings.spacing_mobile }}px 0;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-contact-form__description-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size_mobile }}px;
    margin: 0 0 {{ block.settings.spacing_mobile }}px 0;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-contact-form__field-{{ ai_gen_id }} {
    margin-bottom: {{ block.settings.field_spacing_mobile }}px;
  }

  .ai-contact-form__label-{{ ai_gen_id }} {
    display: block;
    color: {{ block.settings.label_color }};
    font-size: {{ block.settings.label_size_mobile }}px;
    margin-bottom: 8px;
  }

  .ai-contact-form__label-{{ ai_gen_id }} .required {
    color: {{ block.settings.required_color }};
  }

  .ai-contact-form__input-{{ ai_gen_id }},
  .ai-contact-form__textarea-{{ ai_gen_id }} {
    width: {{ block.settings.input_width_percent_mobile }}%;
    max-width: 100%;
    padding: {{ block.settings.input_padding_mobile }}px;
    background-color: {{ block.settings.input_bg_color }};
    color: {{ block.settings.input_text_color }};
    border: {{ block.settings.input_border_width }}px solid {{ block.settings.input_border_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    font-size: {{ block.settings.input_text_size_mobile }}px;
    box-sizing: border-box;
  }

  .ai-contact-form__input-{{ ai_gen_id }} {
    height: {{ block.settings.input_height_mobile }}px;
  }

  .ai-contact-form__input-{{ ai_gen_id }}:focus,
  .ai-contact-form__textarea-{{ ai_gen_id }}:focus {
    outline: 2px solid {{ block.settings.input_focus_color }};
    outline-offset: 2px;
    border-color: {{ block.settings.input_focus_color }};
  }

  .ai-contact-form__textarea-{{ ai_gen_id }} {
    height: {{ block.settings.textarea_height_mobile }}px;
    resize: vertical;
    width: 100%;
  }

  .ai-contact-form__button-{{ ai_gen_id }} {
    width: {% if block.settings.button_full_width_mobile %}100%{% else %}auto{% endif %};
    padding: {{ block.settings.button_padding_mobile }}px {{ block.settings.button_padding_mobile | times: 2 }}px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_text_size_mobile }}px;
    cursor: pointer;
    transition: all 0.3s ease;
    display: block;
    margin: {{ block.settings.spacing_mobile }}px auto 0 auto;
  }

  .ai-contact-form__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_border_color }};
  }

  .ai-contact-form__success-{{ ai_gen_id }} {
    padding: {{ block.settings.input_padding_mobile }}px;
    background-color: {{ block.settings.success_bg_color }};
    color: {{ block.settings.success_text_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    margin-bottom: {{ block.settings.field_spacing_mobile }}px;
    text-align: center;
  }

  .ai-contact-form__error-{{ ai_gen_id }} {
    padding: {{ block.settings.input_padding_mobile }}px;
    background-color: {{ block.settings.error_bg_color }};
    color: {{ block.settings.error_text_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    margin-bottom: {{ block.settings.field_spacing_mobile }}px;
    text-align: center;
  }

  .ai-contact-form__field-error-{{ ai_gen_id }} {
    color: {{ block.settings.error_text_color }};
    font-size: {{ block.settings.label_size_mobile | minus: 2 }}px;
    margin-top: 4px;
  }

  @media screen and (min-width: 750px) {
    .ai-contact-form-{{ ai_gen_id }} {
      width: {{ block.settings.desktop_width_percent }}%;
    }

    .ai-contact-form__wrapper-{{ ai_gen_id }} {
      padding: {{ block.settings.form_padding }}px;
    }

    .ai-contact-form__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size }}px;
      margin-bottom: {{ block.settings.spacing }}px;
    }

    .ai-contact-form__description-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size }}px;
      margin-bottom: {{ block.settings.spacing }}px;
    }

    .ai-contact-form__field-{{ ai_gen_id }} {
      margin-bottom: {{ block.settings.field_spacing }}px;
    }

    .ai-contact-form__label-{{ ai_gen_id }} {
      font-size: {{ block.settings.label_size }}px;
    }

    .ai-contact-form__input-{{ ai_gen_id }},
    .ai-contact-form__textarea-{{ ai_gen_id }} {
      width: {{ block.settings.input_width_percent }}%;
      padding: {{ block.settings.input_padding }}px;
      font-size: {{ block.settings.input_text_size }}px;
    }

    .ai-contact-form__input-{{ ai_gen_id }} {
      height: {{ block.settings.input_height }}px;
    }

    .ai-contact-form__textarea-{{ ai_gen_id }} {
      height: {{ block.settings.textarea_height }}px;
    }

    .ai-contact-form__button-{{ ai_gen_id }} {
      width: {% if block.settings.button_full_width %}100%{% else %}auto{% endif %};
      padding: {{ block.settings.button_padding }}px {{ block.settings.button_padding | times: 2 }}px;
      font-size: {{ block.settings.button_text_size }}px;
      margin-top: {{ block.settings.spacing }}px;
    }

    .ai-contact-form__success-{{ ai_gen_id }},
    .ai-contact-form__error-{{ ai_gen_id }} {
      padding: {{ block.settings.input_padding }}px;
      margin-bottom: {{ block.settings.field_spacing }}px;
    }

    .ai-contact-form__field-error-{{ ai_gen_id }} {
      font-size: {{ block.settings.label_size | minus: 2 }}px;
    }
  }
{% endstyle %}

<contact-form-{{ ai_gen_id }}
  class="ai-contact-form-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  {%- form 'contact' -%}
    <div class="ai-contact-form__wrapper-{{ ai_gen_id }}">
      {%- if block.settings.heading != blank -%}
        <h2 class="ai-contact-form__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      {%- endif -%}

      {%- if block.settings.description != blank -%}
        <div class="ai-contact-form__description-{{ ai_gen_id }}">{{ block.settings.description }}</div>
      {%- endif -%}

      {%- if form.posted_successfully? -%}
        <div
          id="ai-contact-form-success-{{ ai_gen_id }}"
          class="ai-contact-form__success-{{ ai_gen_id }}"
        >
          {{ block.settings.success_message }}
        </div>
      {%- endif -%}

      {%- if form.errors -%}
        <div
          id="ai-contact-form-error-{{ ai_gen_id }}"
          class="ai-contact-form__error-{{ ai_gen_id }}"
        >
          {{ block.settings.error_message }}
        </div>
      {%- endif -%}

      <div class="ai-contact-form__field-{{ ai_gen_id }}">
        <label
          for="ai-contact-name-{{ ai_gen_id }}"
          class="ai-contact-form__label-{{ ai_gen_id }}"
        >
          {{ block.settings.name_label }}
          {%- if block.settings.name_required -%}
            <span class="required">*</span>
          {%- endif -%}
        </label>
        <input
          type="text"
          id="ai-contact-name-{{ ai_gen_id }}"
          name="contact[{{ block.settings.name_label }}]"
          class="ai-contact-form__input-{{ ai_gen_id }}"
          value="{% if form.name %}{{ form.name }}{% endif %}"
          placeholder="{{ block.settings.name_placeholder }}"
          {% if block.settings.name_required %}required aria-required="true"{% endif %}
          {% if form.errors contains 'name' %}
            aria-invalid="true"
            aria-describedby="ai-contact-name-error-{{ ai_gen_id }}"
          {% endif %}
        >
        {%- if form.errors contains 'name' -%}
          <div
            id="ai-contact-name-error-{{ ai_gen_id }}"
            class="ai-contact-form__field-error-{{ ai_gen_id }}"
          >
            {{ form.errors.translated_fields.name | capitalize }} {{ form.errors.messages.name }}
          </div>
        {%- endif -%}
      </div>

      <div class="ai-contact-form__field-{{ ai_gen_id }}">
        <label
          for="ai-contact-email-{{ ai_gen_id }}"
          class="ai-contact-form__label-{{ ai_gen_id }}"
        >
          {{ block.settings.email_label }}
          {%- if block.settings.email_required -%}
            <span class="required">*</span>
          {%- endif -%}
        </label>
        <input
          type="email"
          id="ai-contact-email-{{ ai_gen_id }}"
          name="contact[email]"
          class="ai-contact-form__input-{{ ai_gen_id }}"
          value="{% if form.email %}{{ form.email }}{% endif %}"
          placeholder="{{ block.settings.email_placeholder }}"
          autocorrect="off"
          autocapitalize="off"
          autocomplete="email"
          {% if block.settings.email_required %}required aria-required="true"{% endif %}
          {% if form.errors contains 'email' %}
            aria-invalid="true"
            aria-describedby="ai-contact-email-error-{{ ai_gen_id }}"
          {% endif %}
        >
        {%- if form.errors contains 'email' -%}
          <div
            id="ai-contact-email-error-{{ ai_gen_id }}"
            class="ai-contact-form__field-error-{{ ai_gen_id }}"
          >
            {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
          </div>
        {%- endif -%}
      </div>

      {%- if block.settings.show_phone -%}
        <div class="ai-contact-form__field-{{ ai_gen_id }}">
          <label
            for="ai-contact-phone-{{ ai_gen_id }}"
            class="ai-contact-form__label-{{ ai_gen_id }}"
          >
            {{ block.settings.phone_label }}
            {%- if block.settings.phone_required -%}
              <span class="required">*</span>
            {%- endif -%}
          </label>
          <input
            type="tel"
            id="ai-contact-phone-{{ ai_gen_id }}"
            name="contact[{{ block.settings.phone_label }}]"
            class="ai-contact-form__input-{{ ai_gen_id }}"
            value="{% if form.phone %}{{ form.phone }}{% endif %}"
            placeholder="{{ block.settings.phone_placeholder }}"
            autocomplete="tel"
            {% if block.settings.phone_required %}required aria-required="true"{% endif %}
            {% if form.errors contains 'phone' %}
              aria-invalid="true"
              aria-describedby="ai-contact-phone-error-{{ ai_gen_id }}"
            {% endif %}
          >
          {%- if form.errors contains 'phone' -%}
            <div
              id="ai-contact-phone-error-{{ ai_gen_id }}"
              class="ai-contact-form__field-error-{{ ai_gen_id }}"
            >
              {{ form.errors.translated_fields.phone | capitalize }} {{ form.errors.messages.phone }}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="ai-contact-form__field-{{ ai_gen_id }}">
        <label
          for="ai-contact-message-{{ ai_gen_id }}"
          class="ai-contact-form__label-{{ ai_gen_id }}"
        >
          {{ block.settings.message_label }}
          {%- if block.settings.message_required -%}
            <span class="required">*</span>
          {%- endif -%}
        </label>
        <textarea
          id="ai-contact-message-{{ ai_gen_id }}"
          name="contact[body]"
          class="ai-contact-form__textarea-{{ ai_gen_id }}"
          placeholder="{{ block.settings.message_placeholder }}"
          {% if block.settings.message_required %}required aria-required="true"{% endif %}
          {% if form.errors contains 'body' %}
            aria-invalid="true"
            aria-describedby="ai-contact-message-error-{{ ai_gen_id }}"
          {% endif %}
        >{% if form.body %}{{ form.body }}{% endif %}</textarea>
        {%- if form.errors contains 'body' -%}
          <div
            id="ai-contact-message-error-{{ ai_gen_id }}"
            class="ai-contact-form__field-error-{{ ai_gen_id }}"
          >
            {{ form.errors.translated_fields.body | capitalize }} {{ form.errors.messages.body }}
          </div>
        {%- endif -%}
      </div>

      <button
        type="submit"
        class="ai-contact-form__button-{{ ai_gen_id }}"
      >
        {{ block.settings.button_text }}
      </button>
    </div>
  {%- endform -%}
</contact-form-{{ ai_gen_id }}>

<script>
  (function() {
    class ContactForm{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        const successMessage = this.querySelector('#ai-contact-form-success-{{ ai_gen_id }}');
        
        if (successMessage) {
          successMessage.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      }
    }

    customElements.define('contact-form-{{ ai_gen_id }}', ContactForm{{ ai_gen_id }});
  })();
</script>


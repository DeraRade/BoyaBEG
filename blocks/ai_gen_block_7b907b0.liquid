{% doc %}
  @prompt
    Create a new Shopify theme block for a Mailchimp newsletter signup form based on this exact code:
    
    The block must have these 4 customizable settings in the theme editor:
    1. form_width - range slider (300-900px, default 560px), label "Širina forme"
    2. button_width - select ("full" = Puna širina, "auto" = Automatska širina), default "full", label "Širina dugmeta"
    3. input_radius - range slider (0-30px, default 6px), label "Zaobljenost text polja"
    4. button_radius - range slider (0-30px, default 6px), label "Zaobljenost dugmeta"
    
    CSS variables in #mc_embed_signup:
    --form-width: {{ block.settings.form_width }}px;
    --border-radius: {{ block.settings.input_radius }}px;
    --button-radius: {{ block.settings.button_radius }}px;
    
    Button width logic: {% if block.settings.button_width == 'full' %}100%{% else %}auto{% endif %}
    
    Mailchimp form action: https://boyaporcelana.us5.list-manage.com/subscribe/post?u=59dcef8e87b751a9a48806ed0&id=d79371216d&f_id=005741edf0
    
    Fields: EMAIL (email), FNAME (text), LNAME (text), MMERGE5 (radio: English / Español)
    Honeypot: b_59dcef8e87b751a9a48806ed0_d79371216d
    Submit button value: Suscribirse
    
    Include Mailchimp validate script and jQuery validator messages in Spanish., Svak tekst kućica da bude u zasebnom redu, Ime i odabir jezika neka budu obavezna polja takođe, Nedostaju radio buttons za izbor jezika a postoje u originalnom kodu, I dalje se ne vide radio buttons. Nema načina da se odabere jezik., Ukloni logo MailChimp-a, Dodaj podešavanje boja unutar forme, Font forme treba da bude Cera Pro Regular za teks i Cera Pro Bold za naslove kao što je već ceo sajt., Dugme na sredinu forme
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .mc-embed-signup-{{ ai_gen_id }} {
    --form-width: {{ block.settings.form_width }}px;
    --border-radius: {{ block.settings.input_radius }}px;
    --button-radius: {{ block.settings.button_radius }}px;
    background: {{ block.settings.form_bg_color }};
    clear: left;
    font-family: 'Cera Pro', sans-serif;
    font-weight: 400;
    font-size: 14px;
    width: 100%;
    max-width: var(--form-width);
    margin: 0 auto;
    padding: 20px;
    box-sizing: border-box;
    display: block;
  }

  .mc-embed-signup-{{ ai_gen_id }} form {
    display: block;
    position: relative;
    text-align: left;
    padding: 10px 0;
  }

  .mc-embed-signup-{{ ai_gen_id }} h2 {
    font-family: 'Cera Pro', sans-serif;
    font-weight: 700;
    padding: 0;
    margin: 15px 0;
    font-size: 1.4em;
    color: {{ block.settings.heading_color }};
  }

  .mc-embed-signup-{{ ai_gen_id }} input[type="email"],
  .mc-embed-signup-{{ ai_gen_id }} input[type="text"] {
    font-family: 'Cera Pro', sans-serif;
    font-weight: 400;
    border: 1px solid {{ block.settings.input_border_color }};
    border-radius: var(--border-radius);
    color: {{ block.settings.input_text_color }};
    background-color: {{ block.settings.input_bg_color }};
    box-sizing: border-box;
    height: 32px;
    padding: 0 0.4em;
    display: block;
    width: 100%;
  }

  .mc-embed-signup-{{ ai_gen_id }} input[type="email"]:focus,
  .mc-embed-signup-{{ ai_gen_id }} input[type="text"]:focus {
    border-color: {{ block.settings.input_border_focus_color }};
  }

  .mc-embed-signup-{{ ai_gen_id }} input[type="radio"] {
    appearance: auto;
    -webkit-appearance: radio;
    -moz-appearance: radio;
    display: inline-block !important;
    width: 16px !important;
    height: 16px !important;
    border: 1px solid {{ block.settings.input_border_color }} !important;
    margin: 0 8px 0 0 !important;
    padding: 0 !important;
    vertical-align: middle;
    cursor: pointer;
  }

  .mc-embed-signup-{{ ai_gen_id }} .button {
    font-family: 'Cera Pro', sans-serif;
    font-weight: 700;
    clear: both;
    background-color: {{ block.settings.button_bg_color }};
    border: 0 none;
    border-radius: var(--button-radius);
    transition: all 0.23s ease-in-out 0s;
    color: {{ block.settings.button_text_color }};
    cursor: pointer;
    display: inline-block;
    font-size: 15px;
    height: 32px;
    line-height: 32px;
    margin: 0 auto;
    padding: 0 22px;
    text-align: center;
    text-decoration: none;
    vertical-align: top;
    white-space: nowrap;
    width: {% if block.settings.button_width == 'full' %}100%{% else %}auto{% endif %};
  }

  .mc-embed-signup-{{ ai_gen_id }} .button:hover {
    background-color: {{ block.settings.button_hover_color }};
  }

  .mc-embed-signup-{{ ai_gen_id }} .mc-field-group {
    clear: left;
    position: relative;
    width: 96%;
    padding-bottom: 3%;
    min-height: 50px;
  }

  .mc-embed-signup-{{ ai_gen_id }} .mc-field-group label {
    font-family: 'Cera Pro', sans-serif;
    font-weight: 400;
    display: block;
    margin-bottom: 3px;
    color: {{ block.settings.label_color }};
  }

  .mc-embed-signup-{{ ai_gen_id }} .mc-field-group.input-group strong {
    font-family: 'Cera Pro', sans-serif;
    font-weight: 700;
    display: block;
    margin-bottom: 8px;
    color: {{ block.settings.label_color }};
  }

  .mc-embed-signup-{{ ai_gen_id }} .mc-field-group.input-group ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mc-embed-signup-{{ ai_gen_id }} .mc-field-group.input-group ul li {
    display: block;
    padding: 8px 0;
    margin: 0;
  }

  .mc-embed-signup-{{ ai_gen_id }} .mc-field-group.input-group label {
    font-family: 'Cera Pro', sans-serif;
    font-weight: 400;
    display: inline;
    margin-left: 0;
    cursor: pointer;
    color: {{ block.settings.label_color }};
  }

  .mc-embed-signup-{{ ai_gen_id }} .indicates-required {
    font-family: 'Cera Pro', sans-serif;
    font-weight: 400;
    text-align: right;
    font-size: 11px;
    margin-right: 4%;
    color: {{ block.settings.label_color }};
  }

  .mc-embed-signup-{{ ai_gen_id }} .asterisk {
    color: {{ block.settings.asterisk_color }};
    font-size: 150%;
    font-weight: normal;
    position: relative;
    top: 5px;
  }

  .mc-embed-signup-{{ ai_gen_id }} .clear {
    clear: both;
  }

  .mc-embed-signup-{{ ai_gen_id }} .clear.foot {
    text-align: center;
  }

  .mc-embed-signup-{{ ai_gen_id }} div.mce-responses {
    float: left;
    top: -1.4em;
    padding: 0em 0.5em 0em 0.5em;
    overflow: hidden;
    width: 90%;
    margin: 0 5%;
    clear: both;
  }

  .mc-embed-signup-{{ ai_gen_id }} div.response {
    font-family: 'Cera Pro', sans-serif;
    margin: 1em 0;
    padding: 1em 0.5em 0.5em 0;
    font-weight: bold;
    float: left;
    top: -1.5em;
    z-index: 1;
    width: 80%;
  }

  .mc-embed-signup-{{ ai_gen_id }} .mce-error-response {
    display: none;
  }

  .mc-embed-signup-{{ ai_gen_id }} .mce-success-response {
    color: {{ block.settings.success_color }};
    display: none;
  }

  .mc-embed-signup-{{ ai_gen_id }} label.error {
    font-family: 'Cera Pro', sans-serif;
    font-weight: 400;
    display: block;
    float: none;
    width: auto;
    margin-left: 1.05em;
    text-align: left;
    padding: 0.5em 0;
    color: {{ block.settings.error_color }};
  }

  @media (max-width: 520px) {
    .mc-embed-signup-{{ ai_gen_id }} form {
      margin-top: 10px;
    }
  }
{% endstyle %}

<div class="mc-embed-signup-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <form
    action="https://boyaporcelana.us5.list-manage.com/subscribe/post?u=59dcef8e87b751a9a48806ed0&id=d79371216d&f_id=005741edf0"
    method="post"
    id="mc-embedded-subscribe-form-{{ ai_gen_id }}"
    name="mc-embedded-subscribe-form"
    class="validate"
    target="_blank"
  >
    <div id="mc_embed_signup_scroll-{{ ai_gen_id }}">
      <h2>{{ block.settings.heading }}</h2>
      <div class="indicates-required"><span class="asterisk">*</span> {{ block.settings.required_note }}</div>

      <div class="mc-field-group">
        <label for="mce-EMAIL-{{ ai_gen_id }}">{{ block.settings.email_label }} <span class="asterisk">*</span></label>
        <input
          type="email"
          name="EMAIL"
          class="required email"
          id="mce-EMAIL-{{ ai_gen_id }}"
          required
          value=""
        >
      </div>
      
      <div class="mc-field-group">
        <label for="mce-FNAME-{{ ai_gen_id }}">{{ block.settings.fname_label }} <span class="asterisk">*</span></label>
        <input
          type="text"
          name="FNAME"
          class="required"
          id="mce-FNAME-{{ ai_gen_id }}"
          required
          value=""
        >
      </div>
      
      <div class="mc-field-group">
        <label for="mce-LNAME-{{ ai_gen_id }}">{{ block.settings.lname_label }}</label>
        <input
          type="text"
          name="LNAME"
          id="mce-LNAME-{{ ai_gen_id }}"
          value=""
        >
      </div>
      
      <div class="mc-field-group input-group">
        <strong>{{ block.settings.language_label }} <span class="asterisk">*</span></strong>
        <ul>
          <li>
            <input
              type="radio"
              value="English"
              name="MMERGE5"
              id="mce-MMERGE5-0-{{ ai_gen_id }}"
              class="required"
              required
            >
            <label for="mce-MMERGE5-0-{{ ai_gen_id }}">English</label>
          </li>
          <li>
            <input
              type="radio"
              value="Español"
              name="MMERGE5"
              id="mce-MMERGE5-1-{{ ai_gen_id }}"
              class="required"
            >
            <label for="mce-MMERGE5-1-{{ ai_gen_id }}">Español</label>
          </li>
        </ul>
      </div>
      
      <div class="mce-responses clear foot">
        <div class="response mce-error-response" style="display: none;"></div>
        <div class="response mce-success-response" style="display: none;"></div>
      </div>
      
      <div aria-hidden="true" style="position: absolute; left: -5000px;">
        <input
          type="text"
          name="b_59dcef8e87b751a9a48806ed0_d79371216d"
          tabindex="-1"
          value=""
        >
      </div>
      
      <div class="optionalParent">
        <div class="clear foot">
          <input
            type="submit"
            name="subscribe"
            id="mc-embedded-subscribe-{{ ai_gen_id }}"
            class="button"
            value="{{ block.settings.submit_label }}"
          >
        </div>
      </div>
    </div>
  </form>
</div>

<script type="text/javascript">
  document.addEventListener('DOMContentLoaded', function () {
    var s = document.createElement('script');
    s.src = '//s3.amazonaws.com/downloads.mailchimp.com/js/mc-validate.js';
    s.onload = function () {
      (function ($) {
        window.fnames = new Array();
        window.ftypes = new Array();
        fnames[0] = 'EMAIL';
        ftypes[0] = 'email';
        fnames[1] = 'FNAME';
        ftypes[1] = 'text';
        fnames[2] = 'LNAME';
        ftypes[2] = 'text';
        fnames[5] = 'MMERGE5';
        ftypes[5] = 'radio';
      })(jQuery);
      var $mcj = jQuery.noConflict(true);
      if (typeof jQuery.validator !== 'undefined') {
        jQuery.extend(jQuery.validator.messages, {
          required: {{ 'blocks.mailchimp_newsletter.validation.required' | t | json }},
          email: {{ 'blocks.mailchimp_newsletter.validation.email' | t | json }},
        });
      }
    };
    document.body.appendChild(s);
  });
</script>


{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .boya-newsletter-{{ ai_gen_id }} {
    font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }};
    font-weight: {{ block.settings.body_font.weight }};
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    padding: {{ block.settings.padding }}px;
    width: {{ block.settings.desktop_width_percent }}%;
  }

  .boya-newsletter-{{ ai_gen_id }} h2 {
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-size: {{ block.settings.heading_size }}px;
    letter-spacing: {{ block.settings.heading_letter_spacing }}em;
    margin-bottom: {{ block.settings.heading_margin }}px;
    {% if block.settings.heading_uppercase %}text-transform: uppercase;{% endif %}
  }

  .boya-newsletter-{{ ai_gen_id }} .boya-required-note-{{ ai_gen_id }} {
    font-size: {{ block.settings.note_size }}px;
    color: {{ block.settings.label_color }};
    margin-bottom: {{ block.settings.note_margin }}px;
  }

  .boya-newsletter-{{ ai_gen_id }} .asterisk {
    color: {{ block.settings.required_color }};
  }

  .boya-field-{{ ai_gen_id }} {
    margin-bottom: {{ block.settings.field_gap }}px;
  }

  .boya-field-{{ ai_gen_id }} label,
  .boya-field-group-{{ ai_gen_id }} strong {
    display: block;
    font-size: {{ block.settings.label_size }}px;
    font-weight: {{ block.settings.label_weight }};
    letter-spacing: {{ block.settings.label_letter_spacing }}em;
    {% if block.settings.label_uppercase %}text-transform: uppercase;{% endif %}
    color: {{ block.settings.label_color }};
    margin-bottom: {{ block.settings.label_margin }}px;
  }

  .boya-field-{{ ai_gen_id }} input[type="email"],
  .boya-field-{{ ai_gen_id }} input[type="text"] {
    width: 100%;
    padding: {{ block.settings.input_padding }}px {{ block.settings.input_padding_horizontal }}px;
    border: {{ block.settings.input_border_width }}px solid {{ block.settings.input_border_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }};
    font-size: {{ block.settings.input_font_size }}px;
    color: {{ block.settings.text_color }};
    background: {{ block.settings.input_background }};
    box-sizing: border-box;
    transition: border-color 0.2s;
    outline: none;
  }

  .boya-field-{{ ai_gen_id }} input[type="email"]:focus,
  .boya-field-{{ ai_gen_id }} input[type="text"]:focus {
    border-color: {{ block.settings.input_border_focus }};
  }

  .boya-field-group-{{ ai_gen_id }} {
    margin-bottom: {{ block.settings.field_gap }}px;
  }

  .boya-field-group-{{ ai_gen_id }} ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: {{ block.settings.radio_gap }}px;
  }

  .boya-field-group-{{ ai_gen_id }} li {
    display: flex;
    align-items: center;
    gap: {{ block.settings.radio_label_gap }}px;
  }

  .boya-field-group-{{ ai_gen_id }} input[type="radio"] {
    accent-color: {{ block.settings.radio_color }};
    width: {{ block.settings.radio_size }}px;
    height: {{ block.settings.radio_size }}px;
    cursor: pointer;
  }

  .boya-field-group-{{ ai_gen_id }} li label {
    font-size: {{ block.settings.radio_label_size }}px;
    font-weight: 400;
    letter-spacing: 0;
    text-transform: none;
    color: {{ block.settings.text_color }};
    cursor: pointer;
    margin: 0;
  }

  /* ── BUTTON ── */
  .boya-btn-{{ ai_gen_id }} {
    display: inline-block;
    {% if block.settings.button_full_width %}
      width: 100%;
    {% else %}
      width: auto;
    {% endif %}
    padding: {{ block.settings.button_padding }}px {{ block.settings.button_padding_horizontal }}px;
    background: {{ block.settings.button_bg }};
    color: {{ block.settings.button_text_color }};
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
    border-radius: {{ block.settings.button_border_radius }}px;
    font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }};
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: {{ block.settings.button_font_weight }};
    letter-spacing: {{ block.settings.button_letter_spacing }}em;
    {% if block.settings.button_uppercase %}text-transform: uppercase;{% endif %}
    cursor: pointer;
    transition: background 0.2s, color 0.2s, border-color 0.2s;
    margin-top: {{ block.settings.button_margin_top }}px;
  }

  .boya-btn-{{ ai_gen_id }}:hover {
    background: {{ block.settings.button_bg_hover }};
    color: {{ block.settings.button_text_hover }};
    border-color: {{ block.settings.button_border_hover }};
  }

  /* ── Wrapper for button centering ── */
  .boya-submit-wrap-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
  }

  .boya-response-{{ ai_gen_id }} {
    margin-top: {{ block.settings.field_gap }}px;
    padding: {{ block.settings.input_padding }}px;
    border-radius: {{ block.settings.input_border_radius }}px;
    font-size: {{ block.settings.input_font_size }}px;
  }

  .boya-response-{{ ai_gen_id }}.success {
    background: {{ block.settings.success_bg }};
    color: {{ block.settings.success_color }};
  }

  .boya-response-{{ ai_gen_id }}.error {
    background: {{ block.settings.error_bg }};
    color: {{ block.settings.error_color }};
  }

  @media screen and (max-width: 749px) {
    .boya-newsletter-{{ ai_gen_id }} {
      padding: {{ block.settings.padding | times: 0.7 }}px;
    }
  }
{% endstyle %}

<div class="boya-newsletter-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div id="mc_embed_shell-{{ ai_gen_id }}">
    <div id="mc_embed_signup-{{ ai_gen_id }}">
      <form
        action="{{ block.settings.mailchimp_action_url }}"
        method="post"
        id="mc-embedded-subscribe-form-{{ ai_gen_id }}"
        name="mc-embedded-subscribe-form"
        class="validate"
        target="_blank"
      >
        <div id="mc_embed_signup_scroll-{{ ai_gen_id }}">

          {% if block.settings.heading != blank %}
            <h2>{{ block.settings.heading }}</h2>
          {% endif %}

          {% if block.settings.show_required_note %}
            <div class="boya-required-note-{{ ai_gen_id }}">
              <span class="asterisk">*</span> {{ block.settings.required_note_text }}
            </div>
          {% endif %}

          <!-- ── Email (obavezno) ── -->
          <div class="mc-field-group boya-field-{{ ai_gen_id }}">
            <label for="mce-EMAIL-{{ ai_gen_id }}">
              {{ block.settings.email_label }}
              {% if block.settings.email_required %}<span class="asterisk">*</span>{% endif %}
            </label>
            <input
              type="email"
              name="EMAIL"
              class="required email"
              id="mce-EMAIL-{{ ai_gen_id }}"
              required
              value=""
            >
          </div>

          <!-- ── First name ── -->
          {% if block.settings.show_first_name %}
            <div class="mc-field-group boya-field-{{ ai_gen_id }}">
              <label for="mce-FNAME-{{ ai_gen_id }}">
                {{ block.settings.first_name_label }}
                {% if block.settings.first_name_required %}<span class="asterisk">*</span>{% endif %}
              </label>
              <input
                type="text"
                name="FNAME"
                class="{% if block.settings.first_name_required %}required {% endif %}text"
                id="mce-FNAME-{{ ai_gen_id }}"
                {% if block.settings.first_name_required %}required{% endif %}
                value=""
              >
            </div>
          {% endif %}

          <!-- ── Last name ── -->
          {% if block.settings.show_last_name %}
            <div class="mc-field-group boya-field-{{ ai_gen_id }}">
              <label for="mce-LNAME-{{ ai_gen_id }}">
                {{ block.settings.last_name_label }}
                {% if block.settings.last_name_required %}<span class="asterisk">*</span>{% endif %}
              </label>
              <input
                type="text"
                name="LNAME"
                class="{% if block.settings.last_name_required %}required {% endif %}text"
                id="mce-LNAME-{{ ai_gen_id }}"
                {% if block.settings.last_name_required %}required{% endif %}
                value=""
              >
            </div>
          {% endif %}

          <!-- ══════════════════════════════════════════════════════════════════ -->
          <!-- ── MMERGE3 — Tipo de boletín                                    -->
          <!-- Label: español  |  Value → Mailchimp: English (ne menjati!)     -->
          <!-- ══════════════════════════════════════════════════════════════════ -->
          {% if block.settings.show_group_1 %}
            <div class="mc-field-group input-group boya-field-group-{{ ai_gen_id }}">
              <strong>{{ block.settings.group_1_label }}</strong>
              <ul>
                {% if block.settings.group_1_option_1_label != blank %}
                  <li>
                    <input
                      type="radio"
                      name="MMERGE3"
                      value="{{ block.settings.group_1_option_1_value }}"
                      id="mce-MMERGE3-{{ ai_gen_id }}-1"
                    >
                    <label for="mce-MMERGE3-{{ ai_gen_id }}-1">{{ block.settings.group_1_option_1_label }}</label>
                  </li>
                {% endif %}
                {% if block.settings.group_1_option_2_label != blank %}
                  <li>
                    <input
                      type="radio"
                      name="MMERGE3"
                      value="{{ block.settings.group_1_option_2_value }}"
                      id="mce-MMERGE3-{{ ai_gen_id }}-2"
                    >
                    <label for="mce-MMERGE3-{{ ai_gen_id }}-2">{{ block.settings.group_1_option_2_label }}</label>
                  </li>
                {% endif %}
                {% if block.settings.group_1_option_3_label != blank %}
                  <li>
                    <input
                      type="radio"
                      name="MMERGE3"
                      value="{{ block.settings.group_1_option_3_value }}"
                      id="mce-MMERGE3-{{ ai_gen_id }}-3"
                    >
                    <label for="mce-MMERGE3-{{ ai_gen_id }}-3">{{ block.settings.group_1_option_3_label }}</label>
                  </li>
                {% endif %}
              </ul>
            </div>
          {% endif %}

          <!-- ══════════════════════════════════════════════════════════════════ -->
          <!-- ── MMERGE5 — Idioma                                              -->
          <!-- Label: español  |  Value → Mailchimp: English (ne menjati!)     -->
          <!-- ══════════════════════════════════════════════════════════════════ -->
          {% if block.settings.show_group_2 %}
            <div class="mc-field-group input-group boya-field-group-{{ ai_gen_id }}">
              <strong>{{ block.settings.group_2_label }}</strong>
              <ul>
                {% if block.settings.group_2_option_1_label != blank %}
                  <li>
                    <input
                      type="radio"
                      name="MMERGE5"
                      value="{{ block.settings.group_2_option_1_value }}"
                      id="mce-MMERGE5-{{ ai_gen_id }}-1"
                    >
                    <label for="mce-MMERGE5-{{ ai_gen_id }}-1">{{ block.settings.group_2_option_1_label }}</label>
                  </li>
                {% endif %}
                {% if block.settings.group_2_option_2_label != blank %}
                  <li>
                    <input
                      type="radio"
                      name="MMERGE5"
                      value="{{ block.settings.group_2_option_2_value }}"
                      id="mce-MMERGE5-{{ ai_gen_id }}-2"
                    >
                    <label for="mce-MMERGE5-{{ ai_gen_id }}-2">{{ block.settings.group_2_option_2_label }}</label>
                  </li>
                {% endif %}
                {% if block.settings.group_2_option_3_label != blank %}
                  <li>
                    <input
                      type="radio"
                      name="MMERGE5"
                      value="{{ block.settings.group_2_option_3_value }}"
                      id="mce-MMERGE5-{{ ai_gen_id }}-3"
                    >
                    <label for="mce-MMERGE5-{{ ai_gen_id }}-3">{{ block.settings.group_2_option_3_label }}</label>
                  </li>
                {% endif %}
              </ul>
            </div>
          {% endif %}

          <!-- ── Responses ── -->
          <div id="mce-responses-{{ ai_gen_id }}" class="clear">
            <div class="response boya-response-{{ ai_gen_id }} error" id="mce-error-response-{{ ai_gen_id }}" style="display: none;"></div>
            <div class="response boya-response-{{ ai_gen_id }} success" id="mce-success-response-{{ ai_gen_id }}" style="display: none;"></div>
          </div>

          <!-- ── Anti-bot (ne uklanjati) ── -->
          <div aria-hidden="true" style="position: absolute; left: -5000px;">
            <input
              type="text"
              name="{{ block.settings.mailchimp_bot_field }}"
              tabindex="-1"
              value=""
            >
          </div>

          <!-- ── Submit ── -->
          <div class="clear boya-submit-wrap-{{ ai_gen_id }}">
            <input
              type="submit"
              name="subscribe"
              id="mc-embedded-subscribe-{{ ai_gen_id }}"
              class="button boya-btn-{{ ai_gen_id }}"
              value="{{ block.settings.submit_button_text }}"
            >
          </div>

        </div>
      </form>
    </div>
  </div>
</div>


{% doc %}
  @prompt
    Custom liquid sa mogućnošću grafičkih podešavanja., Dodaj mogućnost centrirana sadržaja
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-custom-liquid-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.padding }}px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
    color: {{ block.settings.text_color }};
    {% if block.settings.center_content %}
      margin-left: auto;
      margin-right: auto;
    {% endif %}
  }

  .ai-custom-liquid-content-{{ ai_gen_id }} {
    font-size: {{ block.settings.font_size }}px;
    line-height: 1.6;
    {% if block.settings.center_text %}
      text-align: center;
    {% endif %}
  }

  .ai-custom-liquid-content-{{ ai_gen_id }} h1,
  .ai-custom-liquid-content-{{ ai_gen_id }} h2,
  .ai-custom-liquid-content-{{ ai_gen_id }} h3,
  .ai-custom-liquid-content-{{ ai_gen_id }} h4,
  .ai-custom-liquid-content-{{ ai_gen_id }} h5,
  .ai-custom-liquid-content-{{ ai_gen_id }} h6 {
    color: {{ block.settings.heading_color }};
    margin-top: 0;
    margin-bottom: 16px;
  }

  .ai-custom-liquid-content-{{ ai_gen_id }} p {
    margin-top: 0;
    margin-bottom: 16px;
  }

  .ai-custom-liquid-content-{{ ai_gen_id }} a {
    color: {{ block.settings.link_color }};
    text-decoration: underline;
  }

  .ai-custom-liquid-content-{{ ai_gen_id }} a:hover {
    color: {{ block.settings.link_hover_color }};
  }

  .ai-custom-liquid-content-{{ ai_gen_id }} img {
    max-width: 100%;
    height: auto;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-custom-liquid-content-{{ ai_gen_id }} ul,
  .ai-custom-liquid-content-{{ ai_gen_id }} ol {
    margin-top: 0;
    margin-bottom: 16px;
    padding-left: 24px;
  }

  .ai-custom-liquid-content-{{ ai_gen_id }} li {
    margin-bottom: 8px;
  }

  .ai-custom-liquid-content-{{ ai_gen_id }} blockquote {
    margin: 0 0 16px;
    padding-left: 20px;
    border-left: 4px solid {{ block.settings.accent_color }};
    font-style: italic;
  }

  .ai-custom-liquid-content-{{ ai_gen_id }} code {
    background-color: {{ block.settings.code_background }};
    padding: 2px 6px;
    border-radius: 4px;
    font-family: monospace;
    font-size: 0.9em;
  }

  .ai-custom-liquid-content-{{ ai_gen_id }} pre {
    background-color: {{ block.settings.code_background }};
    padding: 16px;
    border-radius: 8px;
    overflow-x: auto;
    margin-bottom: 16px;
  }

  .ai-custom-liquid-content-{{ ai_gen_id }} pre code {
    background-color: transparent;
    padding: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-custom-liquid-{{ ai_gen_id }} {
      width: 100%;
      padding: {{ block.settings.padding | times: 0.7 }}px;
    }

    .ai-custom-liquid-content-{{ ai_gen_id }} {
      font-size: {{ block.settings.font_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<div
  class="ai-custom-liquid-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-custom-liquid-content-{{ ai_gen_id }}">
    {{ block.settings.custom_liquid }}
  </div>
</div>

{% schema %}
{
  "name": "Custom liquid",
  "settings": [
    {
      "type": "header",
      "content": "Liquid code"
    },
    {
      "type": "liquid",
      "id": "custom_liquid",
      "label": "Custom Liquid code"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "checkbox",
      "id": "center_content",
      "label": "Center block",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "center_text",
      "label": "Center text",
      "default": false
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#f2ede8"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#5b5048"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Headings",
      "default": "#5b5048"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Links",
      "default": "#707060"
    },
    {
      "type": "color",
      "id": "link_hover_color",
      "label": "Links on hover",
      "default": "#6d6d5f"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#813e35"
    },
    {
      "type": "color",
      "id": "code_background",
      "label": "Code background",
      "default": "#e6ddd0"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "label": "Image border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Custom liquid"
    }
  ],
  "tag": null
}
{% endschema %}